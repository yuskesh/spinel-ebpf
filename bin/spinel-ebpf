#!/usr/bin/env ruby
# frozen_string_literal: true
#
# spinel-ebpf -- wrapper around matz/spinel that adds eBPF partition codegen.
#
# Modes:
#   spinel-ebpf compile foo.rb                  # eBPF-mixed (default)
#   spinel-ebpf compile foo.rb --native-only    # equivalent to plain spinel
#   spinel-ebpf compile foo.rb --ebpf-mixed     # explicit (same as default)
#   spinel-ebpf compile foo.rb -o build_dir     # custom output directory
#
# Status: MVP. The current implementation:
#   1. Invokes deps/spinel binaries to produce .ast and .ir
#   2. In --native-only mode: passes through to ./spinel, produces native binary
#   3. In --ebpf-mixed mode: runs the partition analysis and prints a
#      per-method tag table, then emits .bpf.c for the :ebpf methods.

$LOAD_PATH.unshift(File.expand_path("../src", __dir__))

require "optparse"
require "fileutils"
require "tmpdir"
require "open3"
require "spinel_ebpf/parse_spinel_ir"
require "spinel_ebpf/parse_spinel_ast"
require "spinel_ebpf/partition"
require "spinel_ebpf/codegen_bpf"
require "spinel_ebpf/validate"
require "spinel_ebpf/check"
require "spinel_ebpf/dispatch_shim"
require "spinel_ebpf/plugin"
require "spinel_ebpf/consumer"
require "spinel_ebpf/introspect"
require "spinel_ebpf/capabilities"
require "spinel_ebpf/portability"
require "spinel_ebpf/param"
require "spinel_ebpf/common_filter"
require "spinel_ebpf/keep_filter"
require "spinel_ebpf/instrument"
# the codegen <-> loader seam. Generated from src/codegen_c/loader_contract.h
# by `make -C src/codegen_c loader-contract`; build_glue_c interpolates these so the
# glue holds no map-name literal, no hand-typed strncmp length and no hand-typed
# record width. tools/loader_gate.rb fails when the committed file is stale.
require "spinel_ebpf/loader_contract_gen"

VERSION = "0.0.1"
PROJECT_ROOT = File.expand_path("..", __dir__)
SPINEL_DIR   = ENV["SPINEL_DIR"] || File.join(PROJECT_ROOT, "deps/spinel")

# AMP board profiles. Adding a second real-time core must not fork the compiler,
# so a board is nothing but a **name for a set of address values**: a header to
# read them from, and a macro that selects that header everywhere else. Nothing in
# the code generator, the real-time-core runtime or the application-core drain
# branches on which entry this is. If something ever has to, the claim that vendor
# dependence is confined to the ABI addresses and the board overlay has weakened,
# and that belongs in the record rather than behind a conditional.
AMP_BOARDS = {
  "amp-m7" => {
    key:     :imx95m7,
    label:   "i.MX95 Cortex-M7 (ARMv7E-M)",
    header:  "include/spnl/amp_abi_imx95m7.h",
    define:  "SPNL_AMP_BOARD_IMX95M7",
    service: "spinel-amp-m7",
  },
  "amp-m33" => {
    key:     :stm32mp2m33,
    label:   "STM32MP257F-DK Cortex-M33 (ARMv8-M Mainline)",
    header:  "include/spnl/amp_abi_stm32mp2m33.h",
    define:  "SPNL_AMP_BOARD_STM32MP2M33",
    service: "spinel-amp-m33",
  },
}.freeze

# Resolve mode from CLI flags + environment, in this order of precedence:
# explicit --native-only > explicit --ebpf-mixed > SPINEL_EBPF_MODE env > default eBPF.
# Conflicting explicit flags (both --native-only and --ebpf-mixed) are an error.
def resolve_mode(opts)
  if opts[:native_only] && opts[:ebpf_mixed]
    abort "error: --native-only and --ebpf-mixed are mutually exclusive"
  end
  return :native_only if opts[:native_only]
  return :ebpf_mixed  if opts[:ebpf_mixed]
  env = ENV["SPINEL_EBPF_MODE"]
  case env
  when nil, "" then :ebpf_mixed
  when "native-only" then :native_only
  when "ebpf-mixed"  then :ebpf_mixed
  else abort "error: unknown SPINEL_EBPF_MODE=#{env.inspect} (expected 'native-only' or 'ebpf-mixed')"
  end
end

def spinel_bin(name)
  path = File.join(SPINEL_DIR, name)
  unless File.executable?(path)
    abort "error: #{path} not found or not executable. Build spinel first: " \
          "make -C #{SPINEL_DIR} deps && make -C #{SPINEL_DIR}"
  end
  path
end

def run!(cmd, env = {})
  system(env, *cmd) or abort "error: command failed: #{cmd.inspect}"
end

# the upstream compiler is now the single C `spinel` binary (the Ruby
# spinel_parse/analyze/codegen moved to legacy/). Prefer it when present; the
# co-process reads the same .ast/.ir it always did (C emits the legacy format
# via --dump-ast --no-line-map / --emit-ir). Falls back to the legacy 3-binary
# pipeline for an un-migrated tree.
def c_spinel
  # prefer the current upstream target `bin/spinel` ($(SPINEL), built by
  # `make`) over the legacy `build/spinel` path. The latter is a stale fossil on
  # current upstream (no Makefile rule builds it) and lagged real fixes (e.g. the
  # FFI `:binstr` return lowering), which made spinel-ebpf emit wrong C while the
  # upstream test harness -- which uses bin/spinel -- passed. SPINEL_C_BIN overrides.
  cands = [ENV["SPINEL_C_BIN"],
           File.join(SPINEL_DIR, "bin", "spinel"),
           File.join(SPINEL_DIR, "build", "spinel")].compact
  cands.find { |p| File.executable?(p) }
end

# the in-process eBPF codegen binary. Built from the upstream
# compiler objects (minus main.o) + tools/spinel_ebpf_inproc.c (which #includes
# the codegen TU with -DSPNL_INPROCESS). It reads the analyzed Compiler struct
# directly and emits both the SPINEL-IR (.ir, via cc_build_ir_text) and the
# .bpf.c (via the ported codegen) with NO `--emit-ir`. Returns the path, or nil
# when it can't be built (objects absent / non-Linux host -- compile is Linux-only
# anyway), in which case callers fall back to the legacy --emit-ir + Ruby codegen.
def inproc_codegen_bin
  return @inproc_bin if defined?(@inproc_bin)
  out      = File.join(PROJECT_ROOT, "build/codegen_c/spinel-ebpf-cc")
  src      = File.join(PROJECT_ROOT, "tools/spinel_ebpf_inproc.c")
  tu       = File.join(PROJECT_ROOT, "src/codegen_c/spinel_ebpf_cc.c")
  objs     = Dir[File.join(SPINEL_DIR, "build/csrc/*.o")].reject { |o| File.basename(o) == "main.o" }
  libprism = File.join(SPINEL_DIR, "build/libprism.a")
  return @inproc_bin = nil unless File.exist?(src) && File.exist?(tu) && !objs.empty? && File.exist?(libprism)
  inputs = [src, tu, *objs, libprism]
  if !File.exist?(out) || inputs.map { |f| File.mtime(f) }.max > File.mtime(out)
    FileUtils.mkdir_p(File.dirname(out))
    cc  = ENV["CC"] || which("cc") || "cc"
    cmd = [cc, "-O2", "-I", File.join(SPINEL_DIR, "src"), src, *objs, libprism, "-lm", "-o", out]
    return @inproc_bin = nil unless system(*cmd)
  end
  @inproc_bin = out
end

# Run the frontend, leaving .ast and .ir in build_dir.
def run_spinel_to_ir(input_rb, build_dir)
  base = File.basename(input_rb, ".rb")
  ast = File.join(build_dir, "#{base}.ast")
  ir  = File.join(build_dir, "#{base}.ir")
  if (cs = c_spinel)
    # --no-line-map: drop source-position records so the AST is byte-identical
    # to the legacy spinel_parse output the co-process expects. (--dump-ast is
    # upstream, not a patch.)
    File.write(ast, IO.popen([cs, "--dump-ast", "--no-line-map", input_rb], &:read))
    abort "error: spinel --dump-ast failed" unless $?.success?
    # produce the .ir in-process (cc_build_ir_text, no --emit-ir;
    # Patch A was removed upstream). The in-process binary is built from the
    # spinel compiler objects, so it's available wherever build/spinel is.
    icc = inproc_codegen_bin or
      abort "error: in-process codegen binary unavailable (build spinel first: " \
            "make -C #{SPINEL_DIR}); the compiler no longer offers --emit-ir"
    File.write(ir, IO.popen([icc, input_rb, base, "--ir"], &:read))
    abort "error: in-process IR emit failed for #{input_rb}" unless $?.success?
  else
    run! [spinel_bin("spinel_parse"),   input_rb, ast]
    run! [spinel_bin("spinel_analyze"), ast,      ir]
  end
  [ast, ir, base]
end

def run_spinel_to_c(input_rb, build_dir, ast, ir, extern_methods: nil)
  base = File.basename(input_rb, ".rb")
  c_out = File.join(build_dir, "#{base}.c")
  # `param :x, default: N` is a declaration the eBPF codegen reads out of the
  # .ast; spinel's native codegen has no such notion and refuses the call
  # ("unsupported call: CallNode `param`"). So the NATIVE pass -- and only it --
  # gets a copy with the declarations commented out line-for-line. Stripping
  # earlier (the way `use_plugin` is stripped) would take the declaration out of
  # the .ast too, which is precisely where it has to survive.
  #
  # `filter_by` is on the same terms, so both are neutralised in one pass rather
  # than two temp copies.
  src0 = File.read(input_rb, encoding: "UTF-8")
  if SpinelEbpf::Param.present?(src0) || SpinelEbpf::CommonFilter.present?(src0)
    src1 = SpinelEbpf::CommonFilter.strip_declarations(SpinelEbpf::Param.strip_declarations(src0))
    stripped = File.join(Dir.mktmpdir("spnl-param"), "#{base}.rb")
    File.write(stripped, src1)
    input_rb = stripped
  end
  if (cs = c_spinel)
    # The C compiler emits native C directly from the .rb (-c). Its native
    # codegen already tolerates eBPF-only builtins / unresolved receiver forms,
    # so the legacy SPINEL_EBPF_SOFT_FAIL hook is unnecessary. Transparent
    # dispatch is ported as Patch 1: SPINEL_EXTERN_METHODS makes the C
    # codegen emit `extern <rt> sp_<name>(...)` decls for the listed methods so
    # the linker resolves them to the dispatch shim.
    env = {}
    env["SPINEL_EXTERN_METHODS"] = extern_methods.join(",") if extern_methods && !extern_methods.empty?
    run! [cs, input_rb, "-c", "-o", c_out], env
  else
    env = {}
    env["SPINEL_EXTERN_METHODS"] = extern_methods.join(",") if extern_methods && !extern_methods.empty?
    env["SPINEL_EBPF_SOFT_FAIL"] = "1"
    run! [spinel_bin("spinel_codegen"), ast, ir, c_out], env
  end
  c_out
end

# --- subcommand: compile ---

def cmd_compile(argv)
  opts = {
    native_only: false, ebpf_mixed: false, output_dir: "build",
    build: false,  # full build (.bpf.c -> .bpf.o -> skeleton -> link) into binary
    ebpf_dispatch: false,  # transparent native -> eBPF dispatch via SPINEL_EXTERN_METHODS
    enforcement: "enforce", # enforce (default) | monitor (dry-run, deny neutralized)
  }
  parser = OptionParser.new do |op|
    op.banner = "Usage: spinel-ebpf compile <file.rb> [options]"
    op.on("--native-only",
          "Skip eBPF partition. Output is identical to plain spinel.") { opts[:native_only] = true }
    op.on("--ebpf-mixed",
          "Partition Ruby into (native C + eBPF C). [default]") { opts[:ebpf_mixed] = true }
    op.on("--target TARGET",
          "codegen target. 'linux' (default), 'amp-m7' (i.MX95 Cortex-M7) or " \
          "'amp-m33' (STM32MP257F-DK Cortex-M33). The two amp targets share every line of " \
          "codegen and runtime; they differ only in the fixed-ABI address values.") { |t|
      known = ["linux", *AMP_BOARDS.keys]
      abort "error: unknown --target '#{t}' (expected #{known.map { |k| "'#{k}'" }.join(', ')})" unless known.include?(t)
      opts[:amp] = AMP_BOARDS[t]   # nil for 'linux'
    }
    op.on("--build",
          "also compile/link into single binary (requires Linux + clang + libbpf-dev + bpftool)") { opts[:build] = true }
    op.on("--amp-service-name NAME",
          "OTLP service.name written to the amp-m7 manifest (default spinel-amp-m7)") { |n| opts[:amp_service_name] = n }
    op.on("--amp-otlp-endpoint URL",
          "OTLP endpoint written to the amp-m7 manifest (default http://127.0.0.1:4318)") { |u| opts[:amp_otlp_endpoint] = u }
    op.on("--amp-helper-base HEX",
          "override the helper-table base baked into the blob (default = header AMP_HELPER_BASE; QEMU uses SRAM)") { |h| opts[:amp_helper_base] = Integer(h) }
    op.on("--ebpf-dispatch",
          "route :ebpf method calls from main through bpf_prog_test_run (requires --build)") {
      opts[:ebpf_dispatch] = true
    }
    op.on("--instrument",
          "auto-instrument the target -- build it (noinline) + a sidecar uprobe agent (rate)") {
      opts[:instrument] = true
    }
    op.on("--instrument-only LIST", "comma-separated method names to instrument") { |l|
      opts[:instrument_only] = l.split(",").map(&:strip).reject(&:empty?)
    }
    op.on("--instrument-skip LIST", "comma-separated method names to exclude") { |l|
      opts[:instrument_skip] = l.split(",").map(&:strip).reject(&:empty?)
    }
    op.on("--instrument-duration N", Integer,
          "dump-mode observation window in seconds (default 10)") { |n|
      opts[:instrument_duration] = n
    }
    op.on("--instrument-dump",
          "one-shot mode -- observe then dump per-method hist to stderr (default: /metrics server)") {
      opts[:instrument_dump] = true
    }
    op.on("--instrument-port N", Integer,
          "Prometheus /metrics port (default 9100; env SPINEL_HTTP_PORT overrides at run)") { |n|
      opts[:instrument_port] = n
    }
    op.on("--instrument-otlp ENDPOINT",
          "push per-method RED as OTLP/HTTP+protobuf to ENDPOINT (e.g. http://127.0.0.1:4318); needs --instrument-self") { |e|
      opts[:instrument_otlp] = e
    }
    op.on("--instrument-otlp-traces",
          "push the method call tree as OTLP traces (spans) instead of metrics (with --instrument-otlp)") {
      opts[:instrument_otlp_traces] = true
    }
    op.on("--instrument-self",
          "single self-attaching binary (workload + agent in one; no sidecar)") {
      opts[:instrument_self] = true
    }
    op.on("--instrument-depth-collapse",
          "recursive methods count only the outermost call (per-(tid,method) depth)") {
      opts[:instrument_depth_collapse] = true
    }
    op.on("--self-targets LIST",
          "(internal): force these top-level methods :native (self-instrument workload methods)") { |l|
      opts[:self_targets] = l.split(",").map(&:strip).reject(&:empty?)
    }
    op.on("--noinline-symbols LIST",
          "(internal): inject __attribute__((noinline)) on these C symbols (the uprobe targets)") { |l|
      opts[:noinline_symbols] = l.split(",").map(&:strip).reject(&:empty?)
    }
    op.on("--int-overflow MODE",
          "int +/-/* overflow handling raise|wrap|promote (default: raise; auto wrap with --ebpf-dispatch to match eBPF __s64)") { |m|
      abort "error: --int-overflow expects raise|wrap|promote (got #{m.inspect})" unless %w[raise wrap promote].include?(m)
      opts[:int_overflow] = m
    }
    op.on("--enforcement MODE",
          "enforce (default) | monitor. A monitor build runs each handler for its " \
          "side effects (map updates / emit / counters) but neutralizes the deny " \
          "verdict to allow for lsm / fmod_ret / cgroup connect4|bind4 -- the deny is " \
          "not emitted at all. Being ahead-of-time, a monitor binary cannot deny; " \
          "there is no runtime mode byte to flip.") { |m|
      abort "error: --enforcement expects enforce|monitor (got #{m.inspect})" unless %w[enforce monitor].include?(m)
      opts[:enforcement] = m
    }
    op.on("--emit-sources DIR",
          "Write a shippable source bundle to DIR (native C + the generated skeleton " \
          "+ glue + a Makefile). The destination needs neither clang nor bpftool; " \
          "this is the counterpart of upstream spinel's `-c`.") { |d|
      opts[:emit_sources] = d
    }
    # --- flags that mean here what they mean in upstream spinel, so that opting
    # --- into eBPF never costs you one of spinel's own capabilities.
    op.on("--cc CMD", "As in spinel: the C compiler that builds the native side (default " \
                      "clang; the eBPF side still needs clang for -target bpf)") { |c| opts[:cc] = c }
    op.on("-O LEVEL", "As in spinel: optimization level (default 2)") { |l| opts[:opt_level] = l }
    op.on("-g", "As in spinel: emit debug information") { opts[:debug] = true }
    op.on("--link ARG", "As in spinel: an extra link input (object / archive / -lLIB, repeatable)") { |a|
      (opts[:extra_links] ||= []) << a
    }
    op.on("-o DIR", "--output DIR",
          "Output directory (default: build/)") { |d| opts[:output_dir] = d }
    op.on("-v", "--verbose", "Verbose output") { opts[:verbose] = true }
    op.on("-h", "--help", "Show this message") { puts op; exit 0 }
  end
  files = parser.parse!(argv)

  abort parser.help if files.length != 1
  input = files[0]
  abort "error: #{input} not found" unless File.exist?(input)

  # --instrument operates on the original target program (a plain native
  # workload). It enumerates the target's methods, builds it with noinline so
  # the sp_<name> symbols survive, then generates + builds a sidecar uprobe
  # agent. Handle it before the plugin/consumer source transforms (which apply
  # to the *agent*, re-entered via cmd_compile).
  return cmd_instrument(input, opts) if opts[:instrument]

  # `use_plugin :ebpf` plugin declaration. Detect on the
  # original source; validate any declared plugin early (discover + ABI); then
  # hand spinel a sanitized copy (a top-level `use_plugin` aborts spinel's -c).
  src_text = File.read(input, encoding: "UTF-8") # locale may default to US-ASCII
  declared = SpinelEbpf::Plugin.detect_declarations(src_text)
  manifests = declared.map do |name|
    m = SpinelEbpf::Plugin.discover(name)
    abort "error: plugin '#{name}' not installed (declared via `use_plugin :#{name}`; " \
          "set SPINEL_PLUGIN_PATH or install the plugin)" if m.nil?
    begin
      SpinelEbpf::Plugin.validate!(m)
    rescue SpinelEbpf::Plugin::LoadError => e
      abort "error: #{e.message}"
    end
    warn "[spinel-ebpf] use_plugin :#{name} -> #{m.root}/plugin.toml (abi #{m.abi_version})" if opts[:verbose]
    m
  end
  # build-time arbiter -- declared plugins must not conflict
  # (plugins may not claim the same namespace). No-op for a single plugin.
  begin
    SpinelEbpf::Plugin.arbitrate!(manifests)
  rescue SpinelEbpf::Plugin::ArbitrationError => e
    abort "error: #{e.message}"
  end
  if opts[:verbose] && !manifests.empty?
    plan = SpinelEbpf::Plugin.lifecycle_order(manifests)
    warn "[spinel-ebpf] lifecycle: " +
         plan.map { |phase, plug, hook| "#{phase}(#{plug}.#{hook})" }.join(" -> ")
  end
  # Source sanitize/transform for spinel (which rejects DSL keywords in -c):
  #  - strip `use_plugin` directives (Plugin)
  #  - lower `on_emit`/`consume_events` consumer DSL to plain Ruby (Consumer)
  transformed = src_text
  transformed = SpinelEbpf::Plugin.strip_declarations(transformed) unless declared.empty?
  # The typed record consumer rejects an unknown `ev.<prop>` (and an
  # ambiguous `on_emit :<name>`) right here, before spinel sees the source.
  # loud + actionable, not a Ruby backtrace.
  begin
    transformed = SpinelEbpf::Consumer.transform(transformed)
  rescue SpinelEbpf::Consumer::Error => e
    abort "error: #{e.message}"
  end
  if transformed != src_text
    base0 = File.basename(input, ".rb")
    san = File.join(Dir.mktmpdir("spnl-src"), "#{base0}.rb")
    File.write(san, transformed)
    input = san # spinel/in-process calls read the sanitized copy
  end

  mode = resolve_mode(opts)
  FileUtils.mkdir_p(opts[:output_dir])
  warn "[spinel-ebpf] mode=#{mode}  input=#{input}  build_dir=#{opts[:output_dir]}" if opts[:verbose]

  ast_path, ir_path, base = run_spinel_to_ir(input, opts[:output_dir])

  if mode == :native_only
    c_path = run_spinel_to_c(input, opts[:output_dir], ast_path, ir_path)
    puts "[spinel-ebpf] native-only: wrote #{c_path}"
    if opts[:build] || opts[:emit_sources]
      out = build_binary(base, opts[:output_dir], false, verbose: opts[:verbose],
                         int_overflow: opts[:int_overflow], **build_flags(opts))
      puts "[spinel-ebpf] #{opts[:emit_sources] ? "emit-sources" : "build"}: wrote #{out}"
    end
    return 0
  end

  # ebpf_mixed: parse IR + AST, run partition, print tag table.
  ir  = SpinelEbpf::ParseSpinelIR.parse_file(ir_path)
  ast = SpinelEbpf::ParseSpinelAst.parse_file(ast_path)
  result = SpinelEbpf::Partition.classify(ir, ast, force_native: opts[:self_targets])

  print_partition_table(result, base)

  # Fail loudly, before code generation runs, on the gaps between partitioning
  # and codegen: an attach handler that would silently fall back to native, an
  # unknown builtin (usually a typo), or an incomplete set of required calls (a
  # probe that exits 0 having emitted no span). This only adds error paths; the
  # code generated for a probe that does compile is untouched.
  begin
    SpinelEbpf::Validate.validate!(ast, result)
  rescue SpinelEbpf::Validate::Error => e
    abort "error: #{e.message}"
  end

  # using the BPF namespace requires `use_plugin :ebpf`
  # (there is no silent native fallback). Strict (SPNL_STRICT_PLUGINS=1)
  # makes it a hard error; default warns so the existing example corpus keeps
  # building during migration (Phase 3 scope note).
  if SpinelEbpf::Plugin.uses_bpf_namespace?(result) && !declared.include?(:ebpf)
    n = result.methods.count { |m| m.tag == :ebpf }
    msg = "BPF namespace used without `use_plugin :ebpf` (#{n} eBPF method(s)); " \
          "add `use_plugin :ebpf` to #{files[0]}"
    if SpinelEbpf::Plugin.strict?
      abort "error: #{msg}"
    else
      warn "[spinel-ebpf] warning: #{msg} (set SPNL_STRICT_PLUGINS=1 to enforce)"
    end
  end

  # with --ebpf-dispatch, collect the :ebpf top-level methods eligible for
  # transparent dispatch and ask spinel to emit them as extern declarations.
  # Without --ebpf-dispatch, spinel keeps its default (static inline body) and
  # main calls the native version locally -- no BPF round-trip.
  extern_methods = opts[:ebpf_dispatch] ? SpinelEbpf::DispatchShim.eligible_method_names(result) : nil
  if opts[:ebpf_dispatch] && (extern_methods.nil? || extern_methods.empty?)
    warn "[spinel-ebpf] --ebpf-dispatch: no eligible :ebpf methods (need top-level + non-attach + non-builtin)"
  end

  # Always emit native C (the host side runs the :native methods + loads :ebpf skeletons).
  c_path = run_spinel_to_c(input, opts[:output_dir], ast_path, ir_path, extern_methods: extern_methods)
  # self-instrument keeps the workload methods native (--self-targets)
  # and needs their real C symbols (--noinline-symbols, from --emit-symbol-map) to
  # survive -O2 so the self-uprobe can attach.
  if opts[:noinline_symbols] && !opts[:noinline_symbols].empty?
    File.write(c_path, SpinelEbpf::Instrument.inject_noinline(File.read(c_path), opts[:noinline_symbols]))
  end
  puts "[spinel-ebpf] ebpf-mixed: wrote #{c_path}"

  # emit .bpf.c for ebpf-tagged methods (if any).
  # --target amp-m7 emits an h2.c-shaped .bpf.c (ivar -> static memory,
  # spnl_emit -> amp_emit) for the micro-bpf ARMv7E-M host-AOT; the C codegen
  # selects handlers via cc_method_eligible, so force emission regardless of tags.
  ebpf_count = result.methods.count { |m| m.tag == :ebpf }
  if ebpf_count > 0 || opts[:amp]
    bpf_path = File.join(opts[:output_dir], "#{base}.bpf.c")
    # emit .bpf.c via the in-process C codegen (byte-identical
    # to the Ruby CodegenBpf, which is now retained as the regression oracle).
    if (icc = inproc_codegen_bin)
      # --self-targets excludes the workload methods from the eBPF IR
      # (cc_is_consumer_fn reads SPNL_EBPF_EXCLUDE), so a self-instrument unit
      # keeps them native while still emitting the uprobe progs.
      icc_env = {}
      icc_env["SPNL_AMP_M7"] = "1" if opts[:amp]   # AMP codegen path (board-agnostic)
      icc_env["SPNL_ENFORCEMENT"] = "monitor" if opts[:enforcement] == "monitor"
      icc_env["SPNL_EBPF_EXCLUDE"] = opts[:self_targets].join(",") if opts[:self_targets] && !opts[:self_targets].empty?
      File.write(bpf_path, IO.popen(icc_env, [icc, input, base], &:read))
      unless $?.success?
        # The codegen writes to stdout and die()s partway, so what landed in
        # bpf_path is whatever it had emitted -- for a gate that fires early, an
        # empty file. Leaving it behind makes a loud failure look like it produced
        # something (and a later `make` in the same -o dir would find a .bpf.c).
        # The message is already on stderr, straight from the codegen.
        File.delete(bpf_path) if File.exist?(bpf_path)
        abort "error: in-process eBPF codegen failed for #{input}\n" \
              "       (re-run with --native-only to skip eBPF emission)"
      end
      if opts[:amp]
        puts "[spinel-ebpf] amp: wrote #{bpf_path} for #{opts[:amp][:label]} " \
             "(clang -target bpf -> micro-bpf Thumb AOT)"
      else
        puts "[spinel-ebpf] ebpf-mixed: wrote #{bpf_path} (#{ebpf_count} eBPF programs, in-process)"
      end
    else
      # --enforcement=monitor is implemented in the production C codegen only;
      # the retired Ruby oracle (CodegenBpf) has no monitor path. Fail loud
      # rather than silently emit an enforce build.
      if opts[:enforcement] == "monitor"
        abort "error: --enforcement=monitor requires the in-process C codegen (build spinel: " \
              "make -C #{SPINEL_DIR}); the fallback Ruby codegen has no monitor path, and " \
              "silently producing an enforce build is not an option"
      end
      begin
        bpf_text = SpinelEbpf::CodegenBpf.emit(ir, ast, result, base_name: base)
        File.write(bpf_path, bpf_text)
        puts "[spinel-ebpf] ebpf-mixed: wrote #{bpf_path} (#{ebpf_count} eBPF programs)"
      rescue SpinelEbpf::CodegenBpf::UnsupportedNode => e
        abort "error: eBPF codegen failed: #{e.message}\n" \
              "       (re-run with --native-only to skip eBPF emission)"
      end
    end
  else
    warn "[spinel-ebpf] ebpf-mixed: no eBPF programs to emit (all methods are :native)"
  end

  # emit the dispatch shim file alongside .bpf.c. It only takes effect at
  # link time (build_binary picks it up when both --ebpf-dispatch and --build).
  dispatch_path = nil
  if opts[:ebpf_dispatch] && extern_methods && !extern_methods.empty?
    dispatch_path = File.join(opts[:output_dir], "#{base}_dispatch.c")
    File.write(dispatch_path, SpinelEbpf::DispatchShim.emit(ir, ast, result, base_name: base))
    puts "[spinel-ebpf] ebpf-dispatch: wrote #{dispatch_path} (#{extern_methods.length} shims)"
  end

  # The portability contract is a property of each SIDE of the partition, not of
  # the program. Print it right after the partition table so "which side does
  # this method run on" and "what does that side require" are read together --
  # and so the kernel floor is never something the reader (or an AI) has to
  # guess.
  begin
    bpf_for_contract = File.join(opts[:output_dir], "#{base}.bpf.c")
    contract = SpinelEbpf::Portability.contract(File.exist?(bpf_for_contract) ? File.read(bpf_for_contract) : nil)
    puts ""
    puts SpinelEbpf::Portability.human(contract)
    puts ""
  end

  # --build does the full toolchain. Native-only short-circuits to plain
  # spinel build; eBPF-mixed runs the full Ruby -> binary pipeline.
  if opts[:build] || opts[:emit_sources]
    if opts[:amp]
      # amp-m7 output is blob + manifest (M7 and A55 are separate cores =
      # separate artifacts), NOT the Linux single binary. Separate build path.
      build_amp(base, opts[:output_dir], opts)
    else
      # with --ebpf-dispatch the native side calls into eBPF (__s64 wrap), so
      # default the native overflow mode to wrap for consistency unless overridden.
      eff_overflow = opts[:int_overflow] || (opts[:ebpf_dispatch] ? "wrap" : nil)
      warn "[spinel-ebpf] --ebpf-dispatch: native int overflow -> wrap (match eBPF; override with --int-overflow=raise)" if eff_overflow == "wrap" && opts[:int_overflow].nil?
      out = build_binary(base, opts[:output_dir], ebpf_count > 0,
                         dispatch_path: dispatch_path, verbose: opts[:verbose],
                         partition_result: result, int_overflow: eff_overflow,
                         keep_filters: SpinelEbpf::KeepFilter.loader_declarations(src_text),
                         **build_flags(opts))
      puts "[spinel-ebpf] #{opts[:emit_sources] ? "emit-sources" : "build"}: wrote #{out}"
    end
  end
  0
end

# --- subcommand: compile --instrument ---
#
# Auto-instrument a target program for per-method call rate:
#   1. enumerate the target's instrumentable top-level methods,
#   2. build the target native, injecting noinline so sp_<name> stays uprobe-able,
#   3. generate a sidecar uprobe agent (Instrument.generate_agent) and build
#      it through the normal compile pipeline (consumer DSL + uprobe codegen).
# Output is two binaries; the agent attaches to the target via SPNL_UPROBE_BINARY
# (sidecar model -- single-binary self-attach is S4). Default agent is a long-lived
# Prometheus /metrics server (S3); --instrument-dump gives the S2 one-shot dump.
# authoritative method -> C symbol map via upstream `--emit-symbol-map`.
def instrument_symbol_map(target_input, build_dir)
  cs = c_spinel or abort "error: --instrument needs the C spinel binary (build/spinel)"
  base = File.basename(target_input, ".rb")
  out  = File.join(build_dir, "#{base}.symmap.json")
  run! [cs, target_input, "--emit-symbol-map", "-o", out]
  SpinelEbpf::Instrument.parse_symbol_map(File.read(out))
end

def cmd_instrument(target_input, opts)
  build_dir = opts[:output_dir]
  FileUtils.mkdir_p(build_dir)
  base = File.basename(target_input, ".rb")

  # 1. authoritative method -> C symbol map, filtered to instrumentable
  #    (drops builtins/attach; applies --instrument-only/-skip). Records carry the
  #    real C symbol, Ruby name, kind (toplevel/imeth/cmeth), file, line.
  records = SpinelEbpf::Instrument.instrumentable(
              instrument_symbol_map(target_input, build_dir),
              only: opts[:instrument_only], skip: opts[:instrument_skip])
  abort "error: --instrument: no instrumentable methods in #{target_input}" if records.empty?
  puts "[spinel-ebpf] instrument: #{records.length} method(s): #{records.map { |r| r[:ruby] }.join(', ')}"

  # OTLP push observes the workload in-process (one-shot after it runs),
  # so it requires the self-attaching single binary. No silent fallback.
  if opts[:instrument_otlp] && !opts[:instrument_self]
    abort "error: --instrument-otlp requires --instrument-self (the workload is observed in-process and pushed from there)"
  end

  # single self-attaching binary (workload + agent in one).
  return cmd_instrument_self(target_input, base, records, opts) if opts[:instrument_self]

  csyms = records.map { |r| r[:c] }
  # 2. build the instrumented target (native + noinline on the real symbols).
  ast_path, ir_path, _ = run_spinel_to_ir(target_input, build_dir)
  c_path = run_spinel_to_c(target_input, build_dir, ast_path, ir_path)
  File.write(c_path, SpinelEbpf::Instrument.inject_noinline(File.read(c_path), csyms))
  target_bin = File.expand_path(build_binary(base, build_dir, false, verbose: opts[:verbose],
                                             int_overflow: opts[:int_overflow]))
  puts "[spinel-ebpf] instrument: target -> #{target_bin}"

  # 3. generate + build the sidecar agent through the normal pipeline.
  mode = opts[:instrument_dump] ? :dump : :metrics
  port = opts[:instrument_port] || 9100
  wait = opts[:instrument_duration] || 10
  agent_rb = File.join(build_dir, "#{base}_agent.rb")
  File.write(agent_rb, SpinelEbpf::Instrument.generate_agent(records, target_bin: target_bin,
                                                             mode: mode, wait_seconds: wait, port: port,
                                                             depth_collapse: opts[:instrument_depth_collapse]))
  puts "[spinel-ebpf] instrument: agent source -> #{agent_rb} (mode=#{mode})"
  agent_argv = [agent_rb, "--build", "--ebpf-dispatch", "-o", build_dir]
  agent_argv << "-v" if opts[:verbose]
  rc = cmd_compile(agent_argv)
  return rc unless rc.zero?
  agent_bin = File.expand_path(File.join(build_dir, "#{base}_agent"))
  puts "[spinel-ebpf] instrument: agent -> #{agent_bin}"
  puts
  puts "Run (sidecar -- start the agent first so the uprobes attach before the target runs):"
  if mode == :metrics
    puts "  SPNL_UPROBE_BINARY=#{target_bin} SPINEL_HTTP_PORT=#{port} #{agent_bin} &"
    puts "  #{target_bin}                 # exercise the target"
    puts "  curl -s localhost:#{port}/metrics"
  else
    puts "  SPNL_UPROBE_BINARY=#{target_bin} #{agent_bin} &   # observes #{wait}s then dumps"
    puts "  #{target_bin}"
  end
  0
end

# single self-attaching binary -- the workload + the agent compiled into
# one unit. The workload methods are forced native + noinline (--self-targets) so
# their sp_<name> symbols survive; the uprobes self-attach to /proc/self/exe at
# the own pid. The workload runs in-process (firing the self-uprobes), then the
# agent serves /metrics. No sidecar, no multi-attach double-count.
def cmd_instrument_self(target_input, base, records, opts)
  build_dir = opts[:output_dir]
  port = opts[:instrument_port] || 9100
  target_source = File.read(target_input, encoding: "UTF-8")
  combined = SpinelEbpf::Instrument.generate_self_agent(records, target_source, port: port,
                                                        depth_collapse: opts[:instrument_depth_collapse],
                                                        otlp_endpoint: opts[:instrument_otlp],
                                                        otlp_traces: opts[:instrument_otlp_traces])
  combined_rb = File.join(build_dir, "#{base}_self.rb")
  File.write(combined_rb, combined)
  puts "[spinel-ebpf] instrument-self: combined source -> #{combined_rb}"

  # --self-targets (top-level Ruby names) forces those native + excludes them from
  # the eBPF IR; --noinline-symbols (all real C symbols) protects them from -O2.
  self_targets  = SpinelEbpf::Instrument.self_target_names(records)
  noinline_syms = records.map { |r| r[:c] }
  argv = [combined_rb, "--build", "-o", build_dir]
  argv += ["--self-targets", self_targets.join(",")] unless self_targets.empty?
  argv += ["--noinline-symbols", noinline_syms.join(",")] unless noinline_syms.empty?
  argv << "-v" if opts[:verbose]
  rc = cmd_compile(argv)
  return rc unless rc.zero?
  bin = File.expand_path(File.join(build_dir, "#{base}_self"))
  puts "[spinel-ebpf] instrument-self: #{bin}"
  puts
  puts "Run (single self-instrumenting binary; workload runs then /metrics serves):"
  puts "  SPINEL_HTTP_PORT=#{port} #{bin}"
  puts "  curl -s localhost:#{port}/metrics"
  0
end

# ---------- full build helpers ----------

def which(name)
  ENV["PATH"].split(":").each do |dir|
    p = File.join(dir, name)
    return p if File.executable?(p)
  end
  nil
end

# The ISA baseline. Unpinned, clang picks it for us and the choice moves with the
# build host: clang 19 emits v1 and clang 22 emits v3 for the SAME source
# (measured: 111 of 116 goldens differ in instructions between the two defaults),
# and `-mcpu=probe` is documented to ask the running kernel. A .bpf.o is shipped
# verbatim inside the generated skeleton (--emit-sources), so an unpinned ISA
# means the artifact's kernel floor is whatever the build machine happened to
# imply. v1 is the floor every committed golden was measured to reach: over the
# corpus as it stood at the time of measurement (118 units), compile and load
# outcomes were identical at v1, v2, v3 and at the then-current default, and v1
# was instruction-identical to the clang-19 build for all 116 that compile. Only
# v4 changes anything (it compiles the signed division in one polymorphic
# fixture), and v4 would raise the floor to kernel 6.6 for every probe in order
# to fix a single fixture that the `divu` builtin already covers.
BPF_ISA_BASELINE = "v1"

# bpf_arena's address-space cast. This is the one declared exception to the
# baseline, and its trigger is a property of the SOURCE (`address_space(1)`
# appears in the generated .bpf.c), never of the host -- so it stays
# reproducible. It also costs no portability: arena needs kernel 6.9+, which is
# already above v3's 5.1 floor.
BPF_ISA_ARENA = "v3"

# the `clang -target bpf -c <bpf.c> -o <bpf.o>` argv, factored so both
# build_binary (via run!) and `spinel-ebpf check` (via Open3.capture3) drive the
# identical command. Pure (no side effects) -- reads bpf_c only to decide -mcpu.
def bpf_clang_argv(clang, bpf_c, bpf_o, build_dir)
  arch_macro = RbConfig::CONFIG["host_cpu"] =~ /aarch64|arm64/ ? "-D__TARGET_ARCH_arm64" : "-D__TARGET_ARCH_x86"
    # <bpf/usdt.bpf.h> transitively pulls in <linux/errno.h> -> <asm/errno.h>,
  # which lives under /usr/include/<triplet>/asm/ on debian-style toolchains.
  arch_inc_flags = Dir.glob("/usr/include/*-linux-gnu").reject(&:empty?).flat_map { |p| ["-I", p] }
  # bpf_arena uses the address-space cast, only emitted at ISA v3+, so a program
  # that references the arena address space builds at the arena ISA instead.
  isa = (File.exist?(bpf_c) && File.read(bpf_c).include?("address_space(1)")) ? BPF_ISA_ARENA : BPF_ISA_BASELINE
  [clang, "-O2", "-g", "-target", "bpf", arch_macro, "-mcpu=#{isa}",
   *arch_inc_flags,
   *bpf_repro_flags(build_dir),
   "-I", build_dir, "-I", File.join(PROJECT_ROOT, "include"),
   "-c", bpf_c, "-o", bpf_o]
end

# Strip the build machine out of the artifact.
#
# Measured before this existed: the same probe built twice from the same repo into
# two different -o directories produced .bpf.o files that DIFFER, and `strings`
# found the output directory, the cwd and the clang version string inside them.
# The .bpf.o is embedded byte-for-byte in the generated skeleton, so those strings
# ship. Three flags, the same set ebpf-go's bpf2go uses:
#
#   -fdebug-prefix-map=<build_dir>=.  the .bpf.c path (given absolutely to -c) and
#   -fdebug-prefix-map=<root>=.       the -I paths, as they land in DWARF and in
#                                     .BTF.ext line info. build_dir is mapped FIRST
#                                     so `<anywhere>/<base>.bpf.c` always becomes
#                                     `./<base>.bpf.c`, whatever -o the caller gave.
#   -fdebug-compilation-dir .         DW_AT_comp_dir, which is otherwise the cwd.
#   -fno-ident                        drops the compiler ident record.
#
# Note these normalise the *recorded* paths only; the argv still uses real paths,
# so nothing about include resolution changes.
def bpf_repro_flags(build_dir)
  ["-fdebug-prefix-map=#{File.expand_path(build_dir)}=.",
   "-fdebug-prefix-map=#{PROJECT_ROOT}=.",
   "-fdebug-compilation-dir", ".",
   "-fno-ident"]
end

# Optional DWARF-only strip of the .bpf.o (opt-in via SPNL_BPF_STRIP=1).
#
# Measured: `llvm-strip -g` leaves .BTF byte-identical and keeps .BTF.ext (where
# CO-RE relocations live) and .symtab; all probed goldens still LOAD_OK, and the
# object shrinks by ~98% (887,520 -> 19,424 B for the dotted-kfield golden). That matters
# because the object is embedded in the skeleton and shipped.
#
# It is NOT the default, because it would make the artifact depend on the build
# host's tool inventory -- the exact class of bug this pinning is closing. Debian's
# `clang` package ships no llvm-strip, and GNU strip cannot read BPF ELF at all
# ("Unable to recognise the format of the input file"; it leaves the file
# untouched), so "strip if available" would silently produce two different
# artifacts on two machines. Opting in is explicit, and it fails loud.
def bpf_strip_maybe!(bpf_o)
  return unless ENV["SPNL_BPF_STRIP"] == "1"
  strip = %w[llvm-strip llvm-strip-22 llvm-strip-21 llvm-strip-20 llvm-strip-19].map { |n| which(n) }.compact.first
  unless strip
    abort "error: SPNL_BPF_STRIP=1 but no llvm-strip on PATH.\n" \
          "  why: only llvm-strip understands BPF ELF; GNU strip reports\n" \
          "       \"Unable to recognise the format of the input file\" and leaves it unchanged.\n" \
          "  fix: apt-get install llvm  (provides llvm-strip), or unset SPNL_BPF_STRIP."
  end
  # -g = DWARF only. .BTF / .BTF.ext / .symtab must survive: libbpf needs .BTF for
  # map/prog BTF and .BTF.ext for CO-RE relocations.
  run! [strip, "-g", bpf_o]
end

# build (and cache) the load-only verifier probe (tools/spnl_load_check.c).
# Returns the binary path, or nil when it can't be built here (non-Linux host,
# missing cc / libbpf-dev). Cached at build/spnl_load_check with an mtime check
# and a runnability preflight (build/ is bind-mounted, so a host-built binary can
# be un-execable in the container and vice-versa -- mirror tools/golden.rb).
def load_check_bin
  return @load_check_bin if defined?(@load_check_bin)
  src = File.join(PROJECT_ROOT, "tools/spnl_load_check.c")
  return @load_check_bin = nil unless File.exist?(src) && SpinelEbpf::Check.linux?
  out = File.join(PROJECT_ROOT, "build/spnl_load_check")
  FileUtils.mkdir_p(File.dirname(out))
  if !File.exist?(out) || File.mtime(src) > File.mtime(out)
    cc = ENV["CC"] || which("cc") || "cc"
    ok = system(cc, "-O2", src, "-lbpf", "-lelf", "-lz", "-o", out,
                out: File::NULL, err: File::NULL)
    return @load_check_bin = nil unless ok
  end
  # Preflight: no-arg run prints usage and exits 2. system returns nil only when
  # exec itself failed (wrong-platform ELF) -- treat that as unavailable.
  return @load_check_bin = nil if system(out, out: File::NULL, err: File::NULL).nil?
  @load_check_bin = out
rescue StandardError
  @load_check_bin = nil
end

# amp-m7 --build. Unlike the Linux --build (single binary), amp-m7 emits
# TWO artifacts (M7 and A55 are separate cores):
#   <base>.blob     -- the Thumb blob (single-pass; helper call -> AMP_HELPER_SLOT(id),
#                     no firmware nm). id 1 = amp_emit, id 2 = amp_ktime.
#   <base>.manifest -- abi_version / ivars_size / triggers (from codegen, via the
#                     manifest dumper) + service.name / otlp.endpoint (deployment
#                     config, NOT baked into the blob).
def build_amp(base, build_dir, opts)
  board = opts[:amp]
  bpf_c = File.join(build_dir, "#{base}.bpf.c")
  bpf_o = File.join(build_dir, "#{base}.bpf.o")
  abort "error: amp --build: missing #{bpf_c} (codegen step did not run)" unless File.exist?(bpf_c)

  clang = which("clang") or abort "error: amp --build needs clang (-target bpf)"

  # The two addresses the blob carries are supplied here, from the board profile
  # header. The generated .bpf.c declares SPNL_AMP_IVARS_BASE behind `#ifndef`
  # precisely so this step can name the board's value without the compiler having
  # to know that boards exist.
  ivars_base = amp_abi_const("AMP_IVARS_BASE", board)
  run! [clang, "-O2", "-target", "bpf",
        format("-DSPNL_AMP_IVARS_BASE=%#010xu", ivars_base),
        "-c", bpf_c, "-o", bpf_o]

  driver = amp_aot_driver or abort <<~MSG
    error: amp --build needs the micro-bpf host AOT driver (bytecode -> Thumb).
      run:       scripts/setup.sh   (fetches the micro-bpf fork this driver builds against)
      then:      (cd tools/amp_aot_driver && cargo build --release)
      or set:    SPNL_AMP_AOT_DRIVER=/path/to/aot-driver
  MSG

  hbase  = opts[:amp_helper_base] || amp_abi_const("AMP_HELPER_BASE", board)
  sbytes = amp_abi_const("AMP_HELPER_SLOT_BYTES", board)
  # The ahead-of-time compiler cannot bake an immediate with bit 31 set beyond 8
  # bits, so an address that cannot be baked has to fail here, with the reason --
  # not later, as a blob that silently calls address zero.
  [["helper table", hbase], ["ivars", ivars_base]].each do |what, addr|
    next if (addr & 0x8000_0000).zero?
    abort "error: amp --build: #{what} base #{format('%#010x', addr)} has bit 31 set.\n" \
          "       The ahead-of-time compiler cannot bake such an immediate into the blob,\n" \
          "       so this address has to live below 0x80000000 on #{board[:label]}.\n" \
          "       (Fix the value in #{board[:header]}, not here.)"
  end

  blob = File.join(build_dir, "#{base}.blob")
  env = { "AMP_HELPER_1" => format("0x%08x", hbase),
          "AMP_HELPER_2" => format("0x%08x", hbase + sbytes) }
  run! [driver, bpf_o, blob], env

  manifest = File.join(build_dir, "#{base}.manifest")
  write_amp_manifest(manifest, bpf_c, build_dir, opts)

  puts "[spinel-ebpf] amp --build (#{board[:label]}): wrote #{blob} + #{manifest}"
  puts "[spinel-ebpf] amp: helper@#{format('%#010x', hbase)} ivars@#{format('%#010x', ivars_base)} " \
       "abi=#{amp_abi_const('AMP_ABI_VERSION', board)}"
  puts "[spinel-ebpf] amp: blob -> real-time-core staging (a55_stage), manifest -> the fixed " \
       "drain (amp_a55_drain). Two cores = blob + manifest, not one binary."
end

# Locate the host AOT driver binary (external Rust tool over rbpf-for-microcontrollers).
def amp_aot_driver
  cands = [ENV["SPNL_AMP_AOT_DRIVER"],
           File.join(PROJECT_ROOT, "tools/amp_aot_driver/target/release/aot-driver")].compact
  cands.find { |p| File.executable?(p) }
end

# Read a `#define <NAME> <int>` from the selected board's fixed ABI header (single
# source of truth: the CLI greps the same header the runtime and the codegen mirror
# use, not a duplicate). `board` is an AMP_BOARDS entry; nil means the default.
def amp_abi_const(name, board = nil)
  hdr = File.join(PROJECT_ROOT, (board || AMP_BOARDS["amp-m7"])[:header])
  m = File.read(hdr, encoding: "UTF-8")[/^\s*#define\s+#{Regexp.escape(name)}\s+(0x[0-9A-Fa-f]+|\d+)u?\b/, 1]
  abort "error: #{name} not found in #{hdr}" unless m
  Integer(m)
end

# Pack <base>.manifest: codegen fields (via the dumper that #includes the .bpf.c)
# + deployment config (service.name / otlp.endpoint). probe-specific info lives in
# the manifest, never baked into the blob.
def write_amp_manifest(path, bpf_c, build_dir, opts)
  board = opts[:amp] || AMP_BOARDS["amp-m7"]
  dumper_src = File.join(PROJECT_ROOT, "src/runtime/amp/amp_manifest_dump.c")
  cc = ENV["CC"] || which("cc") || "cc"
  dumper = File.join(build_dir, "amp_manifest_dump")
  # The manifest has to state the ABI the blob was actually built for, or the
  # loader's version gate becomes a rubber stamp. Both the board macro and the
  # version come from the same profile the blob's addresses came from.
  run! [cc, "-O2", "-Wno-int-conversion",
        %(-DAMP_BPF_C="#{File.expand_path(bpf_c)}"),
        "-D#{board[:define]}",
        format("-DSPNL_AMP_ABI_VERSION=%uu", amp_abi_const("AMP_ABI_VERSION", board)),
        "-I", File.join(PROJECT_ROOT, "include"),
        dumper_src, "-o", dumper]
  fields = IO.popen([dumper], &:read)
  abort "error: amp manifest dump failed" unless $?.success?

  service  = opts[:amp_service_name]  || board[:service]
  endpoint = opts[:amp_otlp_endpoint] || "http://127.0.0.1:4318"
  File.write(path,
             "# spinel-ebpf amp manifest\n" \
             "board=#{board[:key]}\n" \
             "service.name=#{service}\n" \
             "otlp.endpoint=#{endpoint}\n" \
             "#{fields}")
end

# turn the cryptic `undefined reference to eu_search_tree_init' link failure
# into an actionable message. elfutils < 0.195 installs a libelf.a whose elf_begin.o
# references eu_search_tree_* / eu_tsearch but ships no definition -- the defining
# objects live in the internal libeu.a, which upstream marks `noinst` so no distro
# packages it (NOT a Debian-specific quirk). 0.195 merges them via libelf_a_LIBADD.
# Only aborts when the breakage is POSITIVELY detected; a missing nm or an archive
# we cannot locate is not an error (never block a link that would have worked).
def static_libelf_path(clang, elf_dir)
  return File.join(elf_dir, "libelf.a") if elf_dir && !elf_dir.empty?
  p = `#{clang} -print-file-name=libelf.a 2>/dev/null`.strip
  return p if !p.empty? && File.file?(p)
  # clang's -print-file-name does not search the multiarch dirs; fall back to them.
  Dir.glob("/usr/lib/*-linux-*/libelf.a").first || "/usr/lib/libelf.a"
end

def check_static_libelf!(clang, elf_dir)
  path = static_libelf_path(clang, elf_dir)
  return unless path && File.file?(path)
  nm = which("nm") or return
  out = `#{nm} #{path} 2>/dev/null`
  return if out.empty?
  undefined = out.lines.grep(/^\s+U eu_/).map { |l| l.split.last }.uniq
  return if undefined.empty?
  defined_here = out.lines.grep(/^[0-9a-fA-F]+\s+[A-Za-z]\s+eu_/).map { |l| l.split.last }
  missing = undefined - defined_here
  return if missing.empty?
  abort <<~MSG
    error: SPNL_STATIC=1 but this libelf.a cannot satisfy a static link:
             #{path}
           It references #{missing.sort.first(3).join(", ")}#{missing.length > 3 ? ", ..." : ""} with no definition in the archive.
           elfutils < 0.193 leaves those in its internal libeu.a, which upstream never
           installs (`noinst_LIBRARIES`), so no distro ships them. Fixed upstream in 0.193.

           Fix (easiest) -- install elfutils >= 0.193 from your distro; then plain
           SPNL_STATIC=1 works and SPNL_STATIC_ELF_DIR is not needed:
             Debian trixie    : apt install -t trixie-backports libelf-dev  # 0.195-1~bpo13+1
             Debian sid/forky : apt install libelf-dev                      # 0.195-1
             Alpine / Fedora  : current elfutils-dev / elfutils-libelf-devel-static is 0.195
           Fix (no newer package available) -- build elfutils and point at its libelf.a:
             ./configure --disable-debuginfod --disable-libdebuginfod --disable-werror
             make -C lib && make -C libelf libelf.a
             SPNL_STATIC=1 SPNL_STATIC_ELF_DIR=<elfutils-src>/libelf spinel-ebpf compile ... --build
           Or drop SPNL_STATIC=1 to build a dynamic binary (needs matching .so on the target).
  MSG
end

# Materialize a shippable source bundle instead of linking here. Upstream spinel's portability story is "emit one self-contained
# .c, ship it, build it on the target with its own cc" (`spinel app.rb -c`);
# adding eBPF must not take that away. It doesn't have to: the eBPF side is
# already compiled to *architecture-neutral* bytecode and embedded in the
# generated skeleton (a C array), so the bundle carries the kernel side as
# portable C too -- the target needs no clang, no bpftool and no BTF *to build*
# (BTF is still required at run time, for CO-RE).
#
# The Makefile is generated from the very argv `--build` would have run, so the
# two paths cannot drift: every conditional source (OTLP, TLS, dispatch shim)
# is already resolved by the time we get here.
def emit_source_bundle(out_dir, base:, defines:, include_args:, c_file:, sources:,
                       link_args:, with_ebpf:, spinel_lib:, build_dir:, cc:, opt_flags:,
                       bpf_c: nil)
  FileUtils.mkdir_p(out_dir)
  vendor = "spinel-ebpf"   # relative root, inside the bundle, for our own sources

  # Map one absolute path into the bundle, copying it, and return the path to
  # write into the Makefile. Files under PROJECT_ROOT keep their relative tree
  # so that their #include neighbours resolve exactly as they do here.
  place = lambda do |abs|
    abs = File.expand_path(abs)
    if abs.start_with?(File.expand_path(build_dir) + "/")
      rel = File.basename(abs)
      FileUtils.cp(abs, File.join(out_dir, rel)) unless File.expand_path(File.join(out_dir, rel)) == abs
      rel
    elsif abs.start_with?(File.expand_path(spinel_lib) + "/") || abs == File.expand_path(spinel_lib)
      rel = abs.sub(File.expand_path(spinel_lib), "spinel-lib")
      FileUtils.mkdir_p(File.dirname(File.join(out_dir, rel)))
      FileUtils.cp(abs, File.join(out_dir, rel)) if File.file?(abs)
      rel.sub(%r{\Aspinel-lib}, "$(SPINEL_LIB)")
    elsif abs.start_with?(PROJECT_ROOT + "/")
      rel = File.join(vendor, abs.sub(PROJECT_ROOT + "/", ""))
      FileUtils.mkdir_p(File.dirname(File.join(out_dir, rel)))
      FileUtils.cp(abs, File.join(out_dir, rel)) if File.file?(abs)
      rel
    else
      abs   # outside our trees (system path): reference as-is
    end
  end

  # Include directories: copy the headers that live in them (recursively for
  # our own trees) so the bundle is self-contained.
  copy_headers = lambda do |dir|
    Dir.glob(File.join(dir, "**", "*.h")).each { |h| place.call(h) }
  end

  inc_flags = []
  include_args.each_slice(2) do |flag, dir|
    next unless flag == "-I"
    abs = File.expand_path(dir)
    if abs == File.expand_path(build_dir)
      inc_flags << "-I." ; next
    end
    copy_headers.call(abs) if File.directory?(abs)
    mapped =
      if abs == File.expand_path(spinel_lib) then "$(SPINEL_LIB)"
      elsif abs.start_with?(PROJECT_ROOT + "/") then File.join(vendor, abs.sub(PROJECT_ROOT + "/", ""))
      elsif abs == PROJECT_ROOT then vendor
      else abs
      end
    inc_flags << "-I#{mapped}"
  end

  src_rel  = [place.call(c_file)] + sources.map { |s| place.call(s) }
  link_rel = link_args.map { |a| a.start_with?("-") ? a : place.call(a) }

  # The kernel-side sources ship for audit even though the Makefile does not
  # compile them (the skeleton already carries the verified bytecode).
  if with_ebpf
    ["#{base}.bpf.c", "#{base}.bpf.o", "#{base}.skel.h"].each do |f|
      p = File.join(build_dir, f)
      FileUtils.cp(p, File.join(out_dir, f)) if File.exist?(p)
    end
  end

  contract = SpinelEbpf::Portability.contract(bpf_c)
  # The MANIFEST's prose about architecture is derived from the same contract the
  # compile output prints, so the bundle cannot say one thing while the contract
  # says another. An arch-bound unit gets a different paragraph -- not a footnote
  # on the portable one -- because the actionable advice differs (rebuild on the
  # target's kernel vs. just carry the skeleton over).
  arch_section =
    if contract.ebpf && contract.ebpf["arch_bound"]
      <<~BOUND.strip
        This unit is **fixed to #{contract.ebpf["build_arch"]}**. It #{contract.ebpf["arch_bound_by"].join(" / ")},
        which **picks a field name of `struct pt_regs` at compile time** and so cannot be
        absorbed by CO-RE (`vmlinux.h` comes from the BTF of the running kernel; what CO-RE
        can fix up at run time is a field's offset, and it cannot create a field that is not
        there). **The bundled `#{base}.skel.h` is not meant to be carried to a destination on
        another architecture** -- re-run `spinel-ebpf compile --emit-sources` on a kernel of
        that architecture instead.

        This does **not** mean it fails to run on another architecture. What was measured
        stops at "the host it was built on cannot build it for another architecture".

        Shipping to big-endian (s390x / mips / ppc64) is **untested** -- not known to be
        broken, just not verified.
      BOUND
    elsif contract.ebpf
      <<~FREE.strip
        This unit **does not read arguments out of registers** (no `PT_REGS_PARM`, no USDT),
        so it is not bound to an architecture. eBPF bytecode is architecture-independent
        **within one endianness** (what CO-RE absorbs at run time is the layout of kernel
        structs, not the byte order of the instruction stream). Within that range,
        `#{base}.skel.h` **can be carried to a destination on another architecture as it
        is**. Only the native side depends on the architecture, and the destination's `cc`
        takes care of that.

        Shipping to big-endian (s390x / mips / ppc64) is **untested** -- not known to be
        broken, just not verified.
      FREE
    else
      "This unit has no eBPF partition, so there is no architecture restriction either " \
      "(the same terms as upstream spinel)."
    end
  File.write(File.join(out_dir, "Makefile"), <<~MAKE)
    # Generated by spinel-ebpf --emit-sources.
    # Built from the exact argv `--build` would have run, so this Makefile and
    # an in-place build produce the same binary.
    #
    # Requirements on THIS machine:
    #   - a C compiler (CC below; any gcc/clang)
    #   - spinel's runtime: headers + libspinel_rt.a  -> point SPINEL_LIB at it
    #{with_ebpf ? "#   - libbpf headers + libbpf/libelf/libz  (the eBPF bytecode is already\n    #     embedded in #{base}.skel.h, so clang / bpftool / BTF are NOT needed here)" : "#   (this unit has no eBPF partition: plain upstream spinel requirements)"}

    CC        ?= #{cc}
    SPINEL_LIB ?= ./spinel-lib
    CFLAGS    ?= #{(opt_flags + defines).join(" ")}
    LDLIBS    ?= #{link_rel.select { |a| a.start_with?("-l") }.join(" ")}

    INCLUDES  = #{inc_flags.join(" ")}
    SOURCES   = #{src_rel.join(" \\\n            ")}
    ARCHIVES  = #{link_rel.reject { |a| a.start_with?("-") }.join(" ")}

    #{base}: $(SOURCES) $(ARCHIVES)
    \t$(CC) $(CFLAGS) $(INCLUDES) $(SOURCES) $(ARCHIVES) $(LDLIBS) -o $@

    clean:
    \trm -f #{base}
    .PHONY: clean
  MAKE

  File.write(File.join(out_dir, "MANIFEST.md"), <<~MD)
    # #{base} -- source bundle

    The output of `spinel-ebpf compile #{base}.rb --emit-sources`. **Carry this one
    directory to the destination and `make`** -- the same way upstream spinel's
    `spinel app.rb -c` is used.

    ## Contents

    | File | What it is |
    |---|---|
    | `#{base}.c` | the native side, in C. Upstream spinel's output, unchanged |
    #{with_ebpf ? "| `#{base}.skel.h` | **the kernel side itself**: the verified eBPF bytecode embedded as a C array. This is why the destination needs neither clang nor bpftool |\n    | `#{base}.bpf.c` | the kernel side in C, for audit. Not used by the build -- the skeleton above is what counts |\n    | `#{base}_glue.c` | load / attach / drain / teardown |" : "| -- | this unit has no eBPF partition |"}
    | `Makefile` | generated from the same argv `--build` runs |
    | `spinel-ebpf/` | the bundled runtime sources |
    | `spinel-lib/` | spinel's runtime (headers + `libspinel_rt.a`) |

    ## The portability contract

    #{SpinelEbpf::Portability.human(contract)}

    ### About architecture

    **The "portability contract" above is what counts.** This section only restates it,
    so believe the section above if the two ever look different.

    #{arch_section}

    In every case, `spinel-lib/libspinel_rt.a` -- and mbedTLS's `.a` files when TLS is in
    use -- are **for the architecture of the machine this was built on**. To build for
    another architecture, build upstream spinel's runtime at the destination and pass
    `make SPINEL_LIB=<that directory>`.
  MD

  warn "[spinel-ebpf] emitted source bundle: #{out_dir}"
  out_dir
end

# The compiler-facing flags spinel-ebpf shares with upstream spinel, collected
# once so every build path honours them identically.
def build_flags(opts)
  { cc: opts[:cc], opt_level: opts[:opt_level], debug: opts[:debug] ? true : false,
    extra_links: opts[:extra_links] || [],
    emit_sources: opts[:emit_sources] }
end

def build_binary(base, build_dir, with_ebpf, dispatch_path: nil, verbose: false, partition_result: nil,
                 int_overflow: nil, cc: nil, opt_level: nil, debug: false,
                 extra_links: [], emit_sources: nil, keep_filters: [])
  abort "error: --build only supported on Linux (got #{RbConfig::CONFIG["host_os"]})" unless RbConfig::CONFIG["host_os"] =~ /linux/i
  clang   = which("clang")   || abort("error: clang not found in PATH")
  bpftool = with_ebpf ? (which("bpftool") || abort("error: bpftool not found")) : nil
  # int overflow mode is a compile-time define in spinel's runtime
  # (sp_runtime.h). spinel-ebpf compiles the native .c itself, so we pass the
  # -D here (raise = no define = default; wrap matches the eBPF __s64 side).
  ov_flag = case int_overflow
            when "wrap"    then ["-DSP_INT_OVERFLOW_MODE_WRAP"]
            when "promote" then ["-DSP_INT_OVERFLOW_MODE_PROMOTE"]
            else []
            end

  c_file  = File.join(build_dir, "#{base}.c")
  out_bin = File.join(build_dir, base)

  # link against the runtime that MATCHES the compiler in use. The C
  # `spinel` emits native C referencing its (newer) runtime (sp_runtime.h +
  # libspinel_rt.a), so when it drives codegen we must use its sibling lib/ dir,
  # not the legacy pin's.
  spinel_lib =
    if (cs = c_spinel)
      File.expand_path("../lib", File.dirname(cs))
    else
      File.join(SPINEL_DIR, "lib")
    end
  abort "error: spinel lib not found at #{spinel_lib}" unless File.directory?(spinel_lib)

  # link libspinel_rt.a (sp_net / sp_crypto / sp_bigint runtime).
  spinel_rt = File.join(spinel_lib, "libspinel_rt.a")
  rt_link   = File.exist?(spinel_rt) ? [spinel_rt] : []

  include_args = ["-I", spinel_lib, "-I", File.join(PROJECT_ROOT, "include")]
  # -lutil: forkpty(3) for the PTY/WebSocket interactive terminal (sp_pty_* / sp_ws_*).
  # -lcrypt: String#crypt lowers to libc crypt(3), which glibc keeps in libcrypt
  # (macOS has it in libSystem). libspinel_rt.a carries an undefined `crypt` since
  # a recent upstream sync, so the link fails without this. Mirrors upstream
  # spinel's common.mk, which gates the same flag on Linux.
  crypt_link   = RbConfig::CONFIG["host_os"] =~ /linux/ ? ["-lcrypt"] : []
  link_args    = rt_link + ["-lm", "-lutil"] + crypt_link
  cflags_extra = []  # -DOTLP_WITH_TLS is appended here, and only when TLS is used

  # Link the OTLP exporter only when the generated .c references an spnl_otlp_* FFI.
  # The OTLP core (otlp_http/grpc/metrics/traces/logs/json/httpspan + nanopb) does
  # not depend on libbpf, so it links into both native builds (an HTTP server span,
  # say) and eBPF ones. otlp_agent.c drains bpf maps, so it is eBPF-only.
  c_src       = File.exist?(c_file) ? File.read(c_file) : ""
  # A typed consumer's accessors are named spnl_rec_*, so a consumer that never
  # sends (one that only counts records, or writes them out in another format)
  # contains no spnl_otlp_ symbol at all. Those accessors still live in
  # otlp_agent.c, so the record FFI has to trigger the link as well.
  otlp_on     = c_src.include?("spnl_otlp_") || c_src.include?("spnl_rec_")
  # An https:// or grpcs:// endpoint pulls in mbedTLS (gated by OTLP_WITH_TLS).
  otlp_tls_on = otlp_on && (c_src.include?("https://") || c_src.include?("grpcs://"))

  if with_ebpf
    # The skeleton's struct name comes from the bpf.o file's base name; if the
    # Ruby unit starts with a digit, that's an invalid C identifier. Use the
    # same sanitized name as codegen_bpf uses for the unit (e.g. u_17_kprobe).
    skel_name = SpinelEbpf::CodegenBpf.sanitize_identifier(base)
    bpf_c   = File.join(build_dir, "#{base}.bpf.c")
    bpf_o   = File.join(build_dir, "#{base}.bpf.o")
    skel_h  = File.join(build_dir, "#{base}.skel.h")
    glue_c  = File.join(build_dir, "#{base}_glue.c")
    vmlinux = File.join(build_dir, "vmlinux.h")

    unless File.exist?(vmlinux)
      warn "[spinel-ebpf] generating vmlinux.h via bpftool" if verbose
      File.write(vmlinux, `#{bpftool} btf dump file /sys/kernel/btf/vmlinux format c`)
      abort "error: vmlinux.h generation failed" if File.empty?(vmlinux)
    end

    # the `clang -target bpf` invocation is shared with `spinel-ebpf check`
    # (which captures its output instead of aborting). bpf_clang_argv builds the
    # exact same argv, so build_binary's behaviour is byte-identical.
    run! bpf_clang_argv(clang, bpf_c, bpf_o, build_dir)
    # Opt-in DWARF strip. Must run BEFORE the skeleton is generated, since
    # the skeleton embeds these exact bytes. `check` deliberately verifies the
    # pre-strip object: strip is DWARF-only and leaves .BTF byte-identical and
    # .BTF.ext intact (measured), so the two forms load the same.
    bpf_strip_maybe!(bpf_o)
    # `name <sanitized>` overrides the struct prefix in the generated skel.h.
    File.write(skel_h, `#{bpftool} gen skeleton #{bpf_o} name #{skel_name}`)
    abort "error: bpftool gen skeleton failed" if File.empty?(skel_h)
    # Which programs want a kprobe_multi link, and with which symbols. Read out
    # of the EMITTED .bpf.c rather than re-derived from the partition result,
    # because the choice between the two lowerings depends on a threshold, and a
    # threshold that lived both here and in the C codegen would be a threshold
    # that drifts. The codegen decides once and says so in a line only it writes;
    # this side obeys. Expanded handlers produce ordinary SEC("kprobe/<sym>")
    # programs and need nothing here -- libbpf auto-attaches them, which is
    # exactly why expansion is the cheaper mechanism to support.
    kprobe_multis = File.read(bpf_c).scan(
      %r{/\* spnl:attach-multi kind=kprobe mode=multi n=\d+ prog=(\S+) syms=(\S+) \*/}
    ).map { |prog, syms| { prog_name: prog, syms: syms.split(",") } }

    # collect reactor uprobe/USDT targets from MethodInfo so glue.c
    # can emit a per-prog target table.
    # also collect reactor perf_event progs with their Hz frequency.
    reactor_uprobes     = []
    reactor_usdts       = []
    reactor_perf_events = []
    if partition_result
      partition_result.methods.each do |mi|
        next unless mi.scope == :top_level && mi.tag == :ebpf
        if mi.respond_to?(:dsl_uprobe_binary) && mi.dsl_uprobe_binary
          # prefer per-handler `pid:` kw arg, fall through to -1
          # (= libbpf's "all processes"). glue.c also lets env override
          # -1 entries via $SPNL_*_PID.
          pid = (mi.respond_to?(:dsl_attach_pid) && mi.dsl_attach_pid) ? mi.dsl_attach_pid : -1
          if mi.dsl_usdt_provider
            reactor_usdts << {
              prog_name: SpinelEbpf::CodegenBpf.method_func_name(mi),
              binary:    mi.dsl_uprobe_binary,
              provider:  mi.dsl_usdt_provider,
              probe:     mi.dsl_usdt_name,
              pid:       pid,
            }
          elsif mi.dsl_uprobe_func
            reactor_uprobes << {
              prog_name: SpinelEbpf::CodegenBpf.method_func_name(mi),
              binary:    mi.dsl_uprobe_binary,
              func:      mi.dsl_uprobe_func,
              retprobe:  mi.dsl_uprobe_retprobe ? 1 : 0,
              go_ret:    mi.dsl_uprobe_go_ret ? 1 : 0,   # attach at every RET offset
              pid:       pid,
            }
          end
        end
        # reactor perf_event progs carry the sampling frequency in
        # dsl_perf_event_hz. Hz <= 0 means "use env / default". Flat-form
        # `def perf_event__<name>` doesn't set this field; glue.c picks up
        # those programs by SEC name and uses env / default Hz.
        if mi.respond_to?(:dsl_perf_event_hz) && mi.dsl_perf_event_hz
          reactor_perf_events << {
            prog_name: SpinelEbpf::CodegenBpf.method_func_name(mi),
            hz:        mi.dsl_perf_event_hz,
          }
        end
      end
    end
    kc_ast_file = File.join(build_dir, "#{base}.ast")
    # The same read-back for `param` -- the loader needs the name (to find the
    # rodata field the codegen emitted) and the env var it answers to.
    params = with_ebpf ? SpinelEbpf::Param.declarations_from_ast_file(kc_ast_file) : []
    # And for `filter_by` -- a fixed vocabulary, so the loader only needs to know
    # WHICH keys this unit declared (the rodata symbol and the env var follow
    # from the key name).
    filter_keys = with_ebpf ? SpinelEbpf::CommonFilter.declarations_from_ast_file(kc_ast_file) : []
    File.write(glue_c, build_glue_c(base, skel_name,
                                    with_dispatch: !dispatch_path.nil?,
                                    reactor_uprobes: reactor_uprobes,
                                    reactor_usdts: reactor_usdts,
                                    reactor_perf_events: reactor_perf_events,
                                    kprobe_multis: kprobe_multis,
                                    params: params,
                                    filter_keys: filter_keys,
                                    # The userspace consumer filter. Read from the
                                    # SOURCE, not the .ast -- the declaration is lowered into
                                    # the generated consumer before spinel ever sees it, so
                                    # it never reaches an .ast (unlike `param`/`filter_by`).
                                    keep_filters: with_ebpf ? keep_filters : [],
                                    with_otlp: otlp_on))

    include_args.concat(["-I", build_dir, "-I", File.join(PROJECT_ROOT, "src/runtime")])
    extra_sources = [glue_c, File.join(PROJECT_ROOT, "src/runtime/spnl_runtime.c")]
    # dispatch shim file (sp_<name> implementations that call bpf_prog_test_run).
    extra_sources << dispatch_path if dispatch_path
    link_args = ["-lbpf", "-lelf", "-lz"] + link_args
    # otlp_agent.c (draining the bpf maps behind auto-instrumented RED metrics)
    # and otlp_metric.c (generic keyed metrics from any probe) both read bpf maps,
    # so they depend on libbpf and are eBPF-only. The libbpf-independent OTLP core
    # is linked in the shared block below.
    if otlp_on
      extra_sources << File.join(PROJECT_ROOT, "src/runtime/otlp/otlp_agent.c")
      # Resolves a cgroup id to the Kubernetes pod that owns it; called by the
      # packed-record span pushes in otlp_agent.c. It is pure C and needs no
      # libbpf, but its only caller is eBPF-only, so it is linked here.
      extra_sources << File.join(PROJECT_ROOT, "src/runtime/otlp/otlp_k8s.c")
      # Resolves a destination IP to a peer pod, Service, or external address;
      # called by the connection span push.
      extra_sources << File.join(PROJECT_ROOT, "src/runtime/otlp/otlp_peer.c")
      # Resolves a cgroup id to the real container name reported by the CRI,
      # replacing the container id in k8s.container.name with a readable name.
      extra_sources << File.join(PROJECT_ROOT, "src/runtime/otlp/otlp_cri.c")
      # The enricher registry: otlp_agent.c calls the k8s / CRI / peer resolvers
      # through otlp_enrich_run rather than one by one.
      extra_sources << File.join(PROJECT_ROOT, "src/runtime/otlp/otlp_enrich.c")
      extra_sources << File.join(PROJECT_ROOT, "src/runtime/otlp/otlp_metric.c")
      # Aggregating and sending the metrics derived from a record channel. The
      # drain in otlp_agent.c calls the generated intake
      # (spnl_recmetric_observe_<ch>); this is where that lives. It is kept out of
      # the span path's translation unit to keep exactly one TU instantiating the
      # generated tables -- the same arrangement the typed consumer's
      # SPNL_REC_CONSUME_IMPL uses.
      extra_sources << File.join(PROJECT_ROOT, "src/runtime/otlp/otlp_recmetric.c")
      # Cross-layer lookup: reads L3/L4 metrics keyed by connection 4-tuple out of
      # a bpf map, so a userspace span can carry what the kernel measured.
      extra_sources << File.join(PROJECT_ROOT, "src/runtime/otlp/otlp_xlayer.c")
    end
  else
    extra_sources = []
  end

  # The OTLP core (no libbpf dependency): linked into native and eBPF builds alike.
  if otlp_on
    otlp_dir = File.join(PROJECT_ROOT, "src/runtime/otlp")
    nanopb   = File.join(PROJECT_ROOT, "src/runtime/otlp/nanopb")
    include_args.concat(["-I", otlp_dir, "-I", File.join(otlp_dir, "pb"), "-I", nanopb])
    extra_sources.concat([File.join(otlp_dir, "otlp_http.c"),
                          File.join(otlp_dir, "otlp_grpc.c"),
                          File.join(otlp_dir, "otlp_metrics.c"),
                          File.join(otlp_dir, "otlp_traces.c"),
                          File.join(otlp_dir, "otlp_logs.c"),
                          File.join(otlp_dir, "otlp_json.c"),     # OTLP/HTTP+JSON
                          File.join(otlp_dir, "otlp_httpspan.c"), # HTTP server span + traceparent
                          File.join(nanopb, "pb_encode.c"),
                          File.join(nanopb, "pb_common.c")])
    extra_sources.concat(Dir[File.join(otlp_dir, "pb/opentelemetry/**/*.pb.c")].sort)
    # -lz is for gzip in otlp_http.c. The eBPF link args already carry it; a
    # native build has to add it explicitly.
    link_args << "-lz" unless link_args.include?("-lz")
    # Sending straight to an https:// or grpcs:// endpoint links mbedTLS; a
    # plain-http build does not link it at all.
    if otlp_tls_on
      mbedtls = File.join(PROJECT_ROOT, "deps/mbedtls")
      run!(["sh", File.join(PROJECT_ROOT, "scripts/build-mbedtls.sh")])  # idempotent: guarded by an arch stamp
      cflags_extra << "-DOTLP_WITH_TLS"
      include_args.concat(["-I", File.join(mbedtls, "include")])
      extra_sources << File.join(otlp_dir, "otlp_tls.c")
      extra_sources.concat([File.join(mbedtls, "library/libmbedtls.a"),
                            File.join(mbedtls, "library/libmbedx509.a"),
                            File.join(mbedtls, "library/libmbedcrypto.a")])
    end
  end

  # spinel-ebpf's own sp_net extensions (read_line / sendfile /
  # epoll / pty / ws / reap + read_line-aware rl_close/rl_recv_some) live HERE,
  # not patched into upstream lib/sp_net.c. Linked into every binary; references
  # to upstream sp_net_close/recv_some/shutdown_requested resolve from
  # libspinel_rt.a, -lutil (already in link_args) provides forkpty.
  extra_sources << File.join(PROJECT_ROOT, "src/runtime/sp_net_ext.c")

  # SPNL_STATIC=1: fully static binary (libbpf/elf/z/c statically linked). The
  # eBPF .bpf.o is CO-RE so it relocates against the *target* kernel's BTF at
  # load -- a static build therefore runs on another arm64 host (e.g. a board)
  # without matching its glibc/libbpf. Used for cross-deploy benchmarking.
  static_flag = ENV["SPNL_STATIC"] == "1" ? ["-static"] : []
  # static libbpf.a pulls in ZSTD (compressed BTF) -- add it explicitly (after
  # -lbpf so the static linker resolves the reference). Harmless when dynamic.
  static_libs = ENV["SPNL_STATIC"] == "1" ? ["-lzstd"] : []
  # a static link needs a libelf.a that CARRIES the elfutils libeu objects.
  # elfutils merged them in 0.195 (libelf/Makefile.am: libelf_a_LIBADD); 0.192 and
  # earlier ship an archive whose elf_begin.o references eu_search_tree_* with no
  # definition anywhere, and libeu.a is `noinst` upstream so no distro packages it.
  # $SPNL_STATIC_ELF_DIR points at a directory holding a good libelf.a (e.g. a
  # self-built elfutils >= 0.195). Gated on SPNL_STATIC because in a dynamic link
  # an -L dir holding only libelf.a would silently win over the system libelf.so.
  static_ldirs = []
  if ENV["SPNL_STATIC"] == "1"
    if (elf_dir = ENV["SPNL_STATIC_ELF_DIR"]) && !elf_dir.empty?
      abort "error: SPNL_STATIC_ELF_DIR=#{elf_dir} has no libelf.a" \
        unless File.exist?(File.join(elf_dir, "libelf.a"))
      static_ldirs = ["-L", elf_dir]
    end
    check_static_libelf!(clang, ENV["SPNL_STATIC_ELF_DIR"])
  end
  # spinel's own compiler-facing flags stay available when you opt into eBPF. `--cc` / `-O` / `-g` / `--link` mean here what they mean in
  # upstream spinel, so opting into the eBPF partition never costs you a spinel
  # capability. clang is still required for `-target bpf`; the *native* side may
  # be built by whatever compiler the user names. (spinel's `-I` -- the `require`
  # search root -- is NOT forwarded: the in-process codegen re-parses the source
  # for partition/IR without it, so honouring it on one frontend only would
  # compile a different program than the one it partitioned. Deferred until the
  # in-process codegen takes include roots too.)
  native_cc = cc || clang
  opt_flags = ["-O#{opt_level.nil? ? 2 : opt_level}"] + (debug ? ["-g"] : [])
  link_args = link_args + extra_links

  if emit_sources
    bpf_c_path = File.join(build_dir, "#{base}.bpf.c")
    return emit_source_bundle(emit_sources, base: base,
                              defines: ov_flag + cflags_extra,
                              include_args: include_args, c_file: c_file,
                              sources: extra_sources, link_args: link_args,
                              with_ebpf: with_ebpf, spinel_lib: spinel_lib,
                              build_dir: build_dir, cc: native_cc, opt_flags: opt_flags,
                              bpf_c: (File.exist?(bpf_c_path) ? File.read(bpf_c_path) : nil))
  end

  cmd = [native_cc, *opt_flags, *ov_flag, *cflags_extra, *static_flag, *include_args, c_file, *extra_sources, *static_ldirs, *link_args, *static_libs, "-o", out_bin]
  warn "[spinel-ebpf] linking: #{cmd.join(" ")}" if verbose
  run! cmd
  out_bin
end

# Generated _glue.c -- auto-loads/attaches BPF in a constructor, cleans up in destructor.
# `base` is the user-facing unit name (used only for the .skel.h include path);
# `skel_name` is the sanitized C identifier prefix produced by bpftool gen skeleton.
# `with_dispatch`: when true, the skeleton pointer is given external
# linkage so the generated <base>_dispatch.c TU can reach it.
def build_glue_c(base, skel_name, with_dispatch: false,
                 reactor_uprobes: [], reactor_usdts: [], reactor_perf_events: [],
                 kprobe_multis: [],
                 params: [], filter_keys: [], keep_filters: [],
                 with_otlp: false)
  storage = with_dispatch ? "" : "static "

  # every token this heredoc shares with the generated .bpf.c comes from
  # src/codegen_c/loader_contract.h via loader_contract_gen.rb -- map names,
  # program-name prefixes (with their strncmp lengths), ELF section names, the
  # width of the record sp_bpf_user_cmd_push moves and the PROG_ARRAY slot base.
  # tools/loader_gate.rb refuses a name-carrying site here that is not declared.
  lc = SpinelEbpf::LoaderContract

  # OTLP push FFI shims. Reads the per-unit emit ringbuf / keyed-hist via the
  # loaded skeleton's obj and hands it to the generic exporter (otlp_agent.c). Emitted only
  # when the unit uses it (so non-OTLP glue is unchanged). Map names come from a single
  # source (the naming helpers/constants shared with the codegen) rather than being
  # transcribed here in the glue.
  _hist_map  = lc::MAP_HIST_KEYED
  _emit4_map = "#{skel_name}#{lc::SUFFIX_EMIT4}"
  _int_map   = "#{skel_name}#{lc::SUFFIX_EMIT_INT}"
  _str_map   = "#{skel_name}#{lc::SUFFIX_EMIT_STR}"
  _conn_map  = "#{skel_name}#{lc::SUFFIX_CONN}"
  _dns_map   = "#{skel_name}#{lc::SUFFIX_DNS}"
  _l7_map    = "#{skel_name}#{lc::SUFFIX_L7}"
  _http_map  = "#{skel_name}#{lc::SUFFIX_HTTP}"
  _redis_map = "#{skel_name}#{lc::SUFFIX_REDIS}"
  _offcpu_map = "#{skel_name}#{lc::SUFFIX_OFFCPU}"
  otlp_push_shim = with_otlp ? <<~SHIM : ""
    /* OTLP metrics push (resolves the ffi_func :spnl_otlp_push). */
    extern int spnl_otlp_push_obj(struct bpf_object *obj, const char *map_name, const char *endpoint);
    int spnl_otlp_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_push_obj(_spnl_skel->obj, "#{_hist_map}", endpoint);
    }
    /* Generic keyed metrics push: arbitrary labels, independent of --instrument.
       hist_observe_by(key, val) plus spnl_otlp_series_label(key, ...) turns
       measurements taken by any probe into OTLP metrics. */
    extern int spnl_otlp_metric_push_obj(struct bpf_object *obj, const char *map_name,
                                         const char *metric_name, const char *endpoint);
    int spnl_otlp_metric_push(const char *metric_name, const char *endpoint)
    {
        if (!_spnl_skel || !endpoint || !metric_name) return -1;
        return spnl_otlp_metric_push_obj(_spnl_skel->obj, "#{_hist_map}", metric_name, endpoint);
    }
    /* OTLP traces push (resolves the ffi_func :spnl_otlp_trace_push).
       Drains the per-unit emit4 ringbuf (enter/exit span events). */
    extern int spnl_otlp_trace_push_obj(struct bpf_object *obj, const char *map_name, const char *endpoint);
    int spnl_otlp_trace_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_trace_push_obj(_spnl_skel->obj, "#{_emit4_map}", endpoint);
    }
    /* OTLP logs push -- drain the per-unit emit ringbuf (int / str) as LogRecords. */
    extern int spnl_otlp_log_push_obj(struct bpf_object *obj, const char *map_name, int is_str, const char *endpoint);
    int spnl_otlp_log_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_log_push_obj(_spnl_skel->obj, "#{_int_map}", 0, endpoint);
    }
    int spnl_otlp_log_push_str(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_log_push_obj(_spnl_skel->obj, "#{_str_map}", 1, endpoint);
    }
    /* Live audit spans: drains the [file, comm, parent] triple from the string
       ringbuf and sends an OTLP audit span, using the kernel ktime of the event
       as the span timestamp rather than the time the drain happened. */
    extern int spnl_otlp_audit_span_push_obj(struct bpf_object *obj, const char *map_name, const char *endpoint);
    int spnl_otlp_audit_span_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_audit_span_push_obj(_spnl_skel->obj, "#{_str_map}", endpoint);
    }
    /* Network audit spans: drains the connection ringbuf and turns each record
       (process, remote peer, smoothed RTT) into a span. */
    extern int spnl_otlp_conn_span_push_obj(struct bpf_object *obj, const char *map_name, const char *endpoint);
    int spnl_otlp_conn_span_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_conn_span_push_obj(_spnl_skel->obj, "#{_conn_map}", endpoint);
    }
    /* DNS query spans: drains the DNS ringbuf, parses the QNAME out of the raw
       packet bytes in userspace, and emits a "resolve <name>" span. */
    extern int spnl_otlp_dns_span_push_obj(struct bpf_object *obj, const char *map_name, const char *endpoint);
    int spnl_otlp_dns_span_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_dns_span_push_obj(_spnl_skel->obj, "#{_dns_map}", endpoint);
    }
    /* Typed-consumer drain: reads the records that `on_emit :dns do |ev| ... end`
       consumes out of the ringbuf into an array, returning the count. The
       ev.<field> accessors and to_span/send need no shim of their own -- they
       work off in-process state. Only the drain needs to know the map name. */
    extern int spnl_rec_dns_drain_obj(struct bpf_object *obj, const char *map_name, int timeout_ms);
    int spnl_rec_dns_drain(int timeout_ms)
    {
        if (!_spnl_skel) return -1;
        return spnl_rec_dns_drain_obj(_spnl_skel->obj, "#{_dns_map}", timeout_ms);
    }
    /* The same drain shim for every channel that opts in to typed consumers, so
       one program can consume several channels; the generated driver drains each
       channel in turn. */
    extern int spnl_rec_l7_drain_obj(struct bpf_object *obj, const char *map_name, int timeout_ms);
    int spnl_rec_l7_drain(int timeout_ms)
    {
        if (!_spnl_skel) return -1;
        return spnl_rec_l7_drain_obj(_spnl_skel->obj, "#{_l7_map}", timeout_ms);
    }
    extern int spnl_rec_http_drain_obj(struct bpf_object *obj, const char *map_name, int timeout_ms);
    int spnl_rec_http_drain(int timeout_ms)
    {
        if (!_spnl_skel) return -1;
        return spnl_rec_http_drain_obj(_spnl_skel->obj, "#{_http_map}", timeout_ms);
    }
    extern int spnl_rec_conn_drain_obj(struct bpf_object *obj, const char *map_name, int timeout_ms);
    int spnl_rec_conn_drain(int timeout_ms)
    {
        if (!_spnl_skel) return -1;
        return spnl_rec_conn_drain_obj(_spnl_skel->obj, "#{_conn_map}", timeout_ms);
    }
    /* The off-CPU drain is the one that also takes a stack map name: `ev.wait_kind`
       (the spnl.wait.kind attribute) classifies a wait by resolving the stack *id*
       stored in the record against that object's bpf_stacks map. The one-call form
       below (spnl_otlp_offcpu_span_push) is handed the same pair. */
    extern int spnl_rec_offcpu_drain_obj(struct bpf_object *obj, const char *map_name, const char *stacks_map, int timeout_ms);
    int spnl_rec_offcpu_drain(int timeout_ms)
    {
        if (!_spnl_skel) return -1;
        return spnl_rec_offcpu_drain_obj(_spnl_skel->obj, "#{_offcpu_map}", "#{lc::MAP_STACKS}", timeout_ms);
    }
    /* L7 latency spans: drains the l7 ringbuf into spans carrying process, peer and
       duration. The span duration is a real request/response round trip (send to
       recv), unlike a connection span, whose duration is zero by construction. */
    extern int spnl_otlp_l7_span_push_obj(struct bpf_object *obj, const char *map_name, const char *endpoint);
    int spnl_otlp_l7_span_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_l7_span_push_obj(_spnl_skel->obj, "#{_l7_map}", endpoint);
    }
    /* HTTP RED spans: drains the http ringbuf into spans with method, path, status
       and duration; a status of 500 or above marks the span as an error. The
       kernel copies raw bytes; method/path/status are parsed in userspace. */
    extern int spnl_otlp_http_span_push_obj(struct bpf_object *obj, const char *map_name, const char *endpoint);
    int spnl_otlp_http_span_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_http_span_push_obj(_spnl_skel->obj, "#{_http_map}", endpoint);
    }
    /* Redis RED spans: drains the redis ringbuf into db.* spans with command,
       error and duration; a RESP -ERR reply marks the span as an error. The RESP
       parsing happens in userspace. */
    extern int spnl_otlp_redis_span_push_obj(struct bpf_object *obj, const char *map_name, const char *endpoint);
    int spnl_otlp_redis_span_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_redis_span_push_obj(_spnl_skel->obj, "#{_redis_map}", endpoint);
    }
    /* Off-CPU spans: drains the offcpu ringbuf and adds spnl.offcpu_ns,
       spnl.oncpu_ns and spnl.wait.kind (classified from the captured kernel
       stacks) on top of method, path, status and duration -- so a slow span
       says what it was waiting on. */
    extern int spnl_otlp_offcpu_span_push_obj(struct bpf_object *obj, const char *map_name, const char *stacks_map, const char *endpoint);
    int spnl_otlp_offcpu_span_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_offcpu_span_push_obj(_spnl_skel->obj, "#{_offcpu_map}", "#{lc::MAP_STACKS}", endpoint);
    }
    /* Multi-source request tree: correlates the off-CPU request window (the parent)
       with DNS and connection records (the children) by thread group id and time
       window, producing a parent/child span tree. A unit without a dns or conn
       map simply contributes no children from that source. */
    extern int spnl_otlp_request_tree_push_obj(struct bpf_object *obj, const char *offcpu_map, const char *dns_map, const char *conn_map, const char *stacks_map, const char *endpoint);
    int spnl_otlp_request_tree_push(const char *endpoint)
    {
        if (!_spnl_skel || !endpoint) return -1;
        return spnl_otlp_request_tree_push_obj(_spnl_skel->obj, "#{_offcpu_map}", "#{_dns_map}", "#{_conn_map}", "#{lc::MAP_STACKS}", endpoint);
    }
    /* Cross-layer correlation: looks up L3/L4 metrics for an accepted client fd by
       deriving the same 4-tuple key the tracepoint used, so userspace can join what
       the kernel counted onto an application-level span. A miss returns -1.
       metric_id: 1 = state changes (all transitions), 2 = established only. */
    extern long spnl_otlp_xlayer_l34_count_obj(struct bpf_object *obj, const char *map_name,
                                               int fd, unsigned long long metric_id);
    int spnl_otlp_xlayer_state_changes(int fd)
    {
        if (!_spnl_skel) return -1;
        return (int)spnl_otlp_xlayer_l34_count_obj(_spnl_skel->obj, "#{_hist_map}", fd, 1);
    }
    int spnl_otlp_xlayer_established(int fd)
    {
        if (!_spnl_skel) return -1;
        return (int)spnl_otlp_xlayer_l34_count_obj(_spnl_skel->obj, "#{_hist_map}", fd, 2);
    }
  SHIM

  # `param` and `filter_by`: the two runtime knobs.
  # Both are `volatile const` in .rodata that the codegen emitted; `bpftool gen
  # skeleton` exposes each as a field of `skel->rodata`, so the loader needs no
  # ELF symtab walk (which is what cilium/ebpf has to do, having no skeleton) --
  # a plain struct assignment between __open() and __load() is the whole
  # mechanism. They share one block because they share one failure mode.
  #
  # Three things are emitted, and the third is the one that matters in practice:
  #
  #   * a per-knob assignment, executed only when its env var is set, so the
  #     compiled-in default is what a bare run gets;
  #   * for SPNL_FILTER_COMM, a bounded copy into the 16-byte .rodata array (and
  #     a refusal above 15 characters, which could never match a task comm);
  #   * a sweep of the environment for SPNL_PARAM_* / SPNL_FILTER_* names this
  #     program does not have. A mistyped switch is otherwise the perfect silent
  #     failure: the operator sets it, the probe ignores it, and the output looks
  #     like the filter simply matched nothing. A wrong instruction is refused,
  #     not averaged. The sweep is emitted UNCONDITIONALLY -- a probe that
  #     declares nothing is exactly the probe where a stray SPNL_FILTER_PID is
  #     most misleading, so "(none)" is an answer worth printing.
  #
  # `keep_if` adds a third kind to the same table and the same sweep. Its value
  # is read by the generated RUBY consumer (`ENV[...]`), not by the loader --
  # .rodata would be the wrong home for it, since the filter runs after the
  # record has already crossed into userspace. What the loader still owns is the
  # part Ruby cannot do safely: (a) the sweep, so a mistyped SPNL_KEEP_* is
  # refused instead of being a filter that never fires, and (b) parsing an
  # integer predicate's value strictly, because `"12x".to_i` is 12 in Ruby and a
  # typo that takes effect is worse than one that is refused. C validates, Ruby
  # applies.
  knob_decls =
    params.map { |p| ["param #{p.name}", p.env_name] } +
    filter_keys.map { |k| ["filter #{k.name}", k.env_name] } +
    keep_filters.map { |k| ["keep #{k[:channel]}.#{k[:prop]} (#{k[:op]})", k[:env]] }
  knob_table =
    if knob_decls.empty?
      "static const struct spnl_knob_decl _spnl_knob_decls[1] = { { 0, 0 } };\n" \
      "static const int _spnl_knob_ndecls = 0;"
    else
      rows = knob_decls.map { |n, e| "    { #{n.inspect}, #{e.inspect} }," }.join("\n")
      "static const struct spnl_knob_decl _spnl_knob_decls[] = {\n#{rows}\n};\n" \
      "static const int _spnl_knob_ndecls = #{knob_decls.length};"
    end

  int_assigns =
    params.map { |p|
      "    if (_spnl_knob_env_i64(#{p.env_name.inspect}, &_v))\n" \
      "        _spnl_skel->rodata->#{p.c_symbol} = (__s64)_v;"
    } + filter_keys.reject(&:string?).map { |k|
      "    if (_spnl_knob_env_i64(#{k.env_name.inspect}, &_v))\n" \
      "        _spnl_skel->rodata->#{k.c_symbol} = (__s64)_v;"
    }
  str_assigns = filter_keys.select(&:string?).map { |k|
    "    _spnl_knob_env_comm(#{k.env_name.inspect}, (char *)_spnl_skel->rodata->#{k.c_symbol}, " \
    "sizeof(_spnl_skel->rodata->#{k.c_symbol}));"
  }
  # Validate only -- the value is consumed in Ruby. An int predicate is
  # parsed here and thrown away so that a malformed one fails at startup rather
  # than silently becoming a filter on some other number.
  keep_checks = keep_filters.map { |k|
    k[:expose] == "int" ?
      "    (void)_spnl_knob_env_i64(#{k[:env].inspect}, &_v);" :
      "    _spnl_keep_env_str(#{k[:env].inspect});"
  }
  assigns = (int_assigns + str_assigns + keep_checks).join("\n")
  assigns = "    (void)_v;" if assigns.empty?

  knobs_glue = <<~KNOBS
    /* --- runtime knobs: `param` and `filter_by` ---------------------------- */
    struct spnl_knob_decl { const char *name; const char *env; };
    #{knob_table}

    /* strtoll with the whole string required to parse. A partially-parsed
     * value ("12x" -> 12) is a typo that would take effect, which is worse
     * than one that is refused. Base 0 so 0x/0 prefixes work. */
    __attribute__((unused))
    static int _spnl_knob_env_i64(const char *var, long long *out)
    {
        const char *v = getenv(var);
        if (!v) return 0;
        while (*v == ' ' || *v == '\\t') v++;
        if (!*v) {
            fprintf(stderr, "[spinel-ebpf] %s is set but empty -- unset it to use the "
                            "compiled-in default\\n", var);
            exit(1);
        }
        errno = 0;
        char *end = NULL;
        long long n = strtoll(v, &end, 0);
        while (end && (*end == ' ' || *end == '\\t')) end++;
        if (!end || *end || errno == ERANGE) {
            fprintf(stderr, "[spinel-ebpf] %s=%s is not an integer "
                            "(64-bit signed, decimal or 0x-hex)\\n", var, v);
            exit(1);
        }
        *out = n;
        return 1;
    }

    /* SPNL_FILTER_COMM -> the 16-byte .rodata array the kernel compares
     * against bpf_get_current_comm(). A task comm is at most 15 characters plus
     * the NUL the kernel writes, so a longer value can never match anything:
     * refusing it is the difference between "no such process" and "the filter
     * was silently truncated to something else". */
    __attribute__((unused))
    static void _spnl_knob_env_comm(const char *var, char *dst, size_t cap)
    {
        const char *v = getenv(var);
        if (!v) return;
        size_t n = strlen(v);
        if (n == 0) {
            fprintf(stderr, "[spinel-ebpf] %s is set but empty -- unset it to match every "
                            "process\\n", var);
            exit(1);
        }
        if (n >= cap) {
            fprintf(stderr, "[spinel-ebpf] %s=%s is %zu characters; a task comm is at most "
                            "%zu, so this could never match\\n", var, v, n, cap - 1);
            exit(1);
        }
        memcpy(dst, v, n);
    }

    /* A `keep_if` predicate's value. Empty means "does not constrain" to the
     * generated Ruby, so an explicitly empty setting is an instruction that
     * would do nothing -- refuse it here rather than let it read as unset. */
    __attribute__((unused))
    static void _spnl_keep_env_str(const char *var)
    {
        const char *v = getenv(var);
        if (!v) return;
        if (!*v) {
            fprintf(stderr, "[spinel-ebpf] %s is set but empty -- unset it to keep every "
                            "record\\n", var);
            exit(1);
        }
    }

    /* A SPNL_PARAM_* / SPNL_FILTER_* / SPNL_KEEP_* variable this program does not
     * have cannot do anything. Saying so is the difference between "the filter
     * matched nothing" and "you spelled the filter wrong", which look identical
     * in the output. */
    extern char **environ;
    static void _spnl_knob_reject_unknown(void)
    {
        for (char **e = environ; e && *e; e++) {
            if (strncmp(*e, "SPNL_PARAM_", 11) != 0 &&
                strncmp(*e, "SPNL_FILTER_", 12) != 0 &&
                strncmp(*e, "SPNL_KEEP_", 10) != 0) continue;
            const char *eq = strchr(*e, '=');
            if (!eq) continue;
            size_t nlen = (size_t)(eq - *e);
            int known = 0;
            for (int i = 0; i < _spnl_knob_ndecls; i++)
                if (strlen(_spnl_knob_decls[i].env) == nlen &&
                    strncmp(_spnl_knob_decls[i].env, *e, nlen) == 0) { known = 1; break; }
            if (known) continue;
            fprintf(stderr, "[spinel-ebpf] %.*s is not a parameter of this program. "
                            "Declared:", (int)nlen, *e);
            for (int i = 0; i < _spnl_knob_ndecls; i++)
                fprintf(stderr, " %s", _spnl_knob_decls[i].env);
            fprintf(stderr, "%s\\n", _spnl_knob_ndecls ? "" : " (none)");
            exit(1);
        }
    }

    /* Between __open() and __load(): after this the kernel BPF_MAP_FREEZEs the
     * read-only map, which is what lets the verifier treat these as constants
     * and drop the branches that test them. Assigning after __load() would be
     * both refused and pointless. */
    static void _spnl_knobs_apply(void)
    {
        long long _v = 0;
        _spnl_knob_reject_unknown();
    #{assigns}
        for (int i = 0; i < _spnl_knob_ndecls; i++)
            if (getenv(_spnl_knob_decls[i].env))
                fprintf(stderr, "[spinel-ebpf] %s = %s (%s)\\n",
                        _spnl_knob_decls[i].name, getenv(_spnl_knob_decls[i].env),
                        _spnl_knob_decls[i].env);
    }
  KNOBS
  knobs_glue = knobs_glue.gsub(/^(?=.)/, "    ").chomp   # sit at the glue's top-level indent
  params_glue = knobs_glue
  params_apply_call = "\n        _spnl_knobs_apply();"

  # emit a const array of reactor uprobe/USDT targets. _spnl_uprobe_attach_all
  # and _spnl_usdt_attach_all consult it (by program name) and fall back to env
  # vars when the prog name isn't in the table (legacy flat-form attach).
  uprobe_table = reactor_uprobes.map do |t|
    "    { \"#{t[:prog_name]}\", \"#{t[:binary]}\", \"#{t[:func]}\", #{t[:retprobe]}, #{t[:pid] || -1}, #{t[:go_ret] || 0} },"
  end.join("\n")
  uprobe_table_decl =
    if reactor_uprobes.empty?
      "static const struct spnl_reactor_uprobe _spnl_reactor_uprobes[1] = {};\n" \
      "static const int _spnl_reactor_uprobes_count = 0;"
    else
      "static const struct spnl_reactor_uprobe _spnl_reactor_uprobes[] = {\n" \
      "#{uprobe_table}\n" \
      "};\n" \
      "static const int _spnl_reactor_uprobes_count = #{reactor_uprobes.length};"
    end

  usdt_table = reactor_usdts.map do |t|
    "    { \"#{t[:prog_name]}\", \"#{t[:binary]}\", \"#{t[:provider]}\", \"#{t[:probe]}\", #{t[:pid] || -1} },"
  end.join("\n")
  usdt_table_decl =
    if reactor_usdts.empty?
      "static const struct spnl_reactor_usdt _spnl_reactor_usdts[1] = {};\n" \
      "static const int _spnl_reactor_usdts_count = 0;"
    else
      "static const struct spnl_reactor_usdt _spnl_reactor_usdts[] = {\n" \
      "#{usdt_table}\n" \
      "};\n" \
      "static const int _spnl_reactor_usdts_count = #{reactor_usdts.length};"
    end

  # per-prog Hz table for reactor perf_event programs.
  pe_table = reactor_perf_events.map do |t|
    "    { \"#{t[:prog_name]}\", #{t[:hz]} },"
  end.join("\n")
  pe_table_decl =
    if reactor_perf_events.empty?
      "static const struct spnl_reactor_perf_event _spnl_reactor_perf_events[1] = {};\n" \
      "static const int _spnl_reactor_perf_events_count = 0;"
    else
      "static const struct spnl_reactor_perf_event _spnl_reactor_perf_events[] = {\n" \
      "#{pe_table}\n" \
      "};\n" \
      "static const int _spnl_reactor_perf_events_count = #{reactor_perf_events.length};"
    end

  # Per-prog symbol arrays plus the index table for kprobe_multi. Two levels,
  # unlike the flat uprobe/USDT rows, because each entry owns a variable-length
  # list of symbols. The COOKIE is the symbol's position in this array, which is
  # the same integer the codegen burned into the expanded wrappers -- that
  # identity is what makes `attached_index` mean one thing.
  kmulti_sym_arrays = kprobe_multis.each_with_index.map { |t, i|
    "static const char *_spnl_kmulti_syms#{i}[] = { " +
      t[:syms].map { |s| "\"#{s}\"" }.join(", ") + " };"
  }.join("\n    ")
  kmulti_table = kprobe_multis.each_with_index.map { |t, i|
    "    { \"#{t[:prog_name]}\", _spnl_kmulti_syms#{i}, #{t[:syms].length} },"
  }.join("\n")
  kmulti_table_decl =
    if kprobe_multis.empty?
      "static const struct spnl_kprobe_multi _spnl_kmultis[1] = {};\n" \
      "static const int _spnl_kmultis_count = 0;"
    else
      "#{kmulti_sym_arrays}\n" \
      "static const struct spnl_kprobe_multi _spnl_kmultis[] = {\n" \
      "#{kmulti_table}\n" \
      "};\n" \
      "static const int _spnl_kmultis_count = #{kprobe_multis.length};"
    end

  <<~GLUE
    /* SPDX-License-Identifier: GPL-2.0
     * GENERATED by spinel-ebpf. Auto-loads, attaches kprobe/
     * tracepoint programs via libbpf-skeleton, plus an explicit XDP attach
     * pass that reads $SPNL_XDP_IFACE for the target interface.
     */
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    #include <errno.h>
    #include <fcntl.h>          /* open() for cgroup attach */
    #include <unistd.h>         /* close() */
    #include <elf.h>            /* Go RET-offset scan (Elf64) */
    #include <sys/mman.h>       /* mmap the target ELF */
    #include <sys/stat.h>       /* fstat */
    #include <net/if.h>
    #include <sys/socket.h>     /* setsockopt for SO_ATTACH_REUSEPORT_EBPF */
    #include <sys/syscall.h>    /* __NR_perf_event_open */
    #include <linux/bpf.h>      /* BPF_CGROUP_SOCK_OPS attach type */
    #include <linux/perf_event.h>  /* struct perf_event_attr */
    #include <bpf/libbpf.h>
    #include <bpf/bpf.h>
    #include "spnl_runtime.h"   /* histogram dump FFI shims */
    #include "#{base}.skel.h"

    #{storage}struct #{skel_name} *_spnl_skel;
    /* The sole ringbuf being drained, or "" when several are merged into one
       poll (counts are then not attributable to a single channel). */
    static const char *_spnl_last_chan = "";

    /* XDP attach is link-based (bpf_program__attach_xdp) so that
     * (a) an interface that already has an XDP program is never silently
     *     replaced -- attach fails loud and the foreign program is untouched,
     * (b) the destructor detaches only our own programs, and
     * (c) the kernel drops the link when the process dies (SIGKILL-safe:
     *     no leftover prog on the iface -- one-shot, zero-trace hygiene). */
    #define SPNL_XDP_MAX_LINKS 8
    static struct bpf_link *_spnl_xdp_links[SPNL_XDP_MAX_LINKS];
    static int              _spnl_xdp_link_count = 0;

    /* uprobe / uretprobe / USDT links (bpf_link*). */
    #define SPNL_UPROBE_MAX 32
    static struct bpf_link *_spnl_uprobe_links[SPNL_UPROBE_MAX];
    static int              _spnl_uprobe_link_count = 0;

    /* kprobe_multi links -- one link covers the whole symbol list. */
    #define SPNL_KMULTI_MAX 16
    static struct bpf_link *_spnl_kmulti_links[SPNL_KMULTI_MAX];
    static int              _spnl_kmulti_link_count = 0;

    /* reactor-form target tables. Each entry maps a BPF program name
     * (synthesized by partition, e.g. "uprobe__react0") to the original
     * binary path / func / provider / probe carried in MethodInfo. The
     * attach passes look up by prog name and use the table entry when
     * present; otherwise they fall back to env-based legacy flat form. */
    struct spnl_reactor_uprobe {
        const char *prog_name;
        const char *binary;
        const char *func;
        int retprobe;
        int pid;          /* -1 = system-wide */
        int go_ret;       /* 1 = attach at every RET offset (Go return-probe) */
    };
    struct spnl_reactor_usdt {
        const char *prog_name;
        const char *binary;
        const char *provider;
        const char *probe;
        int pid;          /* -1 = system-wide */
    };
    /* reactor perf_event handler -- Hz frequency carried inline so
     * each handler can sample at its own rate. */
    struct spnl_reactor_perf_event {
        const char *prog_name;
        int hz;
    };
    /* A SEC("kprobe.multi") program plus the symbol list it is to be attached
     * to. libbpf deliberately does NOT auto-attach a bare "kprobe.multi" section
     * (only the "kprobe.multi/<glob>" form), which is what lets us attach it
     * here with an explicit symbol array AND a per-symbol cookie -- the glob
     * form cannot carry cookies, so it could not answer "which symbol fired". */
    struct spnl_kprobe_multi {
        const char *prog_name;
        const char **syms;   /* libbpf's opts field is `const char **` (it does not
                              * take ownership); the strings are literals. */
        int nsyms;
    };
    #{uprobe_table_decl}
    #{usdt_table_decl}
    #{pe_table_decl}
    #{kmulti_table_decl}

    static const struct spnl_reactor_uprobe *_spnl_lookup_reactor_uprobe(const char *name)
    {
        for (int i = 0; i < _spnl_reactor_uprobes_count; i++) {
            if (strcmp(_spnl_reactor_uprobes[i].prog_name, name) == 0)
                return &_spnl_reactor_uprobes[i];
        }
        return NULL;
    }
    static const struct spnl_reactor_usdt *_spnl_lookup_reactor_usdt(const char *name)
    {
        for (int i = 0; i < _spnl_reactor_usdts_count; i++) {
            if (strcmp(_spnl_reactor_usdts[i].prog_name, name) == 0)
                return &_spnl_reactor_usdts[i];
        }
        return NULL;
    }
    static const struct spnl_reactor_perf_event *_spnl_lookup_reactor_pe(const char *name)
    {
        for (int i = 0; i < _spnl_reactor_perf_events_count; i++) {
            if (strcmp(_spnl_reactor_perf_events[i].prog_name, name) == 0)
                return &_spnl_reactor_perf_events[i];
        }
        return NULL;
    }

    /* TCX attach links are kept here so the destructor can release them.
     * libbpf manages link lifecycle: bpf_link__destroy() detaches + frees. */
    #define SPNL_TCX_MAX_LINKS 8
    static struct bpf_link *_spnl_tcx_links[SPNL_TCX_MAX_LINKS];
    static int              _spnl_tcx_link_count = 0;

    /* SOCK_OPS attach state. cgroup attach uses bpf_prog_attach (no
     * bpf_link in the older API) -- so the destructor detaches via
     * bpf_prog_detach2. */
    #define SPNL_SOCKOPS_MAX 4
    static int _spnl_sockops_cgroup_fd = -1;
    static int _spnl_sockops_prog_fds[SPNL_SOCKOPS_MAX];
    static int _spnl_sockops_count = 0;

    static int _spnl_is_tcx_prog(struct bpf_program *prog)
    {
        if (bpf_program__type(prog) != BPF_PROG_TYPE_SCHED_CLS) return 0;
        /* Both tcx/ingress and tcx/egress use BPF_PROG_TYPE_SCHED_CLS;
         * the expected_attach_type distinguishes them but for our purposes
         * libbpf's bpf_program__attach_tcx() handles either based on SEC. */
        return 1;
    }

    /* `xdp_tail__*` programs are PROG_ARRAY sub-programs -- loaded but
     * never attached to an interface (the dispatcher tail-calls them). */
    static int _spnl_is_xdp_tail_prog(struct bpf_program *prog)
    {
        const char *name = bpf_program__name(prog);
        return name && strncmp(name, "#{lc::PREFIX_XDP_TAIL}", #{lc::PREFIX_XDP_TAIL_LEN}) == 0;
    }

    static void _spnl_xdp_attach_all(void)
    {
        const char *iface = getenv("SPNL_XDP_IFACE");
        struct bpf_program *prog;
        int xdp_count = 0;

        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            if (bpf_program__type(prog) == BPF_PROG_TYPE_XDP &&
                !_spnl_is_xdp_tail_prog(prog))
                xdp_count++;
        }
        if (xdp_count == 0)
            return;

        if (!iface || !*iface) {
            fprintf(stderr, "[spinel-ebpf] XDP program(s) loaded but $SPNL_XDP_IFACE is unset; "
                            "set it to attach (e.g. SPNL_XDP_IFACE=lo)\\n");
            return;
        }

        int ifindex = (int)if_nametoindex(iface);
        if (!ifindex) {
            fprintf(stderr, "[spinel-ebpf] if_nametoindex(%s): %s\\n", iface, strerror(errno));
            return;
        }
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            if (bpf_program__type(prog) != BPF_PROG_TYPE_XDP) continue;
            if (_spnl_is_xdp_tail_prog(prog)) continue;
            if (_spnl_xdp_link_count >= SPNL_XDP_MAX_LINKS) {
                fprintf(stderr, "[spinel-ebpf] too many XDP programs (>%d)\\n",
                        SPNL_XDP_MAX_LINKS);
                break;
            }
            struct bpf_link *link = bpf_program__attach_xdp(prog, ifindex);
            if (!link) {
                int err = errno;
                fprintf(stderr, "[spinel-ebpf] bpf_program__attach_xdp(%s, %s): %s\\n",
                        iface, bpf_program__name(prog), strerror(err));
                if (err == EBUSY || err == EEXIST)
                    fprintf(stderr, "[spinel-ebpf]   %s already has an XDP program "
                                    "(another tool's -- e.g. Cilium, libxdp, or a previous probe). "
                                    "Refusing to replace it; it was left untouched. "
                                    "Pick another interface or detach that program first.\\n",
                            iface);
                continue;
            }
            _spnl_xdp_links[_spnl_xdp_link_count++] = link;
            fprintf(stderr, "[spinel-ebpf] XDP attached (link): %s -> %s\\n",
                    bpf_program__name(prog), iface);
        }
    }

    static void _spnl_tcx_attach_all(void)
    {
        const char *iface = getenv("SPNL_TCX_IFACE");
        struct bpf_program *prog;
        int tcx_count = 0;

        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            if (_spnl_is_tcx_prog(prog)) tcx_count++;
        }
        if (tcx_count == 0)
            return;

        if (!iface || !*iface) {
            fprintf(stderr, "[spinel-ebpf] TCX program(s) loaded but $SPNL_TCX_IFACE is unset; "
                            "set it to attach (e.g. SPNL_TCX_IFACE=lo)\\n");
            return;
        }

        int ifindex = (int)if_nametoindex(iface);
        if (!ifindex) {
            fprintf(stderr, "[spinel-ebpf] if_nametoindex(%s): %s\\n", iface, strerror(errno));
            return;
        }

        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            if (!_spnl_is_tcx_prog(prog)) continue;
            if (_spnl_tcx_link_count >= SPNL_TCX_MAX_LINKS) {
                fprintf(stderr, "[spinel-ebpf] too many TCX programs (>%d)\\n",
                        SPNL_TCX_MAX_LINKS);
                break;
            }
            /* libbpf reads SEC name ("tcx/ingress" / "tcx/egress") and picks
             * the right hook automatically. opts=NULL means default options. */
            LIBBPF_OPTS(bpf_tcx_opts, tcx_opts);
            struct bpf_link *link = bpf_program__attach_tcx(prog, ifindex, &tcx_opts);
            if (!link) {
                fprintf(stderr, "[spinel-ebpf] bpf_program__attach_tcx(%s, %s): %s\\n",
                        iface, bpf_program__name(prog), strerror(errno));
                continue;
            }
            _spnl_tcx_links[_spnl_tcx_link_count++] = link;
            fprintf(stderr, "[spinel-ebpf] TCX attached: %s -> %s (%s)\\n",
                    bpf_program__name(prog), iface, bpf_program__section_name(prog));
        }
    }

    /* SOCK_OPS auto cgroup attach. SEC("sockops") programs require
     * cgroup-scoped attach via bpf_prog_attach(BPF_CGROUP_SOCK_OPS).
     * Reads $SPNL_CGROUP_PATH (default /sys/fs/cgroup). */
    static void _spnl_sockops_attach_all(void)
    {
        struct bpf_program *prog;
        int sockops_count = 0;
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            if (bpf_program__type(prog) == BPF_PROG_TYPE_SOCK_OPS)
                sockops_count++;
        }
        if (sockops_count == 0) return;

        const char *cg_path = getenv("SPNL_CGROUP_PATH");
        if (!cg_path || !*cg_path) cg_path = "/sys/fs/cgroup";

        int cg_fd = open(cg_path, O_RDONLY | O_DIRECTORY);
        if (cg_fd < 0) {
            fprintf(stderr, "[spinel-ebpf] sockops: open(%s): %s -- sockops programs not attached\\n",
                    cg_path, strerror(errno));
            return;
        }
        _spnl_sockops_cgroup_fd = cg_fd;

        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            if (bpf_program__type(prog) != BPF_PROG_TYPE_SOCK_OPS) continue;
            if (_spnl_sockops_count >= SPNL_SOCKOPS_MAX) {
                fprintf(stderr, "[spinel-ebpf] too many sockops programs (>%d)\\n",
                        SPNL_SOCKOPS_MAX);
                break;
            }
            int fd = bpf_program__fd(prog);
            int err = bpf_prog_attach(fd, cg_fd, BPF_CGROUP_SOCK_OPS, BPF_F_ALLOW_MULTI);
            if (err) {
                fprintf(stderr, "[spinel-ebpf] bpf_prog_attach(sockops %s -> %s): %s\\n",
                        bpf_program__name(prog), cg_path, strerror(-err));
                continue;
            }
            _spnl_sockops_prog_fds[_spnl_sockops_count++] = fd;
            fprintf(stderr, "[spinel-ebpf] sockops attached: %s -> cgroup %s\\n",
                    bpf_program__name(prog), cg_path);
        }
    }

    /* PROG_ARRAY auto-populate. Looks up `spnl_prog_array` (emitted
     * by codegen when `def xdp_tail__<name>` is used) and writes each
     * xdp_tail__* prog's fd into a slot. Slots are assigned in
     * bpf_object__for_each_program iteration order, which matches the
     * source/declaration order (libbpf preserves ELF section order). */
    static void _spnl_prog_array_populate(void)
    {
        struct bpf_map *map = bpf_object__find_map_by_name(_spnl_skel->obj, "#{lc::MAP_PROG_ARRAY}");
        if (!map) return;
        int map_fd = bpf_map__fd(map);
        if (map_fd < 0) return;

        __u32 slot = #{lc::PROG_ARRAY_SLOT_BASE};
        struct bpf_program *prog;
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            const char *name = bpf_program__name(prog);
            if (!name || strncmp(name, "#{lc::PREFIX_XDP_TAIL}", #{lc::PREFIX_XDP_TAIL_LEN}) != 0) continue;
            int prog_fd = bpf_program__fd(prog);
            int err = bpf_map_update_elem(map_fd, &slot, &prog_fd, BPF_ANY);
            if (err) {
                fprintf(stderr, "[spinel-ebpf] prog_array[%u] = %s: %s\\n",
                        slot, name, strerror(-err));
            } else {
                fprintf(stderr, "[spinel-ebpf] prog_array[%u] = %s\\n", slot, name);
            }
            slot++;
        }
    }

    /* parse `<pid_int>` from env, return -1 if unset/invalid. -1 means
     * "all processes" to libbpf's uprobe/USDT attach. */
    static int _spnl_env_pid(const char *var)
    {
        const char *v = getenv(var);
        if (!v || !*v) return -1;
        char *end = NULL;
        long p = strtol(v, &end, 10);
        if (end == v || (p < 0)) return -1;
        return (int)p;
    }

    /* uprobe / uretprobe auto attach.
     * Reactor form: prog name matches _spnl_reactor_uprobes[].prog_name,
     *   use that entry's binary + func.
     * Flat form: fall back to $SPNL_UPROBE_BINARY + the prog name
     *   suffix as the function name.
     * pid for both: $SPNL_UPROBE_PID (default -1). */
    /* Go return-probe support. uretprobe corrupts Go's movable stack,
     * so we attach a plain uprobe at every RET instruction of the function. Scan
     * the target ELF: resolve `func` in .symtab/.dynsym -> {st_value, st_size},
     * map st_value (vaddr) to a file offset via PT_LOAD, read the function's bytes,
     * and collect the offsets (relative to func start) of the arm64 `ret` opcode
     * 0xd65f03c0 (4-byte fixed; arm64 only -- amd64 would need a length decoder).
     * Returns the RET count (fills offs[]), or -1 on error. */
    /* resolve a Go func's entry vaddr + size from `.gopclntab` (works when stripped
     * removed `.symtab`). Parses the pcHeader (Go 1.18=0xfffffff0 / 1.20+=0xfffffff1, ptrSize=8) +
     * walks the functab ([nfunc+1] of {uint32 entryoff, uint32 funcoff}); each _func at
     * pclntable[funcoff] has {entryOff uint32, nameOff int32}. Returns 1 on match. */
    static int _spnl_go_pcln_vaddr(void *base, long total, const char *func,
                                   unsigned long *vaddr, unsigned long *vsize)
    {
        Elf64_Ehdr *eh = (Elf64_Ehdr *)base;
        if ((long)(eh->e_shoff + (unsigned long)eh->e_shnum * sizeof(Elf64_Shdr)) > total) return 0;
        Elf64_Shdr *sh = (Elf64_Shdr *)((char *)base + eh->e_shoff);
        if (eh->e_shstrndx >= eh->e_shnum) return 0;
        const char *shstr = (const char *)base + sh[eh->e_shstrndx].sh_offset;
        const unsigned char *pcln = NULL; unsigned long pclnsz = 0, text_vaddr = 0;
        for (int s = 0; s < eh->e_shnum; s++) {
            const char *sn = shstr + sh[s].sh_name;
            if (strcmp(sn, ".gopclntab") == 0) { pcln = (const unsigned char *)base + sh[s].sh_offset; pclnsz = sh[s].sh_size; }
            else if (strcmp(sn, ".text") == 0) { text_vaddr = sh[s].sh_addr; }
        }
        if (!pcln || pclnsz < 72) return 0;
        unsigned int magic = pcln[0] | (pcln[1]<<8) | (pcln[2]<<16) | ((unsigned)pcln[3]<<24);
        if (magic != 0xfffffff1u && magic != 0xfffffff0u) return 0;   /* Go 1.20+ / 1.18-1.19 */
        if (pcln[7] != 8) return 0;   /* ptrSize: 64-bit only */
        #define _RD8(o) ((unsigned long)pcln[o] | ((unsigned long)pcln[(o)+1]<<8) | ((unsigned long)pcln[(o)+2]<<16) | \
                         ((unsigned long)pcln[(o)+3]<<24) | ((unsigned long)pcln[(o)+4]<<32) | ((unsigned long)pcln[(o)+5]<<40) | \
                         ((unsigned long)pcln[(o)+6]<<48) | ((unsigned long)pcln[(o)+7]<<56))
        #define _RD4(p) ((unsigned int)(p)[0] | ((unsigned int)(p)[1]<<8) | ((unsigned int)(p)[2]<<16) | ((unsigned int)(p)[3]<<24))
        unsigned long nfunc       = _RD8(8);
        unsigned long textStart   = _RD8(24);
        unsigned long funcnameOff = _RD8(32);
        unsigned long pclnOff     = _RD8(64);   /* functab */
        if (textStart == 0) textStart = text_vaddr;   /* pcHeader.textStart is 0 in some builds -> use .text vaddr (= runtime.text) */
        if (pclnOff + (nfunc + 1) * 8 > pclnsz || funcnameOff > pclnsz) return 0;
        const unsigned char *functab = pcln + pclnOff;
        const char *funcnametab = (const char *)pcln + funcnameOff;
        for (unsigned long i = 0; i < nfunc; i++) {
            unsigned int entryoff = _RD4(functab + i*8);
            unsigned int funcoff  = _RD4(functab + i*8 + 4);
            /* _func lives at pclntable[pclnOffset + funcoff] (funcoff is relative to the functab base). */
            if (pclnOff + funcoff + 8 > pclnsz) continue;
            int nameOff = (int)_RD4(pcln + pclnOff + funcoff + 4);   /* _func.nameOff (int32 at +4) */
            if (funcnameOff + (unsigned long)nameOff >= pclnsz) continue;
            if (strcmp(funcnametab + nameOff, func) == 0) {
                unsigned int nextoff = _RD4(functab + (i+1)*8);
                *vaddr = textStart + entryoff;
                *vsize = (nextoff > entryoff) ? (nextoff - entryoff) : 0;
                return *vsize ? 1 : 0;
            }
        }
        return 0;
        #undef _RD8
        #undef _RD4
    }

    /* x86-64 instruction-length decoder. amd64 `ret` is a single byte 0xc3 at a variable
     * position (naive scan false-positives on 0xc3 bytes inside operands), so we linearly decode
     * instructions to find RET at true boundaries. Verified against `go tool objdump` (199/200 Go
     * funcs; the 1 miss is an AVX512/EVEX asm func, never a uprobe target). Returns the instruction
     * length and its 1-byte opcode (0 for 2-byte 0x0F opcodes). arm64 uses the 4-byte scan instead. */
    static int _x86_has_modrm(unsigned char op) {
        /* arith block 0x00-0x3B: forms with low 3 bits 0-3 are r/m<->reg (ModRM);
         * 4,5 are AL/eAX,imm and 6,7 are seg push/pop (no ModRM here). */
        if (op <= 0x3B && (op & 7) <= 3) return 1;
        if (op==0x62||op==0x63||op==0x69||op==0x6B) return 1;
        if (op>=0x80 && op<=0x83) return 1;
        if (op>=0x84 && op<=0x8F) return 1;
        if (op==0xC0||op==0xC1||op==0xC6||op==0xC7) return 1;
        if (op>=0xD0 && op<=0xD3) return 1;
        if (op>=0xD8 && op<=0xDF) return 1;
        if (op==0xF6||op==0xF7||op==0xFE||op==0xFF) return 1;
        return 0;
    }
    static int _x86_imm1(unsigned char op, int opsz, int rexW) {
        if (op==0x04||op==0x0C||op==0x14||op==0x1C||op==0x24||op==0x2C||op==0x34||op==0x3C||
            op==0x6A||op==0xA8||op==0xCD||op==0xEB||op==0x80||op==0x83||op==0x6B||op==0xC0||op==0xC1||op==0xC6) return 1;
        if (op>=0x70 && op<=0x7F) return 1;
        if (op>=0xB0 && op<=0xB7) return 1;
        if (op>=0xE0 && op<=0xE3) return 1;
        if (op==0x05||op==0x0D||op==0x15||op==0x1D||op==0x25||op==0x2D||op==0x35||op==0x3D||
            op==0x68||op==0xA9||op==0xE8||op==0xE9||op==0x69||op==0x81||op==0xC7) return opsz ? 2 : 4;
        if (op==0xC2||op==0xCA) return 2;
        if (op>=0xB8 && op<=0xBF) return rexW ? 8 : (opsz ? 2 : 4);
        return 0;
    }
    static unsigned long _spnl_x86_ilen(const unsigned char *code, unsigned long n, unsigned long pos, unsigned char *op_out) {
        unsigned long p = pos; int opsz = 0;
        while (p < n) { unsigned char b = code[p];
            if (b==0xF0||b==0xF2||b==0xF3||b==0x2E||b==0x36||b==0x3E||b==0x26||b==0x64||b==0x65||b==0x66||b==0x67) { if (b==0x66) opsz=1; p++; } else break; }
        if (p >= n) { *op_out=0; return n - pos; }
        int rexW = 0;
        if (code[p] >= 0x40 && code[p] <= 0x4F) { rexW = (code[p] & 8) != 0; p++; }
        if (p >= n) { *op_out=0; return n - pos; }
        unsigned char op = code[p++]; int modrm = 0, imm = 0;
        if (op == 0x0F) {
            if (p >= n) { *op_out=0; return n - pos; }
            unsigned char op2 = code[p++];
            if (op2==0x38 || op2==0x3A) { p++; modrm=1; if (op2==0x3A) imm=1; }
            else if (op2>=0x80 && op2<=0x8F) imm=4;
            else if (op2==0xA4||op2==0xAC||op2==0xBA||op2==0x70||op2==0x71||op2==0x72||op2==0x73||op2==0xC2||op2==0xC4||op2==0xC5||op2==0xC6) { modrm=1; imm=1; }
            else modrm=1;
            op = 0;   /* 2-byte opcode is not a 1-byte RET */
        } else {
            modrm = _x86_has_modrm(op);
            imm   = _x86_imm1(op, opsz, rexW);
        }
        if (modrm) {
            if (p >= n) { *op_out=op; return n - pos; }
            unsigned char mrm = code[p++]; int mod = mrm>>6, rm = mrm&7, disp = 0;
            if (mod != 3 && rm == 4) { if (p < n) { unsigned char sib = code[p++]; if (mod==0 && (sib&7)==5) disp=4; } }
            if (mod==1) disp=1; else if (mod==2) disp=4; else if (mod==0 && rm==5) disp=4;
            p += disp;
            if (op==0xF6) imm = (((mrm>>3)&7) < 2) ? 1 : 0;
            else if (op==0xF7) imm = (((mrm>>3)&7) < 2) ? (opsz ? 2 : 4) : 0;
        }
        p += imm;
        *op_out = op;
        return (p > pos) ? (p - pos) : 1;
    }

    static int _spnl_go_ret_offsets(const char *binary, const char *func,
                                    unsigned long *offs, int max)
    {
        int fd = open(binary, O_RDONLY);
        if (fd < 0) return -1;
        struct stat st;
        if (fstat(fd, &st) != 0 || st.st_size < (long)sizeof(Elf64_Ehdr)) { close(fd); return -1; }
        void *base = mmap(NULL, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
        close(fd);
        if (base == MAP_FAILED) return -1;
        Elf64_Ehdr *eh = (Elf64_Ehdr *)base;
        if (memcmp(eh->e_ident, ELFMAG, SELFMAG) != 0) { munmap(base, st.st_size); return -1; }
        Elf64_Shdr *sh = (Elf64_Shdr *)((char *)base + eh->e_shoff);
        unsigned long fval = 0, fsize = 0; int found = 0;
        for (int s = 0; s < eh->e_shnum && !found; s++) {
            if (sh[s].sh_type != SHT_SYMTAB && sh[s].sh_type != SHT_DYNSYM) continue;
            Elf64_Sym *syms = (Elf64_Sym *)((char *)base + sh[s].sh_offset);
            long nsyms = sh[s].sh_size / sizeof(Elf64_Sym);
            const char *strs = (const char *)base + sh[sh[s].sh_link].sh_offset;
            for (long k = 0; k < nsyms; k++) {
                if (syms[k].st_name == 0 || syms[k].st_value == 0) continue;
                if (strcmp(strs + syms[k].st_name, func) == 0) {
                    fval = syms[k].st_value; fsize = syms[k].st_size; found = 1; break;
                }
            }
        }
        /* stripped binaries have no .symtab -> resolve via .gopclntab. */
        if (!found || fsize == 0)
            found = _spnl_go_pcln_vaddr(base, st.st_size, func, &fval, &fsize);
        if (!found || fsize == 0) { munmap(base, st.st_size); return -1; }
        Elf64_Phdr *ph = (Elf64_Phdr *)((char *)base + eh->e_phoff);
        unsigned long foff = 0; int mapped = 0;
        for (int p = 0; p < eh->e_phnum; p++) {
            if (ph[p].p_type != PT_LOAD) continue;
            if (fval >= ph[p].p_vaddr && fval < ph[p].p_vaddr + ph[p].p_filesz) {
                foff = fval - ph[p].p_vaddr + ph[p].p_offset; mapped = 1; break;
            }
        }
        if (!mapped || foff + fsize > (unsigned long)st.st_size) { munmap(base, st.st_size); return -1; }
        int n = 0;
        const unsigned char *code = (const unsigned char *)base + foff;
        if (eh->e_machine == 62 /* EM_X86_64 */) {
            /* amd64 `ret`=0xc3 is single-byte at a variable position -> length-decode to find
             * it at true instruction boundaries. Scan-verified vs go tool objdump. */
            for (unsigned long i = 0; i < fsize && n < max; ) {
                unsigned char op;
                unsigned long len = _spnl_x86_ilen(code, fsize, i, &op);
                if (op == 0xC3) offs[n++] = foff + i;   /* ABSOLUTE file offset of the RET */
                if (!len) break;
                i += len;
            }
        } else {   /* arm64 (EM_AARCH64): fixed 4-byte RET = 0xd65f03c0 */
            for (unsigned long i = 0; i + 4 <= fsize && n < max; i += 4) {
                unsigned int w = code[i] | (code[i+1]<<8) | (code[i+2]<<16) | ((unsigned)code[i+3]<<24);
                if (w == 0xd65f03c0u) offs[n++] = foff + i;   /* ABSOLUTE file offset (works stripped) */
            }
        }
        munmap(base, st.st_size);
        return n;
    }

    /* resolve a func's ENTRY file offset via .symtab/.dynsym, else .gopclntab. Used as a
     * fallback when libbpf's func_name attach fails (stripped Go). Returns the file offset, or 0. */
    static unsigned long _spnl_go_func_fileoff(const char *binary, const char *func)
    {
        int fd = open(binary, O_RDONLY);
        if (fd < 0) return 0;
        struct stat st;
        if (fstat(fd, &st) != 0 || st.st_size < (long)sizeof(Elf64_Ehdr)) { close(fd); return 0; }
        void *base = mmap(NULL, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
        close(fd);
        if (base == MAP_FAILED) return 0;
        Elf64_Ehdr *eh = (Elf64_Ehdr *)base;
        unsigned long fval = 0, fsize = 0, foff = 0; int found = 0;
        if (memcmp(eh->e_ident, ELFMAG, SELFMAG) == 0) {
            Elf64_Shdr *sh = (Elf64_Shdr *)((char *)base + eh->e_shoff);
            for (int s = 0; s < eh->e_shnum && !found; s++) {
                if (sh[s].sh_type != SHT_SYMTAB && sh[s].sh_type != SHT_DYNSYM) continue;
                Elf64_Sym *syms = (Elf64_Sym *)((char *)base + sh[s].sh_offset);
                long nsyms = sh[s].sh_size / sizeof(Elf64_Sym);
                const char *strs = (const char *)base + sh[sh[s].sh_link].sh_offset;
                for (long k = 0; k < nsyms; k++)
                    if (syms[k].st_name && syms[k].st_value && strcmp(strs + syms[k].st_name, func) == 0) {
                        fval = syms[k].st_value; fsize = syms[k].st_size; found = 1; break;
                    }
            }
            if (!found) found = _spnl_go_pcln_vaddr(base, st.st_size, func, &fval, &fsize);
            if (found) {
                Elf64_Phdr *ph = (Elf64_Phdr *)((char *)base + eh->e_phoff);
                for (int p = 0; p < eh->e_phnum; p++)
                    if (ph[p].p_type == PT_LOAD && fval >= ph[p].p_vaddr && fval < ph[p].p_vaddr + ph[p].p_filesz) {
                        foff = fval - ph[p].p_vaddr + ph[p].p_offset; break;
                    }
            }
        }
        munmap(base, st.st_size);
        return foff;
    }

    static void _spnl_uprobe_attach_all(void)
    {
        struct bpf_program *prog;
        int uprobe_count = 0;
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            const char *sec = bpf_program__section_name(prog);
            if (sec && (strcmp(sec, "#{lc::SEC_UPROBE}") == 0 || strcmp(sec, "#{lc::SEC_URETPROBE}") == 0))
                uprobe_count++;
        }
        if (uprobe_count == 0) return;

        const char *env_binary = getenv("SPNL_UPROBE_BINARY");
        int env_pid = _spnl_env_pid("SPNL_UPROBE_PID");

        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            const char *sec  = bpf_program__section_name(prog);
            const char *name = bpf_program__name(prog);
            if (!sec || !name) continue;
            int retprobe;
            int pid;
            const char *binary;
            const char *func;
            const struct spnl_reactor_uprobe *rt = _spnl_lookup_reactor_uprobe(name);
            if (rt) {
                binary   = rt->binary;
                func     = rt->func;
                retprobe = rt->retprobe;
                /* per-handler pid wins; if unset, fall back to env. */
                pid      = (rt->pid >= 0) ? rt->pid : env_pid;
            } else if (strcmp(sec, "#{lc::SEC_UPROBE}") == 0 && strncmp(name, "#{lc::PREFIX_UPROBE}", #{lc::PREFIX_UPROBE_LEN}) == 0) {
                retprobe = 0;
                func     = name + 8;
                if (!env_binary || !*env_binary) {
                    /* no target binary -> self-attach. The sp_<name> symbol
                     * lives in *this* binary; attach to /proc/self/exe scoped to
                     * our own pid (the workload runs in this process). */
                    binary = "/proc/self/exe";
                    pid    = (int)getpid();
                } else {
                    binary = env_binary;
                    pid    = env_pid;
                }
            } else if (strcmp(sec, "#{lc::SEC_URETPROBE}") == 0 && strncmp(name, "#{lc::PREFIX_URETPROBE}", #{lc::PREFIX_URETPROBE_LEN}) == 0) {
                retprobe = 1;
                func     = name + 11;
                if (!env_binary || !*env_binary) {
                    binary = "/proc/self/exe";
                    pid    = (int)getpid();
                } else {
                    binary = env_binary;
                    pid    = env_pid;
                }
            } else {
                continue;
            }
            /* Go return-probe -- attach one uprobe per RET offset of func
             * (uretprobe is unusable on Go). func_name resolves the function start;
             * func_offset = each RET's offset within it. */
            if (rt && rt->go_ret) {
                unsigned long ret_offs[64];
                int nr = _spnl_go_ret_offsets(binary, func, ret_offs, 64);
                if (nr <= 0) {
                    fprintf(stderr, "[spinel-ebpf] go_uret: no RET offsets for %s:%s (nr=%d)\\n",
                            binary, func, nr);
                    continue;
                }
                int attached = 0;
                for (int r = 0; r < nr && _spnl_uprobe_link_count < SPNL_UPROBE_MAX; r++) {
                    /* ret_offs[r] is an ABSOLUTE file offset (resolved via .symtab or .gopclntab),
                     * so attach with func_name=NULL -- works on stripped binaries too. */
                    LIBBPF_OPTS(bpf_uprobe_opts, gopts, .retprobe = 0);
                    struct bpf_link *glink = bpf_program__attach_uprobe_opts(
                        prog, pid, binary, ret_offs[r], &gopts);
                    if (glink) { _spnl_uprobe_links[_spnl_uprobe_link_count++] = glink; attached++; }
                }
                fprintf(stderr, "[spinel-ebpf] go_uret attached: %s -> %s:%s at %d/%d RET offsets (pid=%d)\\n",
                        name, binary, func, attached, nr, pid);
                continue;
            }
            if (_spnl_uprobe_link_count >= SPNL_UPROBE_MAX) {
                fprintf(stderr, "[spinel-ebpf] too many uprobe programs (>%d)\\n", SPNL_UPROBE_MAX);
                break;
            }
            LIBBPF_OPTS(bpf_uprobe_opts, opts,
                        .retprobe   = retprobe,
                        .func_name  = func);
            struct bpf_link *link = bpf_program__attach_uprobe_opts(
                prog, pid, binary, 0 /* func_offset resolved by func_name */, &opts);
            if (!link) {
                /* func_name resolution fails on stripped Go (no .symtab). Fall back to the
                 * .gopclntab-resolved absolute file offset (func_name=NULL). */
                unsigned long gfoff = _spnl_go_func_fileoff(binary, func);
                if (gfoff) {
                    LIBBPF_OPTS(bpf_uprobe_opts, gopts2, .retprobe = retprobe);
                    link = bpf_program__attach_uprobe_opts(prog, pid, binary, gfoff, &gopts2);
                }
            }
            if (!link) {
                fprintf(stderr, "[spinel-ebpf] bpf_program__attach_uprobe(%s, %s:%s, pid=%d): %s\\n",
                        retprobe ? "retprobe" : "probe", binary, func, pid, strerror(errno));
                continue;
            }
            _spnl_uprobe_links[_spnl_uprobe_link_count++] = link;
            fprintf(stderr, "[spinel-ebpf] uprobe attached: %s -> %s:%s (pid=%d)\\n",
                    name, binary, func, pid);
        }
    }

    /* USDT auto attach.
     * Reactor form: prog name matches _spnl_reactor_usdts[].prog_name,
     *   use that entry's binary + provider + probe.
     * Flat form: parse provider/probe from prog name (`usdt__<P>__<N>`)
     *   + binary from $SPNL_USDT_BINARY. */
    /* Attach every SEC("kprobe.multi") program to its declared symbol list,
     * cookie[i] = i, so bpf_get_attach_cookie() in the program hands the body
     * the SAME index the expanded lowering would have burned in as a literal.
     * One link for the whole list, whatever its length -- that is the entire
     * reason this mechanism exists.
     *
     * Failure is loud and per-handler: kprobe_multi refuses the WHOLE
     * link if any one symbol is unresolvable, so a typo'd or config-dependent
     * name silently costs every symbol in the set, not just its own. Saying which
     * set failed is the difference between a fixable message and a probe that
     * quietly measures nothing. */
    static void _spnl_kmulti_attach_all(void)
    {
        if (_spnl_kmultis_count == 0) return;
        struct bpf_program *prog;
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            const char *name = bpf_program__name(prog);
            const char *sec  = bpf_program__section_name(prog);
            if (!name || !sec || strcmp(sec, "#{lc::SEC_KPROBE_MULTI}") != 0) continue;
            const struct spnl_kprobe_multi *e = NULL;
            for (int i = 0; i < _spnl_kmultis_count; i++)
                if (strcmp(_spnl_kmultis[i].prog_name, name) == 0) { e = &_spnl_kmultis[i]; break; }
            if (!e) continue;
            if (_spnl_kmulti_link_count >= SPNL_KMULTI_MAX) {
                fprintf(stderr, "[spinel-ebpf] too many kprobe.multi programs (>%d)\\n", SPNL_KMULTI_MAX);
                break;
            }
            __u64 *cookies = calloc((size_t)e->nsyms, sizeof(__u64));
            if (!cookies) continue;
            for (int i = 0; i < e->nsyms; i++) cookies[i] = (__u64)i;
            LIBBPF_OPTS(bpf_kprobe_multi_opts, kopts,
                        .syms = e->syms, .cookies = cookies, .cnt = (size_t)e->nsyms);
            struct bpf_link *link = bpf_program__attach_kprobe_multi_opts(prog, NULL, &kopts);
            if (!link) {
                fprintf(stderr,
                        "[spinel-ebpf] kprobe.multi attach failed for %s (%d symbols): %s\\n",
                        name, e->nsyms, strerror(errno));
                fprintf(stderr,
                        "[spinel-ebpf]   the link covers the whole list, so ONE unresolvable "
                        "symbol fails all of them.\\n"
                        "[spinel-ebpf]   check each against /sys/kernel/tracing/available_filter_functions; "
                        "kprobe.multi also needs kernel 5.18+.\\n");
                free(cookies);
                continue;
            }
            free(cookies);
            _spnl_kmulti_links[_spnl_kmulti_link_count++] = link;
            fprintf(stderr, "[spinel-ebpf] kprobe.multi attached: %s -> %d symbols (%s%s)\\n",
                    name, e->nsyms, e->syms[0], e->nsyms > 1 ? ", ..." : "");
        }
    }

    static void _spnl_usdt_attach_all(void)
    {
        struct bpf_program *prog;
        int usdt_count = 0;
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            const char *sec = bpf_program__section_name(prog);
            if (sec && strcmp(sec, "#{lc::SEC_USDT}") == 0)
                usdt_count++;
        }
        if (usdt_count == 0) return;

        const char *env_binary = getenv("SPNL_USDT_BINARY");
        int env_pid = _spnl_env_pid("SPNL_USDT_PID");

        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            const char *sec  = bpf_program__section_name(prog);
            const char *name = bpf_program__name(prog);
            if (!sec || !name) continue;
            if (strcmp(sec, "#{lc::SEC_USDT}") != 0) continue;
            if (strncmp(name, "#{lc::PREFIX_USDT}", #{lc::PREFIX_USDT_LEN}) != 0) continue;

            int pid;
            const char *binary;
            const char *provider;
            const char *probe;
            char provider_buf[64];
            const struct spnl_reactor_usdt *rt = _spnl_lookup_reactor_usdt(name);
            if (rt) {
                binary   = rt->binary;
                provider = rt->provider;
                probe    = rt->probe;
                /* per-handler pid wins; if unset, fall back to env. */
                pid      = (rt->pid >= 0) ? rt->pid : env_pid;
            } else {
                if (!env_binary || !*env_binary) {
                    fprintf(stderr, "[spinel-ebpf] %s loaded but $SPNL_USDT_BINARY is unset\\n", name);
                    continue;
                }
                const char *rest = name + 6;
                const char *sep  = strstr(rest, "#{lc::SEPARATOR_USDT}");
                if (!sep) {
                    fprintf(stderr, "[spinel-ebpf] malformed USDT prog name %s\\n", name);
                    continue;
                }
                size_t plen = (size_t)(sep - rest);
                if (plen == 0 || plen >= sizeof(provider_buf)) {
                    fprintf(stderr, "[spinel-ebpf] USDT provider too long in %s\\n", name);
                    continue;
                }
                memcpy(provider_buf, rest, plen);
                provider_buf[plen] = '\\0';
                binary   = env_binary;
                provider = provider_buf;
                probe    = sep + 2;
                pid      = env_pid;
            }

            if (_spnl_uprobe_link_count >= SPNL_UPROBE_MAX) {
                fprintf(stderr, "[spinel-ebpf] too many uprobe/USDT programs (>%d)\\n", SPNL_UPROBE_MAX);
                break;
            }
            struct bpf_link *link = bpf_program__attach_usdt(
                prog, pid, binary, provider, probe, NULL);
            if (!link) {
                fprintf(stderr, "[spinel-ebpf] bpf_program__attach_usdt(%s:%s:%s, pid=%d): %s\\n",
                        binary, provider, probe, pid, strerror(errno));
                continue;
            }
            _spnl_uprobe_links[_spnl_uprobe_link_count++] = link;
            fprintf(stderr, "[spinel-ebpf] usdt attached: %s -> %s:%s:%s (pid=%d)\\n",
                    name, binary, provider, probe, pid);
        }
    }

    /* per-CPU perf event fds + their bpf_link*. We open one event
     * per online CPU per perf_event BPF program and attach the program to
     * each. */
    #define SPNL_PERF_MAX_CPUS 64
    static struct {
        struct bpf_link *link;
        int               pfd;
    } _spnl_perf_links[SPNL_PERF_MAX_CPUS * 4];   /* up to 4 perf progs */
    static int _spnl_perf_link_count = 0;

    /* perf_event_open() wrapper -- kernel doesn't expose this as a libc
     * function, so call via syscall(). */
    static int _spnl_perf_event_open(struct perf_event_attr *attr,
                                     pid_t pid, int cpu, int group_fd,
                                     unsigned long flags)
    {
        return (int)syscall(__NR_perf_event_open, attr, pid, cpu, group_fd, flags);
    }

    /* attach SEC("perf_event") programs. Per-handler Hz comes from
     * the reactor table; flat-form (no table entry) falls back to
     * $SPNL_PERF_HZ (default 49 -- bcc convention, picked to avoid
     * alignment with 50/60 Hz tick rates). One perf event per online CPU. */
    static void _spnl_perf_event_attach_all(void)
    {
        struct bpf_program *prog;
        int pe_count = 0;
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            const char *sec = bpf_program__section_name(prog);
            if (sec && strcmp(sec, "#{lc::SEC_PERF_EVENT}") == 0)
                pe_count++;
        }
        if (pe_count == 0) return;

        int env_hz = 0;
        const char *env_hz_s = getenv("SPNL_PERF_HZ");
        if (env_hz_s && *env_hz_s) env_hz = atoi(env_hz_s);
        if (env_hz <= 0) env_hz = 49;

        int n_cpus = (int)sysconf(_SC_NPROCESSORS_ONLN);
        if (n_cpus <= 0) n_cpus = 1;
        if (n_cpus > SPNL_PERF_MAX_CPUS) n_cpus = SPNL_PERF_MAX_CPUS;

        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            const char *sec  = bpf_program__section_name(prog);
            const char *name = bpf_program__name(prog);
            if (!sec || !name || strcmp(sec, "#{lc::SEC_PERF_EVENT}") != 0) continue;

            int hz = env_hz;
            const struct spnl_reactor_perf_event *rt = _spnl_lookup_reactor_pe(name);
            if (rt && rt->hz > 0) hz = rt->hz;

            struct perf_event_attr attr;
            memset(&attr, 0, sizeof(attr));
            attr.type     = PERF_TYPE_SOFTWARE;
            attr.config   = PERF_COUNT_SW_CPU_CLOCK;
            attr.size     = sizeof(attr);
            attr.sample_period = 0;
            attr.sample_freq   = hz;
            attr.freq          = 1;
            attr.inherit       = 0;
            attr.disabled      = 0;

            int attached_cpus = 0;
            for (int cpu = 0; cpu < n_cpus; cpu++) {
                int pfd = _spnl_perf_event_open(&attr, -1, cpu, -1, 0);
                if (pfd < 0) {
                    /* Offline CPU is fine; skip silently. EACCES = no
                     * perf_event_paranoid permission. */
                    continue;
                }
                struct bpf_link *link = bpf_program__attach_perf_event(prog, pfd);
                if (!link) {
                    fprintf(stderr, "[spinel-ebpf] bpf_program__attach_perf_event(%s, cpu %d): %s\\n",
                            name, cpu, strerror(errno));
                    close(pfd);
                    continue;
                }
                if (_spnl_perf_link_count < (int)(sizeof(_spnl_perf_links)/sizeof(_spnl_perf_links[0]))) {
                    _spnl_perf_links[_spnl_perf_link_count].link = link;
                    _spnl_perf_links[_spnl_perf_link_count].pfd  = pfd;
                    _spnl_perf_link_count++;
                }
                attached_cpus++;
            }
            fprintf(stderr, "[spinel-ebpf] perf_event attached: %s @ %d Hz across %d CPU(s)\\n",
                    name, hz, attached_cpus);
        }
    }

    /* fire all `SEC("syscall") int spnl_timer_arm_*(void *ctx)` progs
     * once via bpf_prog_test_run so the in-kernel bpf_timer starts ticking.
     * Each arm prog initializes its timer slot and calls bpf_timer_start;
     * the callback re-arms itself for periodic behavior. */
    static void _spnl_timer_arm_all(void)
    {
        struct bpf_program *prog;
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            const char *name = bpf_program__name(prog);
            if (!name || strncmp(name, "#{lc::PREFIX_TIMER_ARM}", #{lc::PREFIX_TIMER_ARM_LEN}) != 0) continue;
            int prog_fd = bpf_program__fd(prog);
            if (prog_fd < 0) continue;
            LIBBPF_OPTS(bpf_test_run_opts, opts);
            int err = bpf_prog_test_run_opts(prog_fd, &opts);
            if (err) {
                fprintf(stderr, "[spinel-ebpf] timer arm %s: %s\\n",
                        name, strerror(-err));
            } else {
                fprintf(stderr, "[spinel-ebpf] timer armed: %s\\n", name);
            }
        }
    }

    /* cgroup_sock_addr (connect4/bind4) attach. cgroup-scoped;
     * bpf_program__attach_cgroup picks the attach type from the SEC. Links
     * auto-detach when this process exits. $SPNL_CGROUP_PATH (default
     * /sys/fs/cgroup). */
    #define SPNL_CGROUP_MAX 32
    static struct bpf_link *_spnl_cgroup_links[SPNL_CGROUP_MAX];
    static int _spnl_cgroup_count = 0;
    static void _spnl_cgroup_attach_all(void)
    {
        struct bpf_program *prog;
        int n = 0;
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            if (bpf_program__type(prog) == BPF_PROG_TYPE_CGROUP_SOCK_ADDR) n++;
        }
        if (n == 0) return;
        const char *cg_path = getenv("SPNL_CGROUP_PATH");
        if (!cg_path || !*cg_path) cg_path = "/sys/fs/cgroup";
        int cg_fd = open(cg_path, O_RDONLY | O_DIRECTORY);
        if (cg_fd < 0) {
            fprintf(stderr, "[spinel-ebpf] cgroup: open(%s): %s -- cgroup_sock_addr not attached\\n",
                    cg_path, strerror(errno));
            return;
        }
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            if (bpf_program__type(prog) != BPF_PROG_TYPE_CGROUP_SOCK_ADDR) continue;
            if (_spnl_cgroup_count >= SPNL_CGROUP_MAX) break;
            struct bpf_link *link = bpf_program__attach_cgroup(prog, cg_fd);
            if (!link) {
                fprintf(stderr, "[spinel-ebpf] attach_cgroup(%s) failed\\n", bpf_program__name(prog));
                continue;
            }
            _spnl_cgroup_links[_spnl_cgroup_count++] = link;
            fprintf(stderr, "[spinel-ebpf] cgroup attached: %s -> %s\\n",
                    bpf_program__name(prog), cg_path);
        }
        close(cg_fd);
    }

    /* BPF_ITER. iter programs aren't auto-attached; create an iterator
     * link and read it to drive one pass over all tasks (a snapshot at load
     * time). The program runs once per task; its body aggregates into maps. */
    static void _spnl_iter_run_all(void)
    {
        struct bpf_program *prog;
        bpf_object__for_each_program(prog, _spnl_skel->obj) {
            if (bpf_program__type(prog) != BPF_PROG_TYPE_TRACING) continue;
            if (bpf_program__expected_attach_type(prog) != BPF_TRACE_ITER) continue;
            struct bpf_link *link = bpf_program__attach_iter(prog, NULL);
            if (!link) {
                fprintf(stderr, "[spinel-ebpf] attach_iter(%s) failed\\n", bpf_program__name(prog));
                continue;
            }
            int it_fd = bpf_iter_create(bpf_link__fd(link));
            if (it_fd < 0) {
                fprintf(stderr, "[spinel-ebpf] bpf_iter_create(%s) failed\\n", bpf_program__name(prog));
                bpf_link__destroy(link);
                continue;
            }
            char buf[4096];
            while (read(it_fd, buf, sizeof(buf)) > 0) { /* drain: runs prog per task */ }
            close(it_fd);
            bpf_link__destroy(link);
            fprintf(stderr, "[spinel-ebpf] iter ran: %s\\n", bpf_program__name(prog));
        }
    }
    #{params_glue}
    __attribute__((constructor))
    static void _spnl_init(void)
    {
        /* optional custom BTF for cross-kernel CO-RE. When $SPNL_BTF_PATH
         * is set, open with btf_custom_path so CO-RE relocations resolve against a
         * supplied BTF even on a kernel that lacks /sys/kernel/btf/vmlinux. The
         * supplied BTF only needs the (layout-stable) types the program touches
         * (xdp_md / bpf_timer / net headers), so a recent kernel's BTF works as a
         * stand-in on an older BTF-less kernel. */
        const char *_spnl_btf_path = getenv("SPNL_BTF_PATH");
        /* Open and load are two steps, not __open_and_load(), because
         * .rodata is only writable in the gap between them -- after
         * __load() libbpf has BPF_MAP_FREEZEd it. Both branches go through the
         * same gap, so SPNL_BTF_PATH and `param` compose instead of one silently
         * disabling the other. */
        if (_spnl_btf_path && _spnl_btf_path[0]) {
            LIBBPF_OPTS(bpf_object_open_opts, _spnl_oo, .btf_custom_path = _spnl_btf_path);
            _spnl_skel = #{skel_name}__open_opts(&_spnl_oo);
        } else {
            _spnl_skel = #{skel_name}__open();
        }
        if (!_spnl_skel) {
            fprintf(stderr, "[spinel-ebpf] BPF open failed\\n");
            return;
        }#{params_apply_call}
        if (#{skel_name}__load(_spnl_skel)) {
            if (_spnl_btf_path && _spnl_btf_path[0])
                fprintf(stderr, "[spinel-ebpf] BPF load failed (custom BTF %s)\\n", _spnl_btf_path);
            else
                fprintf(stderr, "[spinel-ebpf] BPF open/load failed\\n");
            #{skel_name}__destroy(_spnl_skel);
            _spnl_skel = NULL;
            return;
        }
        if (_spnl_btf_path && _spnl_btf_path[0])
            fprintf(stderr, "[spinel-ebpf] BPF loaded with custom BTF %s\\n", _spnl_btf_path);
        if (#{skel_name}__attach(_spnl_skel)) {
            fprintf(stderr, "[spinel-ebpf] BPF attach failed (some attach points may be missing)\\n");
        } else {
            fprintf(stderr, "[spinel-ebpf] BPF loaded and attached\\n");
        }
        /* Name every ringbuf the program writes to, before any of them is
         * drained. Without this the runtime cannot tell "this channel produced
         * nothing" from "nobody ever read this channel" -- and the second is
         * the failure where a probe emits perfectly and the result is empty. */
        {
            struct bpf_map *_m;
            bpf_object__for_each_map(_m, _spnl_skel->obj) {
                if (bpf_map__type(_m) == BPF_MAP_TYPE_RINGBUF)
                    spnl_channel_declare(bpf_map__name(_m));
                /* Bind the per-unit ringbuf lost-sample counter
                 * (<unit>_lost PERCPU_ARRAY) so the balance report can name the
                 * records the kernel dropped on a full ring -- the one silent
                 * drop the drain-layer counters can't see. */
                else if (bpf_map__type(_m) == BPF_MAP_TYPE_PERCPU_ARRAY) {
                    const char *_mn = bpf_map__name(_m);
                    size_t _ml = _mn ? strlen(_mn) : 0;
                    if (_ml >= #{lc::SUFFIX_LOST_LEN} && strcmp(_mn + _ml - #{lc::SUFFIX_LOST_LEN}, "#{lc::SUFFIX_LOST}") == 0)
                        spnl_lost_bind(bpf_map__fd(_m));
                }
            }
        }
        /* populate PROG_ARRAY *before* attaching the XDP dispatcher so
         * a tail_call right out of the gate doesn't hit an empty slot. */
        _spnl_prog_array_populate();
        _spnl_xdp_attach_all();
        _spnl_tcx_attach_all();
        _spnl_sockops_attach_all();
        _spnl_cgroup_attach_all();
        _spnl_iter_run_all();
        _spnl_kmulti_attach_all();
        _spnl_uprobe_attach_all();
        _spnl_usdt_attach_all();
        _spnl_perf_event_attach_all();
        _spnl_timer_arm_all();
    }

    /* dynamic blocklist FFI exposed to spinel-emitted main.
     * Map is looked up by name at runtime so glue.c stays valid even when
     * the user's .bpf.c didn't request the blocklist (bpf_object__find_map_by_name
     * returns NULL → these calls return -2). The Ruby side declares e.g.
     *   module Blocklist
     *     ffi_func :sp_bpf_blocklist_add, [:uint32], :int
     *     ffi_func :sp_bpf_blocklist_del, [:uint32], :int
     *   end
     */
    static int _spnl_blocklist_fd(void)
    {
        if (!_spnl_skel) return -1;
        struct bpf_map *map = bpf_object__find_map_by_name(_spnl_skel->obj, "#{lc::MAP_BLOCKLIST}");
        if (!map) return -2;
        return bpf_map__fd(map);
    }
    int sp_bpf_blocklist_add(unsigned int ip_host_order)
    {
        int fd = _spnl_blocklist_fd();
        if (fd < 0) return fd;
        __u32 k = ip_host_order;
        __u8  v = 1;
        return bpf_map_update_elem(fd, &k, &v, BPF_ANY);
    }
    int sp_bpf_blocklist_del(unsigned int ip_host_order)
    {
        int fd = _spnl_blocklist_fd();
        if (fd < 0) return fd;
        __u32 k = ip_host_order;
        return bpf_map_delete_elem(fd, &k);
    }

    /* CIDR blocklist FFI (LPM_TRIE). Same lookup-by-name pattern as the
     * exact-match blocklist; the key carries a prefix length so the
     * kernel does longest-prefix matching. Ruby side:
     *   module CidrBlocklist
     *     ffi_func :sp_bpf_cidr_blocklist_add, [:uint32, :uint32], :int
     *     ffi_func :sp_bpf_cidr_blocklist_del, [:uint32, :uint32], :int
     *   end
     * data[] is big-endian (network order) to match the BPF-side key. */
    struct _spnl_cidr_key { __u32 prefixlen; __u8 data[4]; };
    static void _spnl_cidr_key_fill(struct _spnl_cidr_key *k, unsigned int ip_host_order, unsigned int prefixlen)
    {
        k->prefixlen = prefixlen;
        k->data[0] = (ip_host_order >> 24) & 0xff;
        k->data[1] = (ip_host_order >> 16) & 0xff;
        k->data[2] = (ip_host_order >> 8) & 0xff;
        k->data[3] = ip_host_order & 0xff;
    }
    static int _spnl_cidr_blocklist_fd(void)
    {
        if (!_spnl_skel) return -1;
        struct bpf_map *map = bpf_object__find_map_by_name(_spnl_skel->obj, "#{lc::MAP_CIDR_BLOCK}");
        if (!map) return -2;
        return bpf_map__fd(map);
    }
    int sp_bpf_cidr_blocklist_add(unsigned int ip_host_order, unsigned int prefixlen)
    {
        int fd = _spnl_cidr_blocklist_fd();
        if (fd < 0) return fd;
        struct _spnl_cidr_key k;
        _spnl_cidr_key_fill(&k, ip_host_order, prefixlen);
        __u8 v = 1;
        return bpf_map_update_elem(fd, &k, &v, BPF_ANY);
    }
    int sp_bpf_cidr_blocklist_del(unsigned int ip_host_order, unsigned int prefixlen)
    {
        int fd = _spnl_cidr_blocklist_fd();
        if (fd < 0) return fd;
        struct _spnl_cidr_key k;
        _spnl_cidr_key_fill(&k, ip_host_order, prefixlen);
        return bpf_map_delete_elem(fd, &k);
    }

    /* host -> kernel command channel (USER_RINGBUF). Ruby side:
     *   module Cmd
     *     ffi_func :sp_bpf_user_cmd_push, [:int64], :int
     *   end
     *   Cmd.sp_bpf_user_cmd_push(9999)
     *
     * The original USER_RINGBUF work stopped one layer short of this (glue
     * extensions were kept demand-driven) and shipped a standalone push_one.c
     * instead, leaving a hand-written libbpf client as the only way to reach the
     * ring. This is that missing half.
     *
     * TWO LITERALS ARE SHARED WITH THE CODEGEN and nothing compiles both:
     *   1. the map name "bpf_user_cmds" (templates/user_ringbuf.template.c)
     *   2. the RECORD SIZE -- 8 bytes, because the generated callback reads
     *      exactly `sizeof(__s64)` with bpf_dynptr_read.
     * A drift in (1) makes every push return -2 (loud: the caller gets an error
     * code). A drift in (2) is SILENT in one direction: measured, a short record
     * still fires the callback and still counts, but bpf_dynptr_read returns
     * -E2BIG and the value arrives as 0. That is why this reserves a fixed 8 and
     * why nothing here lets the caller choose a size.
     * tests/spinel_ebpf/user_ringbuf_test.rb pins both literals against the
     * template, because -- as measured twice -- this heredoc is compiled by no
     * gate in the tree.
     *
     * The handle is cached: user_ring_buffer__new mmaps the ring, so making one
     * per push would be a syscall pair per command and would defeat the batching
     * that is the point of the map (the host/kernel channel exists to batch). */
    static struct user_ring_buffer *_spnl_user_cmds_rb;
    static int _spnl_user_cmds_init(void)
    {
        if (_spnl_user_cmds_rb) return 0;
        if (!_spnl_skel) return -1;
        struct bpf_map *map = bpf_object__find_map_by_name(_spnl_skel->obj, "#{lc::MAP_USER_CMDS}");
        if (!map) return -2;                       /* unit has no `user_ringbuf_drain` */
        int fd = bpf_map__fd(map);
        if (fd < 0) return -3;
        _spnl_user_cmds_rb = user_ring_buffer__new(fd, NULL);
        return _spnl_user_cmds_rb ? 0 : -4;
    }
    int sp_bpf_user_cmd_push(long long value)
    {
        int rc = _spnl_user_cmds_init();
        if (rc) return rc;
        /* 8 bytes: the size the generated callback reads. Not a parameter. */
        /* the record width is declared once, in loader_contract.h, and the
         * kernel callback reads exactly that many bytes. A short reservation is
         * silent at run time (measured: the callback fires, the count is right,
         * and only the value is 0), so the size comes from the declaration and the
         * static assert ties this local's type to the same number -- the one half
         * of the seam a compiler can see. */
        long long *slot = user_ring_buffer__reserve(_spnl_user_cmds_rb, #{lc::MAP_USER_CMDS_BYTES});
        _Static_assert(sizeof(*slot) == #{lc::MAP_USER_CMDS_BYTES},
                       "bpf_user_cmds record width disagrees with loader_contract.h");
        if (!slot) return -5;                      /* ring full -- visible to the caller */
        *slot = value;
        user_ring_buffer__submit(_spnl_user_cmds_rb, slot);
        return 0;
    }

    /* SO_REUSEPORT sockarray management. Each worker process calls
     * sp_bpf_reuseport_register(listen_fd, my_idx) to put its own listening
     * socket into the SOCKARRAY at index `my_idx`. Then one worker (idx 0
     * by convention) calls sp_bpf_reuseport_attach(listen_fd, prog_name) to
     * attach the BPF program to the reuseport group via setsockopt. */
    static int _spnl_reuseport_map_fd(void)
    {
        if (!_spnl_skel) return -1;
        struct bpf_map *map = bpf_object__find_map_by_name(_spnl_skel->obj, "#{lc::MAP_WORKER_SOCKS}");
        if (!map) return -2;
        return bpf_map__fd(map);
    }
    int sp_bpf_reuseport_register(int listen_fd, int idx)
    {
        int map_fd = _spnl_reuseport_map_fd();
        if (map_fd < 0) return map_fd;
        __u32 k = (__u32)idx;
        __u64 v = (__u64)listen_fd;   /* kernel reads as fd, stores socket ptr */
        return bpf_map_update_elem(map_fd, &k, &v, BPF_ANY);
    }
    /* histogram dump FFI shims. The spinel-emitted main can declare
     *   module HistDump
     *     ffi_func :spnl_dump_log2_hist,   [:str, :str], :int
     *     ffi_func :spnl_dump_linear_hist, [:str, :str], :int
     *     ffi_func :spnl_log2_p,           [:str, :double, :pointer], :int
     *   end
     * and dump bcc-style ASCII histograms from inside the binary. */
    int spnl_dump_log2_hist(const char *map_name, const char *label)
    {
        if (!_spnl_skel || !map_name) return -1;
        return spnl_print_log2_hist_obj(_spnl_skel->obj, map_name, label, stderr);
    }
    int spnl_dump_linear_hist(const char *map_name, const char *slot_fmt)
    {
        if (!_spnl_skel || !map_name) return -1;
        return spnl_print_linear_hist_obj(_spnl_skel->obj, map_name, slot_fmt, stderr);
    }
    int spnl_log2_p(const char *map_name, double percentile, unsigned long long *out)
    {
        if (!_spnl_skel || !map_name || !out) return -1;
        __u64 v = 0;
        int rc = spnl_log2_hist_percentile_obj(_spnl_skel->obj, map_name, percentile, &v);
        *out = (unsigned long long)v;
        return rc;
    }
    /* keyed-hist variants (bpf_hist_keyed[key]) for --instrument S2
     * per-method duration. key selects the per-method 64-slot log2 hist.
     * count/percentile return the value directly (spinel FFI is pointer-averse). */
    int spnl_dump_log2_hist_keyed(const char *map_name, long long key, const char *label)
    {
        if (!_spnl_skel || !map_name) return -1;
        return spnl_print_log2_hist_keyed_obj(_spnl_skel->obj, map_name,
                                              (unsigned long long)key, label, stderr);
    }
    long long spnl_hist_count_keyed(const char *map_name, long long key)
    {
        if (!_spnl_skel || !map_name) return -1;
        __u64 c = 0;
        if (spnl_log2_hist_count_keyed_obj(_spnl_skel->obj, map_name,
                                           (unsigned long long)key, &c)) return -1;
        return (long long)c;
    }
    long long spnl_p_keyed(const char *map_name, long long key, double percentile)
    {
        if (!_spnl_skel || !map_name) return -1;
        __u64 v = 0;
        if (spnl_log2_hist_percentile_keyed_obj(_spnl_skel->obj, map_name,
                                                (unsigned long long)key, percentile, &v)) return -1;
        return (long long)v;
    }
    #{otlp_push_shim}
    /* dump a stack trace (kallsyms-symbolized if symbolize_kernel != 0)
     * to stderr. Spinel-emitted main can declare:
     *   module Stack
     *     ffi_func :spnl_dump_stack, [:string, :uint32, :int], :int
     *   end
     *   Stack.spnl_dump_stack("bpf_stack_traces", 7, 1)  # stack_id=7, symbolize=1 */
    int spnl_dump_stack(const char *map_name, unsigned int stack_id, int symbolize_kernel)
    {
        if (!_spnl_skel || !map_name) return -1;
        return spnl_print_stack_trace_obj(_spnl_skel->obj, map_name,
                                          (__u32)stack_id, symbolize_kernel, stderr);
    }

    /* resolve a user-space PC in process `pid` to "<sym>+0xoff [binary]"
     * via /proc/<pid>/maps + the mapped ELF symtab. Returns a static buffer
     * (single-threaded host model). Ruby:
     *   module Sym
     *     ffi_func :spnl_sym_user_str, [:int, :uint64], :str
     *   end
     *   Sym.spnl_sym_user_str(pid, pc) */
    const char *spnl_sym_user_str(int pid, unsigned long pc)
    {
        static char _spnl_user_symbuf[320];
        spnl_sym_user(pid, pc, _spnl_user_symbuf, sizeof(_spnl_user_symbuf));
        return _spnl_user_symbuf;
    }

    /* streaming event output. Drains every emit ringbuf
     * (<unit>_events / _str_events / _pair_events) and prints each event as it
     * arrives -- the foundation for bcc-style snoop/trace tools. The Ruby main
     * declares it and calls it instead of sleep:
     *   module Stream
     *     ffi_func :spnl_stream, [:int], :int   # arg = seconds (0 = forever)
     *   end
     *   Stream.spnl_stream(0) */
    struct _spnl_evt_hdr { unsigned short type, version; unsigned int reserved; unsigned long long timestamp; };
    static int _spnl_stream_int_cb(void *c, void *d, size_t n) {
        (void)c; if (n < sizeof(struct _spnl_evt_hdr) + 8) return 0;
        struct _spnl_evt_hdr *h = d;
        long long v = *(long long *)((char *)d + sizeof(*h));
        printf("%-20llu %lld\\n", (unsigned long long)h->timestamp, v); fflush(stdout); return 0;
    }
    static int _spnl_stream_str_cb(void *c, void *d, size_t n) {
        (void)c; if (n <= sizeof(struct _spnl_evt_hdr)) return 0;
        struct _spnl_evt_hdr *h = d;
        printf("%-20llu %s\\n", (unsigned long long)h->timestamp, (const char *)d + sizeof(*h)); fflush(stdout); return 0;
    }
    static int _spnl_stream_pair_cb(void *c, void *d, size_t n) {
        (void)c; if (n < sizeof(struct _spnl_evt_hdr) + 16) return 0;
        struct _spnl_evt_hdr *h = d;
        long long *p = (long long *)((char *)d + sizeof(*h));
        printf("%-20llu %lld %lld\\n", (unsigned long long)h->timestamp, p[0], p[1]); fflush(stdout); return 0;
    }
    static int _spnl_stream_emit3_cb(void *c, void *d, size_t n) {
        (void)c; if (n < sizeof(struct _spnl_evt_hdr) + 24) return 0;
        struct _spnl_evt_hdr *h = d;
        long long *p = (long long *)((char *)d + sizeof(*h));
        printf("%-20llu %lld %lld %lld\\n", (unsigned long long)h->timestamp, p[0], p[1], p[2]); fflush(stdout); return 0;
    }
    static int _spnl_stream_emit4_cb(void *c, void *d, size_t n) {
        (void)c; if (n < sizeof(struct _spnl_evt_hdr) + 32) return 0;
        struct _spnl_evt_hdr *h = d;
        long long *p = (long long *)((char *)d + sizeof(*h));
        printf("%-20llu %lld %lld %lld %lld\\n", (unsigned long long)h->timestamp, p[0], p[1], p[2], p[3]); fflush(stdout); return 0;
    }
    int spnl_stream(int duration_secs)
    {
        if (!_spnl_skel) return -1;
        struct ring_buffer *rb = NULL;
        struct bpf_map *map;
        const char *nchan_names = NULL;   /* the sole ringbuf, or "" when several */
        bpf_object__for_each_map(map, _spnl_skel->obj) {
            if (bpf_map__type(map) != BPF_MAP_TYPE_RINGBUF) continue;
            const char *nm = bpf_map__name(map);
            ring_buffer_sample_fn cb;
            if      (strstr(nm, "#{lc::SUFFIX_EMIT_STR}"))   cb = _spnl_stream_str_cb;
            else if (strstr(nm, "#{lc::SUFFIX_EMIT_PAIR}"))  cb = _spnl_stream_pair_cb;
            else if (strstr(nm, "#{lc::SUFFIX_EMIT3}")) cb = _spnl_stream_emit3_cb;
            else if (strstr(nm, "#{lc::SUFFIX_EMIT4}")) cb = _spnl_stream_emit4_cb;
            else if (strstr(nm, "#{lc::SUFFIX_EMIT_INT}"))       cb = _spnl_stream_int_cb;
            else continue;
            int fd = bpf_map__fd(map);
            /* Register before polling: a channel that never fires has to be
               distinguishable from one that was never drained. */
            spnl_channel_seen(nm);
            _spnl_last_chan = _spnl_last_chan[0] ? "" : nm;
            if (!nchan_names) nchan_names = nm;   /* single-channel: attribute exactly */
            else              nchan_names = "";   /* several: poll counts are not separable */
            if (!rb) rb = ring_buffer__new(fd, cb, NULL, NULL);
            else     ring_buffer__add(rb, fd, cb, NULL);
        }
        if (!rb) { fprintf(stderr, "[spinel-ebpf] spnl_stream: no emit ringbuf found\\n"); return -1; }
        int polls = duration_secs > 0 ? duration_secs * 5 : -1;   /* 200ms polls */
        while (polls != 0) {
            int n = ring_buffer__poll(rb, 200);
            if (n < 0 && n != -EINTR) break;
            /* event-boxed one-shot. Each polled record is 1 event; once the
             * SPNL_MAX_EVENTS=K tally is reached, exit cleanly (records already
             * printed = lossless; destructor detaches BPF, fd-GC backstop). */
            /* ring_buffer__poll aggregates every map added above, so a count is
               only attributable when exactly one channel is being drained. With
               several, the per-channel registrations still make "this one was
               silent" visible; the totals just aren't split. */
            if (n > 0 && nchan_names && nchan_names[0]) spnl_channel_in(nchan_names, n);
            if (n > 0 && spnl_oneshot_add(n)) { ring_buffer__free(rb); spnl_oneshot_exit(); }
            if (polls > 0) polls--;
        }
        ring_buffer__free(rb);
        return 0;
    }

    /* sock-keyed L7 stream drain. Drains the <unit>_l7stream_events ringbuf
     * (packed record {hdr, __u64 sock, __u32 len, char raw[128]}) and prints each
     * record as a line userspace can parse for per-connection reassembly:
     *     L7 <sock_hex> <len_decimal> <raw[0..len]_in_hex>
     * Hex avoids the CRLF/NUL mangling that makes the plain str %s path unusable for
     * byte-exact reassembly. The probe declares it and calls it instead of sleep:
     *   module Stream
     *     ffi_func :spnl_l7stream_drain, [:int], :int   # arg = seconds (0 = forever)
     *   end
     *   Stream.spnl_l7stream_drain(0) */
    static int _spnl_l7stream_cb(void *c, void *d, size_t n) {
        (void)c;
        /* field offsets: hdr(16) | sock(u64 @16) | len(u32 @24) | raw(@28) */
        if (n < sizeof(struct _spnl_evt_hdr) + 12) return 0;
        unsigned long long sock = *(unsigned long long *)((char *)d + sizeof(struct _spnl_evt_hdr));
        unsigned int len = *(unsigned int *)((char *)d + sizeof(struct _spnl_evt_hdr) + 8);
        const unsigned char *raw = (const unsigned char *)d + sizeof(struct _spnl_evt_hdr) + 12;
        if (len > 128) len = 128;
        if (sizeof(struct _spnl_evt_hdr) + 12 + len > n) len = (unsigned int)(n - sizeof(struct _spnl_evt_hdr) - 12);
        printf("L7 %llx %u ", sock, len);
        for (unsigned int i = 0; i < len; i++) printf("%02x", raw[i]);
        printf("\\n"); fflush(stdout);
        return 0;
    }
    int spnl_l7stream_drain(int duration_secs)
    {
        if (!_spnl_skel) return -1;
        struct ring_buffer *rb = NULL;
        struct bpf_map *map;
        bpf_object__for_each_map(map, _spnl_skel->obj) {
            if (bpf_map__type(map) != BPF_MAP_TYPE_RINGBUF) continue;
            const char *nm = bpf_map__name(map);
            if (!strstr(nm, "#{lc::SUFFIX_L7STREAM}")) continue;
            int fd = bpf_map__fd(map);
            /* Register the channel before polling: "drained nothing" has to be
               distinguishable from "never drained". Every path that reads a
               ringbuf goes through here, including the ones with no exporter. */
            spnl_channel_seen(nm);
            _spnl_last_chan = _spnl_last_chan[0] ? "" : nm;
            if (!rb) rb = ring_buffer__new(fd, _spnl_l7stream_cb, NULL, NULL);
            else     ring_buffer__add(rb, fd, _spnl_l7stream_cb, NULL);
        }
        if (!rb) { fprintf(stderr, "[spinel-ebpf] spnl_l7stream_drain: no l7stream ringbuf found\\n"); return -1; }
        int polls = duration_secs > 0 ? duration_secs * 5 : -1;   /* 200ms polls */
        while (polls != 0) {
            int n = ring_buffer__poll(rb, 200);
            if (n < 0 && n != -EINTR) break;
            /* event-boxed one-shot (SPNL_MAX_EVENTS=K). */
            if (n > 0 && spnl_oneshot_add(n)) { ring_buffer__free(rb); spnl_oneshot_exit(); }
            if (polls > 0) polls--;
        }
        ring_buffer__free(rb);
        return 0;
    }

    /* Userspace consumer drain. Collects int emit events from the
     * <unit>_events ringbuf into a static buffer so the spinel-Ruby side can
     * iterate them (spnl_cget) and process each in Ruby. spinel->glue FFI
     * direction (the consumer method itself is a normal static spinel function
     * called from Ruby; glue only provides the raw drain). Ruby:
     *   module Consume
     *     ffi_func :spnl_cdrain, [:int], :int   # drain, returns event count
     *     ffi_func :spnl_cget,   [:int], :int   # value of buffered event i
     *   end */
    static long long _spnl_cbuf[4096], _spnl_cbuf_ts[4096]; static int _spnl_ccount;
    static int _spnl_collect_int_cb(void *c, void *d, size_t n) {
        (void)c; if (n < sizeof(struct _spnl_evt_hdr) + 8) return 0;
        if (_spnl_ccount < 4096) {
            _spnl_cbuf_ts[_spnl_ccount] = (long long)((struct _spnl_evt_hdr *)d)->timestamp;
            _spnl_cbuf[_spnl_ccount] = *(long long *)((char *)d + sizeof(struct _spnl_evt_hdr));
            _spnl_ccount++;
        }
        return 0;
    }
    int spnl_cdrain(int timeout_ms) {
        if (!_spnl_skel) return -1;
        _spnl_ccount = 0;
        struct ring_buffer *rb = NULL;
        struct bpf_map *map;
        bpf_object__for_each_map(map, _spnl_skel->obj) {
            if (bpf_map__type(map) != BPF_MAP_TYPE_RINGBUF) continue;
            const char *nm = bpf_map__name(map);
            if (!strstr(nm, "#{lc::SUFFIX_EMIT_INT}") || strstr(nm, "#{lc::SUFFIX_EMIT_STR}") ||
                strstr(nm, "#{lc::SUFFIX_EMIT_PAIR}") || strstr(nm, "#{lc::SUFFIX_EMIT3}") ||
                strstr(nm, "#{lc::SUFFIX_EMIT4}")) continue;
            int fd = bpf_map__fd(map);
            /* Register the channel before polling: "drained nothing" has to be
               distinguishable from "never drained". Every path that reads a
               ringbuf goes through here, including the ones with no exporter. */
            spnl_channel_seen(nm);
            _spnl_last_chan = _spnl_last_chan[0] ? "" : nm;
            if (!rb) rb = ring_buffer__new(fd, _spnl_collect_int_cb, NULL, NULL);
            else     ring_buffer__add(rb, fd, _spnl_collect_int_cb, NULL);
        }
        if (!rb) return 0;
        int _before = _spnl_ccount;
        ring_buffer__poll(rb, timeout_ms);
        if (_spnl_ccount > _before) spnl_channel_in(_spnl_last_chan, _spnl_ccount - _before);
        ring_buffer__free(rb);
        return _spnl_ccount;
    }
    int spnl_cget(int i) { return (i >= 0 && i < _spnl_ccount) ? (int)_spnl_cbuf[i] : 0; }
    long spnl_cget_ts(int i) { return (i >= 0 && i < _spnl_ccount) ? (long)_spnl_cbuf_ts[i] : 0; }  /* 64-bit ktime */

    /* pair-emit consumer drain (spnl_emit_pair -> <unit>_pair_events:
     * hdr + __s64 a, b). Two getters since FFI returns one value. */
    static long long _spnl_cbuf_pa[4096], _spnl_cbuf_pb[4096], _spnl_cbuf_pts[4096]; static int _spnl_ccount_pair;
    static int _spnl_collect_pair_cb(void *c, void *d, size_t n) {
        (void)c; if (n < sizeof(struct _spnl_evt_hdr) + 16) return 0;
        if (_spnl_ccount_pair < 4096) {
            long long *p = (long long *)((char *)d + sizeof(struct _spnl_evt_hdr));
            _spnl_cbuf_pts[_spnl_ccount_pair] = (long long)((struct _spnl_evt_hdr *)d)->timestamp;
            _spnl_cbuf_pa[_spnl_ccount_pair] = p[0];
            _spnl_cbuf_pb[_spnl_ccount_pair] = p[1];
            _spnl_ccount_pair++;
        }
        return 0;
    }
    int spnl_cdrain_pair(int timeout_ms) {
        if (!_spnl_skel) return -1;
        _spnl_ccount_pair = 0;
        struct ring_buffer *rb = NULL;
        struct bpf_map *map;
        bpf_object__for_each_map(map, _spnl_skel->obj) {
            if (bpf_map__type(map) != BPF_MAP_TYPE_RINGBUF) continue;
            const char *nm = bpf_map__name(map);
            if (!strstr(nm, "#{lc::SUFFIX_EMIT_PAIR}")) continue;
            int fd = bpf_map__fd(map);
            /* Register the channel before polling: "drained nothing" has to be
               distinguishable from "never drained". Every path that reads a
               ringbuf goes through here, including the ones with no exporter. */
            spnl_channel_seen(nm);
            _spnl_last_chan = _spnl_last_chan[0] ? "" : nm;
            if (!rb) rb = ring_buffer__new(fd, _spnl_collect_pair_cb, NULL, NULL);
            else     ring_buffer__add(rb, fd, _spnl_collect_pair_cb, NULL);
        }
        if (!rb) return 0;
        int _before = _spnl_ccount_pair;
        ring_buffer__poll(rb, timeout_ms);
        if (_spnl_ccount_pair > _before) spnl_channel_in(_spnl_last_chan, _spnl_ccount_pair - _before);
        ring_buffer__free(rb);
        return _spnl_ccount_pair;
    }
    int spnl_cget_pair_a(int i) { return (i >= 0 && i < _spnl_ccount_pair) ? (int)_spnl_cbuf_pa[i] : 0; }
    int spnl_cget_pair_b(int i) { return (i >= 0 && i < _spnl_ccount_pair) ? (int)_spnl_cbuf_pb[i] : 0; }
    long spnl_cget_pair_ts(int i) { return (i >= 0 && i < _spnl_ccount_pair) ? (long)_spnl_cbuf_pts[i] : 0; }

    /* persistent consumer ring_buffer for epoll-multiplexed draining.
     * Created once over all emit ringbufs; its epoll fd joins the program's
     * run loop, so events drain as they arrive
     * (not only on scrape -> no overflow between scrapes). spnl_consume_poll
     * fills the same static buffers as spnl_cdrain*; getters/counts read them. */
    static struct ring_buffer *_spnl_consumer_rb;
    static struct ring_buffer *_spnl_consumer_rb_get(void) {
        if (_spnl_consumer_rb || !_spnl_skel) return _spnl_consumer_rb;
        struct bpf_map *map;
        bpf_object__for_each_map(map, _spnl_skel->obj) {
            if (bpf_map__type(map) != BPF_MAP_TYPE_RINGBUF) continue;
            const char *nm = bpf_map__name(map);
            ring_buffer_sample_fn cb;
            if (strstr(nm, "#{lc::SUFFIX_EMIT_PAIR}")) cb = _spnl_collect_pair_cb;
            else if (strstr(nm, "#{lc::SUFFIX_EMIT_INT}") && !strstr(nm, "#{lc::SUFFIX_EMIT_STR}") &&
                     !strstr(nm, "#{lc::SUFFIX_EMIT3}") && !strstr(nm, "#{lc::SUFFIX_EMIT4}"))
                cb = _spnl_collect_int_cb;
            else continue;
            int fd = bpf_map__fd(map);
            /* Register the channel before polling: "drained nothing" has to be
               distinguishable from "never drained". Every path that reads a
               ringbuf goes through here, including the ones with no exporter. */
            spnl_channel_seen(nm);
            _spnl_last_chan = _spnl_last_chan[0] ? "" : nm;
            if (!_spnl_consumer_rb) _spnl_consumer_rb = ring_buffer__new(fd, cb, NULL, NULL);
            else                    ring_buffer__add(_spnl_consumer_rb, fd, cb, NULL);
        }
        return _spnl_consumer_rb;
    }
    int spnl_consumer_epoll_fd(void) {
        struct ring_buffer *rb = _spnl_consumer_rb_get();
        return rb ? ring_buffer__epoll_fd(rb) : -1;
    }
    int spnl_consume_poll(int timeout_ms) {
        struct ring_buffer *rb = _spnl_consumer_rb_get();
        if (!rb) return 0;
        _spnl_ccount = 0; _spnl_ccount_pair = 0;
        ring_buffer__poll(rb, timeout_ms);
        return _spnl_ccount + _spnl_ccount_pair;
    }
    int spnl_consume_count_int(void)  { return _spnl_ccount; }
    int spnl_consume_count_pair(void) { return _spnl_ccount_pair; }

    /* dump folded stacks (Brendan Gregg flamegraph.pl input format)
     * to stderr. Pipe stderr to a file, then run
     *   flamegraph.pl < folded.txt > flame.svg
     * to render as an interactive SVG. Ruby:
     *   module FG
     *     ffi_func :spnl_dump_folded, [:string, :string], :int
     *   end
     *   FG.spnl_dump_folded("bpf_hist_keyed", "bpf_stacks") */
    int spnl_dump_folded(const char *hist_map_name, const char *stacks_map_name)
    {
        if (!_spnl_skel || !hist_map_name || !stacks_map_name) return -1;
        return spnl_print_folded_stacks_obj(_spnl_skel->obj, hist_map_name,
                                            stacks_map_name, stderr);
    }

    /* memleak report -- group the outstanding-allocation HASH by stack id
     * and print the top `top_n` leaking stacks (symbolized). */
    int spnl_dump_leaks(const char *allocs_map_name, const char *stacks_map_name, int top_n)
    {
        if (!_spnl_skel || !allocs_map_name || !stacks_map_name) return -1;
        return spnl_dump_leaks_obj(_spnl_skel->obj, allocs_map_name,
                                   stacks_map_name, top_n, stdout);
    }

    /* deadlock report -- flag lock-order inversions (a->b AND b->a). */
    int spnl_dump_deadlocks(const char *edges_map_name, int top_n)
    {
        if (!_spnl_skel || !edges_map_name) return -1;
        return spnl_dump_deadlocks_obj(_spnl_skel->obj, edges_map_name, top_n, stdout);
    }

    /* stream folded-stacks output directly to a file descriptor
     * (typically an accepted TCP socket from spinel's net FFI). The
     * fd is dup'd so the caller's lifecycle isn't disturbed by fclose. */
    int spnl_dump_folded_to_fd(const char *hist_map_name,
                                const char *stacks_map_name,
                                int fd)
    {
        if (!_spnl_skel || !hist_map_name || !stacks_map_name || fd < 0) return -1;
        int dup_fd = dup(fd);
        if (dup_fd < 0) return -1;
        FILE *fp = fdopen(dup_fd, "w");
        if (!fp) { close(dup_fd); return -1; }
        int rc = spnl_print_folded_stacks_obj(_spnl_skel->obj, hist_map_name,
                                              stacks_map_name, fp);
        fflush(fp);
        fclose(fp);
        return rc;
    }

    /* folded USER stacks (user_stack_id, key = (tgid<<32)|stack_id) to
     * stderr. Symbolizes via spnl_sym_user (+ build-id debug fallback). `pid`
     * >= 0 symbolizes every stack against that namespace-local pid (needed
     * inside a container, where the kernel-recorded init-ns pid differs from
     * /proc); pass -1 for system-wide (uses the packed per-stack pid).
     *   module FG
     *     ffi_func :spnl_dump_folded_user, [:string, :string, :int], :int
     *   end
     *   FG.spnl_dump_folded_user("bpf_hist_keyed", "bpf_stacks", target_pid) */
    int spnl_dump_folded_user(const char *hist_map_name, const char *stacks_map_name, int pid)
    {
        if (!_spnl_skel || !hist_map_name || !stacks_map_name) return -1;
        return spnl_print_folded_user_stacks_obj(_spnl_skel->obj, hist_map_name,
                                                 stacks_map_name, pid, stderr);
    }

    /* stream folded USER stacks to a file descriptor (e.g. a live HTTP
     * /folded endpoint). The fd is dup'd so fclose doesn't disturb the caller. */
    int spnl_dump_folded_user_to_fd(const char *hist_map_name,
                                    const char *stacks_map_name,
                                    int pid,
                                    int fd)
    {
        if (!_spnl_skel || !hist_map_name || !stacks_map_name || fd < 0) return -1;
        int dup_fd = dup(fd);
        if (dup_fd < 0) return -1;
        FILE *fp = fdopen(dup_fd, "w");
        if (!fp) { close(dup_fd); return -1; }
        int rc = spnl_print_folded_user_stacks_obj(_spnl_skel->obj, hist_map_name,
                                                   stacks_map_name, pid, fp);
        fflush(fp);
        fclose(fp);
        return rc;
    }

    int sp_bpf_reuseport_attach(int listen_fd, const char *prog_name)
    {
        if (!_spnl_skel || !prog_name) return -1;
        struct bpf_program *prog = bpf_object__find_program_by_name(_spnl_skel->obj, prog_name);
        if (!prog) {
            fprintf(stderr, "[spinel-ebpf] sp_bpf_reuseport_attach: prog '%s' not found\\n", prog_name);
            return -2;
        }
        int prog_fd = bpf_program__fd(prog);
        if (prog_fd < 0) return -3;
        if (setsockopt(listen_fd, SOL_SOCKET, SO_ATTACH_REUSEPORT_EBPF,
                       &prog_fd, sizeof(prog_fd)) < 0) {
            fprintf(stderr, "[spinel-ebpf] setsockopt(SO_ATTACH_REUSEPORT_EBPF): %s\\n", strerror(errno));
            return -4;
        }
        return 0;
    }

    __attribute__((destructor))
    static void _spnl_close(void)
    {
        /* detach sockops first (cgroup-scoped, no bpf_link). */
        for (int i = 0; i < _spnl_sockops_count; i++) {
            if (_spnl_sockops_cgroup_fd >= 0 && _spnl_sockops_prog_fds[i] >= 0) {
                bpf_prog_detach2(_spnl_sockops_prog_fds[i],
                                 _spnl_sockops_cgroup_fd,
                                 BPF_CGROUP_SOCK_OPS);
            }
        }
        if (_spnl_sockops_cgroup_fd >= 0) close(_spnl_sockops_cgroup_fd);
        /* detach kprobe.multi links. */
        for (int i = 0; i < _spnl_kmulti_link_count; i++) {
            if (_spnl_kmulti_links[i]) bpf_link__destroy(_spnl_kmulti_links[i]);
        }
        /* detach uprobe / uretprobe / USDT links. */
        for (int i = 0; i < _spnl_uprobe_link_count; i++) {
            if (_spnl_uprobe_links[i]) bpf_link__destroy(_spnl_uprobe_links[i]);
        }
        /* detach perf_event links + close per-CPU fds. */
        for (int i = 0; i < _spnl_perf_link_count; i++) {
            if (_spnl_perf_links[i].link) bpf_link__destroy(_spnl_perf_links[i].link);
            if (_spnl_perf_links[i].pfd >= 0) close(_spnl_perf_links[i].pfd);
        }
        for (int i = 0; i < _spnl_tcx_link_count; i++) {
            if (_spnl_tcx_links[i]) bpf_link__destroy(_spnl_tcx_links[i]);
        }
        /* XDP links -- destroying detaches only our own programs;
         * a foreign program on the same iface is never touched. */
        for (int i = 0; i < _spnl_xdp_link_count; i++) {
            if (_spnl_xdp_links[i]) bpf_link__destroy(_spnl_xdp_links[i]);
        }
        if (_spnl_skel) #{skel_name}__destroy(_spnl_skel);
    }
  GLUE
end

# --- subcommand: check ---
#
# spinel-ebpf check <file.rb> [--json]
#
# Run a probe through partition -> codegen -> clang(-target bpf) -> load+verifier,
# stopping at the first failing stage, and return {stage, ok, error, detail} for
# each. This closes the AI-authoring read-write-fix-verify loop:
# the AI gets a machine-readable "here is the one thing to fix next", including a
# clean *kernel verifier* verdict (the second, kernel-side harness) -- the piece
# the pre-compile checks don't reach.
#
# `check` is a light path: it stops at the .bpf.o and load-only verification. It
# does NOT link the full binary (no glue.c / runtime / OTLP), does NOT attach, and
# does NOT run the workload. Stages gracefully *skip* (ok:null + reason) where the
# environment can't run them -- notably the verifier on a host with no kernel/BTF.
def cmd_check(argv)
  opts = { json: false, output_dir: nil, verbose: false }
  parser = OptionParser.new do |op|
    op.banner = "Usage: spinel-ebpf check <file.rb> [--json]"
    op.on("--json", "Emit the structured result { file, ok, failed_stage, stages:[...] }") { opts[:json] = true }
    op.on("-o DIR", "--output DIR", "Work directory (default: a temp dir; artifacts are throwaway)") { |d| opts[:output_dir] = d }
    op.on("-v", "--verbose", "Verbose output") { opts[:verbose] = true }
    op.on("-h", "--help", "Show this message") { puts op; exit 0 }
  end
  files = parser.parse!(argv)
  abort parser.help if files.length != 1
  input = files[0]
  abort "error: #{input} not found" unless File.exist?(input)

  build_dir = opts[:output_dir] || Dir.mktmpdir("spnl-check")
  FileUtils.mkdir_p(build_dir)
  ctx = { verbose: opts[:verbose] }

  stages = []
  failed = false
  run_stage = lambda do |name, &blk|
    st = failed ? SpinelEbpf::Check.skip_stage(name, "upstream stage failed") : blk.call
    stages << st
    failed = true if st[:ok] == false
  end

  run_stage.call("partition") { check_stage_partition(input, build_dir, ctx) }
  run_stage.call("codegen")   { check_stage_codegen(build_dir, ctx) }
  run_stage.call("clang")     { check_stage_clang(build_dir, ctx) }
  run_stage.call("verifier")  { check_stage_verifier(ctx) }

  result = SpinelEbpf::Check.assemble(input, stages)
  puts(opts[:json] ? SpinelEbpf::Check.to_json(result) : SpinelEbpf::Check.human(result))
  result[:ok] ? 0 : 1
end

# Stage 1: frontend (spinel -> .ast/.ir) + parse + partition + the validate gate.
# The frontend is a Linux binary, so on a non-Linux host this stage skips (the AI
# should run `check` in the build container). A Validate violation is a probe
# failure carrying that gate's loud message.
def check_stage_partition(input, build_dir, ctx)
  cs = c_spinel
  unless SpinelEbpf::Check.linux? && cs
    return SpinelEbpf::Check.skip_stage("partition",
      "frontend requires Linux + the spinel binary (spinel is a Linux ELF; run check in the build container)")
  end

  # Mirror compile's source sanitize so the frontend accepts the same programs
  # (strip use_plugin, lower the consumer DSL). No-op for a plain probe.
  src = File.read(input, encoding: "UTF-8")
  declared = SpinelEbpf::Plugin.detect_declarations(src)
  transformed = src
  transformed = SpinelEbpf::Plugin.strip_declarations(transformed) unless declared.empty?
  begin
    transformed = SpinelEbpf::Consumer.transform(transformed)   # loud on a bad ev.<prop>
  rescue SpinelEbpf::Consumer::Error => e
    abort "error: #{e.message}"
  end
  real_input = input
  if transformed != src
    real_input = File.join(build_dir, File.basename(input))
    File.write(real_input, transformed)
  end

  base = File.basename(real_input, ".rb")
  ast_path = File.join(build_dir, "#{base}.ast")
  ir_path  = File.join(build_dir, "#{base}.ir")

  out, err, st = Open3.capture3(cs, "--dump-ast", "--no-line-map", real_input)
  return SpinelEbpf::Check.fail_stage("partition", "spinel --dump-ast failed", detail: err.strip) unless st.success?
  File.write(ast_path, out)

  icc = inproc_codegen_bin
  return SpinelEbpf::Check.skip_stage("partition", "in-process codegen unavailable (build spinel first)") unless icc
  irout, irerr, irst = Open3.capture3(icc, real_input, base, "--ir")
  return SpinelEbpf::Check.fail_stage("partition", "in-process IR emit failed", detail: irerr.strip) unless irst.success?
  File.write(ir_path, irout)

  begin
    ir  = SpinelEbpf::ParseSpinelIR.parse_file(ir_path)
    ast = SpinelEbpf::ParseSpinelAst.parse_file(ast_path)
    result = SpinelEbpf::Partition.classify(ir, ast)
  rescue StandardError => e
    return SpinelEbpf::Check.fail_stage("partition", "partition failed: #{e.message}")
  end

  verdict = SpinelEbpf::Check.partition_verdict(ast, result)
  if verdict[:ok]
    ctx[:base] = base
    ctx[:input] = real_input
    ctx[:result] = result
    ctx[:ebpf_count] = result.methods.count { |m| m.tag == :ebpf }
  end
  verdict
end

# Stage 2: in-process C eBPF codegen (.bpf.c). No eBPF methods -> nothing to
# compile (skip, not a failure).
def check_stage_codegen(build_dir, ctx)
  return SpinelEbpf::Check.skip_stage("codegen", "no partition output") unless ctx[:result]
  if ctx[:ebpf_count].to_i.zero?
    return SpinelEbpf::Check.skip_stage("codegen", "no eBPF programs (all methods are :native)")
  end
  icc = inproc_codegen_bin
  return SpinelEbpf::Check.skip_stage("codegen", "in-process codegen unavailable") unless icc
  bpf_c = File.join(build_dir, "#{ctx[:base]}.bpf.c")
  out, err, st = Open3.capture3(icc, ctx[:input], ctx[:base])
  # `check --json` is the machine-facing surface, so it must survive the
  # diagnostic it is reporting. Measured: a codegen message containing one
  # non-ASCII byte crashed this line with Encoding::CompatibilityError under the
  # build container's default US-ASCII locale -- the checker died with a Ruby
  # backtrace instead of reporting which stage failed. capture3 hands back
  # ASCII-8BIT/locale-tagged bytes; retag as UTF-8 and scrub so the diagnostic is
  # at worst mangled, never fatal.
  err = err.dup.force_encoding(Encoding::UTF_8).scrub("?")
  return SpinelEbpf::Check.fail_stage("codegen", "in-process eBPF codegen failed", detail: err.strip) unless st.success?
  File.write(bpf_c, out)
  ctx[:bpf_c] = bpf_c
  SpinelEbpf::Check.ok_stage("codegen", detail: "wrote #{File.basename(bpf_c)} (#{ctx[:ebpf_count]} programs)")
end

# Stage 3: clang -target bpf -> .bpf.o. Needs Linux clang + bpftool-generated
# vmlinux.h; skips gracefully when the toolchain is absent.
def check_stage_clang(build_dir, ctx)
  return SpinelEbpf::Check.skip_stage("clang", "no .bpf.c (upstream produced none)") unless ctx[:bpf_c]
  clang = which("clang")
  return SpinelEbpf::Check.skip_stage("clang", "clang with bpf target unavailable (needs Linux clang)") unless clang && SpinelEbpf::Check.linux?

  vmlinux = File.join(build_dir, "vmlinux.h")
  unless File.exist?(vmlinux)
    bpftool = which("bpftool")
    return SpinelEbpf::Check.skip_stage("clang", "bpftool not found (needed to generate vmlinux.h)") unless bpftool
    dump = `#{bpftool} btf dump file #{SpinelEbpf::Check.default_btf_path} format c 2>/dev/null`
    return SpinelEbpf::Check.skip_stage("clang", "vmlinux.h generation failed (no BTF at #{SpinelEbpf::Check.default_btf_path})") if dump.strip.empty?
    File.write(vmlinux, dump)
  end

  bpf_o = File.join(build_dir, "#{ctx[:base]}.bpf.o")
  argv  = bpf_clang_argv(clang, ctx[:bpf_c], bpf_o, build_dir)
  warn "[spinel-ebpf] check clang: #{argv.join(' ')}" if ctx[:verbose]
  _out, err, st = Open3.capture3(*argv)
  unless st.success?
    # clang's stderr arrives in the default external encoding, which is US-ASCII
    # when the environment sets no locale (the container's default). A diagnostic
    # that quotes a multi-byte character then makes the scan below raise
    # ArgumentError -- a stack trace where the whole point of `check` is to hand
    # back the message (measured).
    err = err.dup.force_encoding(Encoding::UTF_8).scrub
    first = err.lines.find { |l| l =~ /error:/i }&.strip
    return SpinelEbpf::Check.fail_stage("clang", first || "clang -target bpf failed", detail: err.strip)
  end
  ctx[:bpf_o] = bpf_o
  SpinelEbpf::Check.ok_stage("clang", detail: "wrote #{File.basename(bpf_o)}")
end

# Stage 4: load-only kernel verification (libbpf bpf_object__load -- the second,
# kernel-side harness). No kernel/BTF -> skip. On rejection, surface the verifier
# verdict + a trimmed log tail.
def check_stage_verifier(ctx)
  # Kernel/BTF is the most fundamental precondition -- report it first so a host
  # without a kernel (e.g. macOS) cleanly says "no kernel/BTF" regardless of what
  # upstream produced.
  unless SpinelEbpf::Check.verifier_available?
    return SpinelEbpf::Check.skip_stage("verifier",
      "no kernel/BTF (host=#{RbConfig::CONFIG["host_os"]}; needs Linux + #{SpinelEbpf::Check.default_btf_path})")
  end
  return SpinelEbpf::Check.skip_stage("verifier", "no .bpf.o (upstream produced none)") unless ctx[:bpf_o]
  loader = load_check_bin
  return SpinelEbpf::Check.skip_stage("verifier", "load-only loader unavailable (libbpf-dev / cc missing)") unless loader
  _out, err, st = Open3.capture3(loader, ctx[:bpf_o])
  if st.success?
    SpinelEbpf::Check.ok_stage("verifier", detail: "load-only OK (bpf_object__load accepted all programs)")
  else
    short, detail = SpinelEbpf::Check.summarize_verifier_log(err)
    SpinelEbpf::Check.fail_stage("verifier", short, detail: detail)
  end
end

def print_partition_table(result, base)
  ebpf   = result.methods.count { |m| m.tag == :ebpf }
  native = result.methods.count { |m| m.tag == :native }
  puts "## spinel-ebpf partition for #{base}.rb"
  puts "   #{result.methods.length} methods  →  #{ebpf} eBPF / #{native} native"

  unless result.program_warnings.empty?
    puts ""
    puts "Program-wide warnings:"
    result.program_warnings.each { |w| puts "  - #{w}" }
  end

  puts ""
  fmt = "  %-7s  %-40s  %s"
  puts (fmt % ["tag", "method", "reasons (when native)"])
  puts (fmt % ["-" * 7, "-" * 40, "-" * 30])
  result.methods.each do |m|
    reasons = m.flags.reasons.join("; ")
    puts (fmt % [m.tag, m.qualified_name, m.tag == :native ? reasons : ""])
  end
end

# --- entry ---

def cmd_describe(argv)
  file = argv[0]
  abort "usage: spinel-ebpf describe <file.rb>" unless file
  abort "error: #{file} not found" unless File.exist?(file)
  print SpinelEbpf::Introspect.report(File.read(file, encoding: "UTF-8"), file)
  0
end

# `spinel-ebpf capabilities [file.rb]`
#   no arg  -> full domain registry (all builtins grouped by domain + context gates)
#   file.rb -> just the domains that file's probe uses
# `spinel-ebpf capabilities --json`
#   -> machine-readable affordance contract (builtin signatures + attach kinds +
#      Ruby subset + layer-2 enrichers), meant to be read by a program -- an AI
#      writing a probe, say. It does not affect generated code.
#   -> also reports record_channels: the byte layout each packed-record emit
#      writes into its ringbuf, and the OTLP attributes those bytes end up as.
#      Both are derived from src/codegen_c/record_schema.h, which is the one
#      place that layout is declared.
def cmd_capabilities(argv)
  if argv.include?("--json")
    puts SpinelEbpf::Capabilities.affordance_json
    return 0
  end
  file = argv[0]
  if file
    abort "error: #{file} not found" unless File.exist?(file)
    doms = SpinelEbpf::Introspect.builtin_domains(File.read(file, encoding: "UTF-8"))
    puts "spinel-ebpf capabilities used by #{file}:"
    puts "  (none)" if doms.empty?
    doms.each do |dom, blts|
      puts format("  %-14s %s", dom, blts.join(" "))
      blts.each do |b|
        # Show a call-syntax example next to each builtin the probe actually uses,
        # so the reference is where the author is already looking.
        ex = SpinelEbpf::Capabilities.builtin_entry(b)[:example]
        puts format("    %-20s e.g. %s", b, ex) if ex
        g = SpinelEbpf::Capabilities.gate_for(b)
        puts format("      ! only valid in: %s", g[:valid_secs].join(" | ")) if g
        # Units and byte order of the return value. Showing only how to call it
        # (the example) and not what it means is how a plausible-looking number
        # gets misread and still passes.
        sem = SpinelEbpf::Capabilities.value_semantics_for(b)
        puts format("      = %s", sem) if sem
      end
    end
  else
    print SpinelEbpf::Capabilities.catalog_report
  end
  0
end

argv = ARGV.dup
case argv.shift
when "compile"
  exit cmd_compile(argv)
when "check"
  exit cmd_check(argv)
when "describe"
  exit cmd_describe(argv)
when "capabilities"
  exit cmd_capabilities(argv)
when "--version", "-V"
  puts "spinel-ebpf #{VERSION}"
  exit 0
when "--help", "-h", nil
  puts <<~HELP
    spinel-ebpf #{VERSION}  --  Ruby AOT + eBPF partition compiler wrapper

    Usage:
      spinel-ebpf compile <file.rb> [--ebpf-mixed | --native-only] [-o DIR]

    Subcommands:
      compile      Compile a Ruby source file
      check        Fast verify loop: run partition -> codegen -> clang ->
                   load+verifier and report {stage, ok, error} for each, stopping
                   at the first failure. --json for machine-readable output.
      describe     Show emit sites <-> on_emit consumers binding, plus the
                   packed-record channels a probe writes and the OTLP attributes
                   they turn into
      capabilities Show the builtin domain registry (or just what a file uses).
                   --json emits the machine-readable affordance contract
                   (builtin signatures + attach kinds + Ruby subset + record
                   channels/egress attributes) for AI authoring
      --version    Show version

    Environment:
      SPINEL_DIR        Path to deps/spinel (default: $project/deps/spinel)
      SPINEL_EBPF_MODE  Override default mode: "ebpf-mixed" or "native-only"
      SPNL_STATIC=1     Link a fully static binary (--build). Runs on a host with no
                        matching glibc/libbpf/libelf -- even a different libc.
      SPNL_STATIC_ELF_DIR
                        Directory holding a libelf.a that carries the elfutils libeu
                        objects (elfutils >= 0.195). Needed with SPNL_STATIC=1 when the
                        system libelf.a is older; spinel-ebpf checks and explains if so.
      SPNL_BPF_STRIP=1  Strip DWARF from the .bpf.o with llvm-strip -g before the
                        skeleton embeds it. Keeps .BTF / .BTF.ext, so CO-RE is
                        intact; shrinks the shipped skeleton by ~96%. Off by default so
                        the artifact never depends on whether the build host has
                        llvm-strip; with it set and llvm-strip missing, the build fails.

    The .bpf.o is built at a pinned ISA (-mcpu=v1; v3 only for bpf_arena sources) with
    build paths mapped out, so the same source yields the same bytes regardless
    of -o, cwd, and repo location.

    See docs/architecture.md for how the partitioning pipeline fits together.
  HELP
  exit 0
else
  abort "unknown subcommand. Run `spinel-ebpf --help`."
end
